<%- include('../../base/ui/html/layout/header', { page }) %>

<!-- Content Header (Page header) -->
<div class="content-header">
      <div class="row">
         <div class="offset-3 col-6" id="page_messages_container"></div>
      </div>
   </div>
<!-- /.content-header -->

<!-- Main content -->
<div class="content">

   <div class="container-fluid">

      <div class="card">

         <div class="card-header">
            <h3 class="card-title"><span class="text-muted"><%= i18n.__('Stock') %></span></h3>
            <div class="card-tools expeditions-expeditions-card-tools">
               <button class="btn btn-tool" data-card-widget="collapse" type="button" data-toggle="tooltip" title="<%= i18n.__('Collapse') %>">
                  <i class="fas fa-minus"></i>
               </button>
            </div>
         </div>

         <div class="card-body p-0">
            <div class="mailbox-controls card-controls-fixed-head">
               <div class="row">
                  <div class="col-6">
                     <div class="expeditions-expeditions-batch-actions">
                        <span>&nbsp;&nbsp;</span>
                        <button type="button" class="btn btn-default btn-sm checkbox-toggle expeditions-expeditions-checkbox"><i class="far fa-square"></i></button>
                     </div>
                  </div>
                  <div class="col-6">
                     <div>
                        <div class="input-group input-group-sm float-right" style="max-width: 250px;">
                           <input type="text" name="table_search" class="form-control float-right" placeholder="<%= i18n.__('Search') %>" id="expeditions-expeditions-search-input">
                           <div class="input-group-append">
                              <button type="submit" class="btn btn-default">
                                 <i class="fas fa-search"></i>
                              </button>
                           </div>
                        </div>
                     </div>
                  </div>
               </div>
            </div>
            <div class="table-responsive mailbox-messages expeditions-expeditions-main-container table-fixed-head">
            <table class="table table-hover table-striped table-sm">
               <thead>
                  <tr>
                     <th><span>&nbsp;</span></th>
                     <th><%= i18n.__('Order') %></th>
                     <th><%= i18n.__('Tracking number') %></th>
                     <th><%= i18n.__('State') %></th>
                  </tr>
               </thead>
               <tbody id="expeditions-expeditions-list"></tbody>
            </table>
            </div>
         </div>

         <div class="card-footer clearfix" id="expeditions-expeditions-footer"></div>

      </div>

   </div>

</div>

<%- include('../../base/ui/html/layout/footer', { page }) %>

</body>

</html>