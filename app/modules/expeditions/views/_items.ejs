<% items.forEach(function(item, count){ %>
<tr>
   <td>
      <small>
         <strong><%= page.translate('Order') %>:</strong> <%- item.name %><br/>
         <strong><%= page.translate('Address') %>:</strong> <%- item.address %><br/>
         <strong><%= page.translate('Date') %>:</strong> <%- item.date_order %><br/>
         <strong><%= page.translate('Total') %>:</strong> <%- item.amount_total %><br/>
         <strong><%= page.translate('Carrier') %>:</strong> <%- item.carrier %><br/>
      </small>
   </td>
   <td><%- item.tracking %></td>
   <td><%- item.state %></td>
</tr>
<% }) %>