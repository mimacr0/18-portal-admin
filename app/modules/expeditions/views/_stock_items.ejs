<table class="table table-hover table-striped table-sm">
   <thead>
      <tr>
         <th><input type="checkbox" id="selectAll" class="select-all-checkbox"></th>
         <th><%= i18n.__('Product') %></th>
         <th><%= i18n.__('State') %></th>
         <th class="text-right"><%= i18n.__('Quantity') %></th>
      </tr>
   </thead>
   <tbody>
      <% items.forEach(function(item, count){ %>
      <tr>
         <td style="width: 60px;" class="align-middle">
            <div class="icheck-primary stock-item-checkbox">
               <input type="checkbox" value="<%= item.id %>" id="<%= item.id %>">
               <label for="check<% count %>"></label>
            </div>
         </td>
         <td style="line-height: 1.1;">
            <small>
               <strong><%= i18n.__('Product') %>:</strong> <%- item.product.name %><br/>
               <strong><%= i18n.__('Reception date') %>:</strong> <%- item.reception_date %><br/>
               <strong><%= i18n.__('Tracking number') %>:</strong> <%- item.expedition1 %><br/>
               <% if(item.expedition) { %> <strong><%= i18n.__('Other tracking number') %>:</strong> <%- item.expedition %><br/><% } %>
               <strong><%= i18n.__('Reference') %>:</strong> <%- item.internal_ref %><br/>
               <strong><%= i18n.__('Serie') %>:</strong> <%- item.lot.name %><br/>
               <% if(item.lpn) { %><strong><%= i18n.__('LPN') %>:</strong> <%- item.lpn %><br/><% } %>
               <% if(item.lpn) { %><strong><%= i18n.__('IMEI') %>:</strong> <%- item.imei %><br/><% } %>
               <% if(item.sku) { %><strong><%= i18n.__('SKU') %>:</strong> <%- item.sku %> <% } %>
            </small>
         </td>
         <td class="align-middle"><%- item.product_state.label %></td>
         <td class="text-right align-middle"><%- item.quantity %></td>
      </tr>
      <% }) %>
   </tbody>
</table>