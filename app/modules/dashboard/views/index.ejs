<%- await include('../../../components/layout/html/_header', { page }) %>

      <!-- Main content -->
      <div class="content">

         <div class="container-fluid">

            <div style="height: 5px;"></div>

            <div class="row" id="dashboard-status-widget">
               <% for( const kpi of kpis.filter(kpi => kpi.type == 'state') ) { %>
               <%- await include('../../../components/dashboard/html/kpis/state', { kpi }) %>
               <% } %>
            </div>

            <div class="row">
               <div class="col-6">
                    <div class="row">
                        ##<% for( const kpi of kpis.filter(kpi => kpi.type == 'chart' && kpi.mode == 'bar') ) { %>
                        <%- await include('../../../components/dashboard/html/kpis/chart', { kpi }) %>
                        ##<% } %>
                    </div>
               </div>
               <div class="col-3">
                  <div class="row">
                     ##<% for( const kpi of kpis.filter(kpi => kpi.type == 'chart' && kpi.mode == 'pie') ) { %>
                        <%- await include('../../../components/dashboard/html/kpis/chart', { kpi }) %>
                     ##<% } %>
                 </div>
               </div>
               <div class="col-3">
                  <div class="kpi">
                     <div class="card" style="height: 482px">
                         <div class="card-header border-0">
                             <div class="d-flex justify-content-between">
                                 <h3 class="card-title mr-auto"></h3>
                             </div>
                         </div>
                         <div class="card-body">
                             <div class="position-relative mb-4" style="display: flex; justify-content: center; align-items: center; height: 100%;">
                                 <div style="text-align: center;">
                                     <div style="font-size: 1.5em; font-weight: bold;"><%= page.translate('Balance') %></div>
                                     <div style="font-size: 2.5em; font-weight: bold;">50 €</div>
                                     <button class="btn btn-primary mt-3" onclick="payNow()"><%= page.translate('Pay Now') %></button>
                                 </div>
                             </div>
                         </div>
                     </div>
                 </div>
               </div>
            </div>

         </div>

      </div>

<%- await include('../../../components/layout/html/_footer', { page }) %>

</body>

</html>