}

const baseChartPieOptions = {
    chart: {
        type: "pie",
        height: 210
    },
    series: [1],
    labels: [""],
    colors: ["#20c997"],
    legend: {
      position: 'bottom'
    },
    responsive: [{
        breakpoint: 480,
        options: {
            chart: {
                width: 200
            }
        }
    }]
}

const baseBarChartBarData = {
    series: [{ name: "", data: [0] }],
    xaxis: { categories: [""] },
    colors: ["#20c997"]
}

const initDashboardBarChart = (kpiId, data={}) => {
    const element = document.querySelector(`#kpi-chart-${kpiId}`)
    if(!element) return
    dashboardKPICharts[kpiId] = new ApexCharts(
        element, {
        ...baseChartBarOptions,
        ...baseBarChartBarData,
        ...data
    })
    dashboardKPICharts[kpiId].render()
}

const baseBarChartPieData = {
    series: [1],
    labels: [""],
    colors: ["#20c997"]
}

const initDashboardPieChart = (kpiId, data={}) => {
    dashboardKPICharts[kpiId] = new ApexCharts(
        document.querySelector(`#kpi-chart-${kpiId}`), {
        ...baseChartPieOptions,
        ...baseBarChartPieData,
        ...data
    })
    dashboardKPICharts[kpiId].render()
}

