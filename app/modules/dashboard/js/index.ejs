                return val.toLocaleString(undefined, {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }
        }
    },
    xaxis: {
        labels: {
            formatter: function (val) {
                return val.toLocaleString(undefined, {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }
        }
    },
    yaxis: {
        labels: {
            formatter: function (val) {
                return val.toLocaleString(undefined, {
