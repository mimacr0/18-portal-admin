<% items.forEach(function(item, count){ %>
<tr>
   <td style="width: 60px;">
      <div class="icheck-primary bot-bot-checkbox">
         <input type="checkbox" value="<%= item.internal_ref %>" id="check<% count %>">
         <label for="check<% count %>"></label>
      </div>
   </td>
   <td>
      <small>
         <strong><%= page.translate('Product') %>:</strong> <%- item.product %><br/>
         <strong><%= page.translate('Reception date') %>:</strong> <%- item.reception_date ? item.reception_date.split(' ')[0] : '' %><br/>
         <strong><%= page.translate('Tracking number') %>:</strong> <%- item.expedition1 %><br/>
         <strong><%= page.translate('Other tracking number') %>:</strong> <%- item.expedition %><br/>
         <strong><%= page.translate('Reference') %>:</strong> <%- item.internal_ref %><br/>
         <strong><%= page.translate('Serie') %>:</strong> <%- item.lot %><br/>
         <% if(item.lpn) { %><strong><%= page.translate('LPN') %>:</strong> <%- item.lpn %><br/><% } %>
         <strong><%= page.translate('IMEI') %>:</strong> <%- item.imei %><br/>
         <% if(item.sku) { %><strong><%= page.translate('SKU') %>:</strong> <%- item.sku %> <% } %>
      </small>
   </td>
   <td><%- item.product_state.label %></td>
   <td class="text-right"><%- item.quantity %></td>
</tr>
<% }) %>