
<!-- PROJECTS PROJECTS UPDATE MODAL -->
<div class="modal fade" id="stockExpeditionBatchCreateModal" tabindex="-1" role="dialog" aria-labelledby="stockExpeditionBatchCreateModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="stockExpeditionBatchCreateModalLabel"><%= page.translate('Create expedition') %></h5>
                <h5 class="modal-title init-hidden" id="stockExpeditionBatchCreateShippingModalLabel"><%= page.translate('Create shipping address') %></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="stock-expedition-create-form-data">
                    <div class="form-group">
                        <label for="stock-expedition-create-form-client-account-id"><%= page.translate('Client account') %></label>
                        <div class="select2-primary">
                            <select class="form-control" id="stock-expedition-create-form-client-account-id" name="client_account_id" style="width: 100%;" required="1">
                            </select>
                        </div>
                        <div class="invalid-feedback"><%= page.translate('Required field') %></div>
                    </div>
                    <div class="form-group">
                        <label for="stock-expedition-create-form-shipping-adddress-id"><%= page.translate('Shipping address') %></label>
                        <div class="input-group">
                            <div class="select2-primary flex-grow-1">
                                <select class="form-control" id="stock-expedition-create-form-shipping-adddress-id" name="shipping_adddress_id" required="1">
                                </select>
                            </div>
                            <button type="button" class="ml-1 btn btn-primary" id="add-shipping-address-btn">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback"><%= page.translate('Required field') %></div>
                    </div>

                    <input type="hidden" class="form-control" id="stock-expedition-create-form-id" name="id"/>

                </form>

                <!-- Hidden form for registering shipping address -->
                <div id="register-shipping-address-form" style="display: none;">

                    <div class="row p-1">

                        <div class="form-group o_portal_contact_name_group col-xl-12">
                            <input type="text" class="form-control" id="search_zip_code_input" placeholder="Search zip code..." autocomplete="off" style="background-color:#E7F1F0;color:#003DFD;"/>
                        </div>

                    </div>

                    <div class="row p-1">
                        <div class="col-xl-12" id="select_zip_code_list_container"></div>
                    </div>

                    <div class="row">
                        <div class="col-xl-12">
                            <hr/>
                            <div class="alert alert-danger" role="alert" style="display: none;" id="o_portal_contact_alert"></div>
                        </div>
                    </div>

                    <form id="register-contact-shipping-address-form" action="#">

                        <div class="row p-1">

                            <div class="form-group o_portal_contact_name_group col-xl-6">
                                <label class="col-form-label" for="contact_name">Contact Name</label>
                                <input name="contact_name" class="form-control o_portal_name" placeholder="Contact Name" required="1"/>
                            </div>

                            <div class="form-group o_portal_contact_email_group col-xl-6">
                                <label class="col-form-label" for="contact_email">Email</label>
                                <input name="contact_email" class="form-control o_portal_email" placeholder="Email"/>
                            </div>

                        </div>

                        <div class="row p-1">

                            <div class="form-group o_portal_contact_street_group col-xl-6">
                                <label class="col-form-label" for="contact_street">Address</label>
                                <input name="contact_street" class="form-control o_portal_street" placeholder="Street" required="1"/>
                            </div>

                            <div class="form-group o_portal_contact_phone_group col-xl-6">
                                <label class="col-form-label" for="contact_phone">Phone</label>
                                <input name="contact_phone" class="form-control o_portal_phone" placeholder="Phone" required="1"/>
                            </div>

                        </div>

                        <div class="row p-1">

                            <div class="form-group o_portal_contact_city_id_group col-xl-6">
                                <label class="col-form-label" for="contact_city_id">City</label>
                                <input name="contact_city_id" id="contact_city_id_select" class="form-control o_portal_contact_city_id" placeholder="City" required="1"/>
                            </div>

                            <div class="form-group o_portal_contact_state_id_group col-xl-6">
                                <label class="col-form-label" for="contact_zip">ZIP Code</label>
                                <input name="contact_zip" class="form-control o_portal_contact_zip" placeholder="ZIP" required="1"/>
                                <input type="hidden" id="stock-expedition-create-form-zip-id" name="zip_id"/>
                            </div>

                        </div>

                        <div class="row p-1">

                            <div class="form-group o_portal_contact_country_id_group col-xl-6">
                                <label class="col-form-label" for="contact_country_id">Country</label>
                                <select name="contact_country_id" id="contact_country_id_select" class="form-control o_portal_contact_country_id" required="1">
                                    <option value="">Select a country...</option>
                                </select>
                            </div>

                            <div class="form-group o_portal_contact_state_id_group col-xl-6" style="display: none;">
                                <label class="col-form-label" for="contact_state_id">State</label>
                                <select name="contact_state_id" id="contact_state_id_select" class="form-control o_portal_contact_state_id" required="1">
                                    <option value="">Select a state...</option>
                                </select>
                                <input type="hidden" id="contact_state_id_select_id"/>
                            </div>

                        </div>

                    </form>

                </div>

            </div>
            <div class="modal-footer" id="stock-expedition-account-buttons">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= page.translate('Close') %></button>
                <button type="button" class="btn btn-primary" id="stock-expedition-create-form-submit"><%= page.translate('Create') %></button>
            </div>
            <div class="modal-footer" id="stock-expedition-shipping-buttons" style="display: none;">
                <button type="button" class="btn btn-secondary" id="stock-expedition-create-shipping-back"><%= page.translate('Go back') %></button>
                <button type="button" class="btn btn-primary" id="stock-expedition-create-shipping-submit"><%= page.translate('Save Address') %></button>
            </div>
        </div>
    </div>
</div>

<!-- modal relative to the action zip code -->
<div role="dialog" class="modal fade" id="modalzip">
    <div class="modal-dialog">
        <div class="modal-content">
            <header class="modal-header">
                <h4 class="modal-title">ZIP Code</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
            </header>
            <main class="modal-body">

                <form action="#" class="row o_portal_expedition_order_contact_form" method="POST">

                    <div class="row p-1">

                        <div class="form-group o_portal_contact_name_group col-xl-12">
                            <input type="text" class="form-control" id="search_zip_code_input" placeholder="Search zip code..." autocomplete="off" style="background-color:#E7F1F0;color:#003DFD;"/>
                        </div>

                    </div>

                    <div class="row p-1">
                        <div class="col-xl-12" id="select_zip_code_list_container"></div>
                    </div>

                    <div class="row">
                        <div class="col-xl-12">
                            <hr/>
                            <div class="alert alert-danger" role="alert" style="display: none;" id="o_portal_contact_alert"></div>
                        </div>
                    </div>

                    <div class="row p-1">

                        <div class="form-group o_portal_contact_name_group col-xl-6">
                            <label class="col-form-label" for="contact_name">Contact Name</label>
                            <input name="contact_name" class="form-control o_portal_name" placeholder="Contact Name"/>
                        </div>

                        <div class="form-group o_portal_contact_email_group col-xl-6">
                            <label class="col-form-label" for="contact_email">Email</label>
                            <input name="contact_email" class="form-control o_portal_email" placeholder="Email"/>
                        </div>

                    </div>

                    <div class="row p-1">

                        <div class="form-group o_portal_contact_street_group col-xl-6">
                            <label class="col-form-label" for="contact_street">Address</label>
                            <input name="contact_street" class="form-control o_portal_street" placeholder="Street"/>
                        </div>

                        <div class="form-group o_portal_contact_phone_group col-xl-6">
                            <label class="col-form-label" for="contact_phone">Phone</label>
                            <input name="contact_phone" class="form-control o_portal_phone" placeholder="Phone"/>
                        </div>

                    </div>

                    <div class="row p-1">

                        <div class="form-group o_portal_contact_city_id_group col-xl-4">
                            <select name="contact_city_id" id="contact_city_id_select" class="form-control o_portal_contact_city_id">
                                <option value="">City...</option>
                            </select>
                        </div>

                        <div class="form-group o_portal_contact_state_id_group col-xl-4">
                            <select name="contact_state_id" id="contact_state_id_select" class="form-control o_portal_contact_state_id">
                                <option value="">State...</option>
                            </select>
                        </div>

                        <div class="form-group o_portal_contact_state_id_group col-xl-4">
                            <input name="contact_zip" class="form-control o_portal_contact_zip" placeholder="ZIP"/>
                        </div>

                    </div>

                    <div class="row p-1">

                        <div class="form-group o_portal_contact_country_id_group col-xl-4">
                            <select name="contact_country_id" id="contact_country_id_select" class="form-control o_portal_contact_country_id">
                                <option value="">Country...</option>
                                <t t-foreach="countries or []" t-as="country">
                                    <option t-att-value="country.id">
                                        <t t-esc="country.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                    </div>

                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                </form>

            </main>
            <footer class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Close
                </button>
                <button type="button" class="btn btn-primary o_portal_add_contact_btn" id="o_portal_add_contact_btn">
                    Confirm
                </button>
            </footer>
        </div>
    </div>
</div>