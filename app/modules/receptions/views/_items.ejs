<% items.forEach(function(item, count){ %>
<tr>
   <td>
      <small>
         <strong><%= page.translate('Number') %>:</strong> <%- item.name %><br/>
         <strong><%= page.translate('Reception Date') %>:</strong> <%- item.reception_date %><br/>
         <strong><%= page.translate('Tracking number') %>:</strong> <%- item.expedition1 %><br/>
      </small>
   </td>
   <td>
      <% if (item.state.value == 'on_hold') { %>
         <span class="badge bg-warning">
            <%- page.translate(item.state.label) %>
         </span>
      <% } %>
      <% if (item.state.value == 'done') { %>
         <span class="badge bg-success">
            <%- page.translate(item.state.label) %>
         </span>
      <% } %>
   </td>
</tr>
<% }) %>