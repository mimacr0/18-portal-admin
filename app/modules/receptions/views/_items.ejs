<% items.forEach(function(item, count){ %>
<tr>
   <td>
      <small>
         <strong><%= i18n.__('Number') %>:</strong> <a href="/receptions/details/<%= item.id %>"><%- item.name %></a><br/>
         <strong><%= i18n.__('Reception Date') %>:</strong> <%- item.reception_date %><br/>
         <strong><%= i18n.__('Tracking number') %>:</strong> <%- item.expedition1 %><br/>
      </small>
   </td>
   <td class="align-middle"><%= item.sender %></td>
   <td class="align-middle"><%= item.type.label %></td>
   <td class="align-middle"><%= item.carrier.name %></td>
   <td class="align-middle"><%- item.state %></td>
</tr>
<% }) %>