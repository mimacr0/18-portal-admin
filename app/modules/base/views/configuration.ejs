<%- await include('../../../components/layout/html/_header', { page }) %>

      <!-- Content Header (Page header) -->
      <div class="content-header">
         <div class="row">
            <div class="offset-3 col-6" id="page_messages_container"></div>
         </div>
      </div>
      <!-- /.content-header -->

      <!-- Main content -->
      <div class="content">

         <div class="row mb-2">
            <div class="col-sm-6">
              <h4 class="m-0"><%= page.translate('Configuration') %></h4>
            </div>
         </div>

         <div class="container-fluid text-center">

            <div class="row">
               <div class="offset-3 col-6">
                  <form id="user-config-form-data">
                     <div class="form-group row align-items-center">
                        <label for="user-config-form-sidebar" class="col-sm-4 col-form-label text-right">
                           <%= page.translate('Sidebar') %>
                        </label>
                        <div class="col-sm-8">
                           <select class="form-control form-control-sm" id="user-config-form-sidebar" name="sidebar">
                              <option value="" <%= !page.user.config.sidebar ? 'selected' : '' %>><%= page.translate('Select ...') %></option>
                              <option value="collapsed" <%= page.user.config.sidebar == 'collapsed' ? 'selected' : '' %>><%= page.translate('Collapsed') %></option>
                              <option value="sidebar-mini" <%= page.user.config.sidebar == 'sidebar-mini' ? 'selected' : '' %>><%= page.translate('Mini') %></option>
                              <option value="full" <%= page.user.config.sidebar == 'full' ? 'selected' : '' %>><%= page.translate('Full') %></option>
                           </select>
                        </div>
                     </div>

                     <div class="form-group row align-items-center">
                        <label for="user-config-form-dark-mode" class="col-sm-4 col-form-label text-right">
                           <%= page.translate('Dark Mode') %>
                        </label>
                        <div class="col-sm-8">
                           <select class="form-control form-control-sm" id="user-config-form-dark-mode" name="darkMode">
                              <option value="" <%= !page.user.config.darkMode ? 'selected' : '' %>><%= page.translate('Select ...') %></option>
                              <option value="enabled" <%= page.user.config.darkMode == 'enabled' ? 'selected' : '' %>><%= page.translate('Enabled') %></option>
                              <option value="disabled" <%= page.user.config.darkMode == 'disabled' ? 'selected' : '' %>><%= page.translate('Disabled') %></option>
                           </select>
                        </div>
                     </div>

                     <div class="form-group row align-items-center">
                        <label for="user-config-form-header" class="col-sm-4 col-form-label text-right">
                           <%= page.translate('Display Header') %>
                        </label>
                        <div class="col-sm-8">
                           <select class="form-control form-control-sm" id="user-config-form-header" name="header">
                              <option value="" <%= !page.user.config.header ? 'selected' : '' %>><%= page.translate('Select ...') %></option>
                              <option value="show" <%= page.user.config.header == 'show' ? 'selected' : '' %>><%= page.translate('Show') %></option>
                              <option value="hide" <%= page.user.config.header == 'hide' ? 'selected' : '' %>><%= page.translate('Hide') %></option>
                           </select>
                        </div>
                     </div>

                     <div class="form-group row align-items-center">
                        <label for="user-config-form-footer" class="col-sm-4 col-form-label text-right">
                           <%= page.translate('Display Footer') %>
                        </label>
                        <div class="col-sm-8">
                           <select class="form-control form-control-sm" id="user-config-form-footer" name="footer">
                              <option value="" <%= !page.user.config.footer ? 'selected' : '' %>><%= page.translate('Select ...') %></option>
                              <option value="show" <%= page.user.config.footer == 'show' ? 'selected' : '' %>><%= page.translate('Show') %></option>
                              <option value="hide" <%= page.user.config.footer == 'hide' ? 'selected' : '' %>><%= page.translate('Hide') %></option>
                           </select>
                        </div>
                     </div>

                     <div class="form-group row">
                        <div class="col-sm-12 text-right">
                           <button type="submit" class="btn btn-primary btn-sm">
                              <%= page.translate('Save') %>
                           </button>
                           <button type="reset" class="btn btn-secondary btn-sm">
                              <%= page.translate('Reset') %>
                           </button>
                        </div>
                     </div>
                  </form>
               </div>
            </div>

         </div>

      </div>

<%- await include('../../../components/layout/html/_footer', { page }) %>

</body>

</html>