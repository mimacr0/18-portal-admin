<!DOCTYPE html>
<html lang="<%= lang || 'en' %>">

<head>
   <meta charset="utf-8">
   <link rel="manifest" crossorigin="use-credentials" href="/app/manifest.json"/>
   <meta name="viewport" content="width=device-width, initial-scale=1">
   <meta name="theme-color" content="#2589bb"/>
   <meta name="apple-mobile-web-app-capable" content="yes"/>
   <meta name="apple-mobile-web-app-status-bar-style" content="black"/>
   <meta name="apple-mobile-web-app-title" content="<%= appTitle %>"/>
   <meta name="mobile-web-app-capable" content="yes"/>
   <link rel="apple-touch-icon" href="/img/app/app-icon.png"/>
   <link rel="shortcut icon" href="/img/app/app-icon.png"/>
   <link rel="icon" href="img/favicon.ico" type="image/x-icon"/>
   <title><%= title %></title>

   <link rel="stylesheet" href="/fonts/Source+Sans+Pro.css">
   <link rel="stylesheet" href="/plugins/fontawesome-free/css/all.min.css">
   <link rel="stylesheet" href="/plugins/icheck-bootstrap/icheck-bootstrap.min.css">
   <link rel="stylesheet" href="/css/adminlte.min.css">
</head>

<body class="hold-transition login-page">
   <div class="login-box">

      <div class="card card-outline card-primary">
         <div class="card-header text-center">
            <img src="img/black.svg" class="img-fluid" alt="Logo" style="max-height: 120px;" />
         </div>
         <div class="card-body">
            <p class="login-box-msg"><%= title %></p>

            <div class="alert alert-danger alert-dismissible" style="background-color: #dc3545eb; border-color: #dc3545eb; display: none;">
               <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
               <span><i class="icon fas fa-ban"></i></span>
               <span class="message">Inicio de sesión incorrecto</span>
            </div>

            <form action="#" method="post">
               <div class="form-group input-group mb-3">
                  <input type="text" name="username" class="form-control" placeholder="Usuario" required="1" autocomplete="0"/>
                  <div class="input-group-append">
                     <div class="input-group-text">
                        <span class="fas fa-user"></span>
                     </div>
                  </div>
                  <div class="invalid-feedback">
                     Campo requerido
                  </div>
               </div>
               <div class="form-group input-group mb-3">
                  <input type="password" name="password" class="form-control" placeholder="Contraseña" required="1" autocomplete="0"/>
                  <div class="input-group-append">
                     <div class="input-group-text">
                        <span class="fas fa-lock"></span>
                     </div>
                  </div>
                  <div class="invalid-feedback">
                     Campo requerido
                  </div>
               </div>
               <div class="row">
                  <div class="col-12 text-center">
                     <button type="button" class="btn btn-primary btn-block login-button">Iniciar</button>
                  </div>
               </div>
            </form>

         </div>
      </div>
   </div>

   <script src="/plugins/jquery/jquery.min.js"></script>
   <script src="/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
   <script src="/js/adminlte.min.js"></script>
   <script src="/js/login.js"></script>

</body>

</html>