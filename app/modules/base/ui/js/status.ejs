<% if (page.state) { %>
const reloadStatus = async () => {
    const container = $('#main-status-widget')
    container.addClass('text-center')
    container.html(`<%- include('../views/status/_loading') %>`)
    const res = await jsonGet('/<%= page.name %>/page/header/status')
    if(res?.status != 'success') return
    container.html(res.data)
    container.removeClass('text-center')
}
##<% } %>

##<% if(page.state) { %>
reloadStatus()
##<% } %>