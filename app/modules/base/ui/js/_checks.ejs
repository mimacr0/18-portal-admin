
//Enable check and uncheck all functionality
$('.<%= card.id.id %>-checkbox').click(function () {
    var clicks = $(this).data('clicks')
    if (clicks) {
        //Uncheck all checkboxes
        $('.<%= card.id.id %>-main-container input[type=\'checkbox\']').prop('checked', false)
        $('.<%= card.id.id %>-checkbox .far.fa-check-square').removeClass('fa-check-square').addClass('fa-square')
    } else {
        //Check all checkboxes
        $('.<%= card.id.id %>-main-container input[type=\'checkbox\']').prop('checked', true)
        $('.<%= card.id.id %>-checkbox .far.fa-square').removeClass('fa-square').addClass('fa-check-square')
    }
    $(this).data('clicks', !clicks)
})