<% const name = action.getName(card) %>
const <%= name.modal.before.var %> = async (e) => {
    $('#<%= name.modal.before.var %>Modal').modal('toggle')
}

const <%= name.modal.before.var %>FormSubmit = async () => {
    const res = await formPost('<%= name.modal.before.url %>', "#<%= name.modal.before.id %>-form-data")
    if(res?.status != 'success') return
    $('#<%= name.modal.before.id %>-form-id').val("")
    $('#<%= name.modal.before.var %>Modal').modal('toggle')
    <%= card.id.var %>ReloadList()
}

$('#<%= name.id %>').click(<%= name.modal.before.var %>)
$('#<%= name.modal.before.id %>-form-submit').click(<%= name.modal.before.var %>FormSubmit)