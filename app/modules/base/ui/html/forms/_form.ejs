<% const name = form.name %>
<!-- <%= name.upper %> -->
<div class="modal fade" id="<%= name.var %>Modal" tabindex="-1" role="dialog" aria-labelledby="<%= name.var %>ModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="<%= name.var %>ModalLabel"><%= form.title %></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" class="form-control" id="<%= name.id %>-form-id" name="id"/>
                <form id="<%= name.id %>-form-data">
                    <% form.fields.filter(f => f.tmpl).forEach(field => { %>
                        <%- include(`_${field.tmpl}.ejs`, { form, field }) %>
                    <% }) %>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <% if( form.submit ) { %>
                <button type="button" class="btn btn-primary" id="<%= name.id %>-form-submit">Confirm</button>
                <% } %>
            </div>
        </div>
    </div>
</div>