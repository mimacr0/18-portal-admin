<% let groupId = `${field.id}-group` %>
<% let group = {...{ class: 'form-group', id: groupId }, ...field?.group } %>

<div <%- Object.entries(group).map(([key, value]) => `${key}="${value}"`).join(' ') %>>
    <% if (field.label) { %>
        <label for="<% field.id %>"><%= field.label %></label>
    <% } %>
    <select <%- Object.entries({...{ class: 'form-control', id: field.id, name: field.name }, ...field.attrs }).map(([key, value]) => `${key}="${value}"`).join(' ') %>>
        <% Object.entries(field.options || {}).map(([k, v]) => { return { value: k, text: v } }).forEach(function(option) { %>
            <option value="<%= option.value %>"><%= option.text %></option>
        <% }) %>
    </select>
    <% if (field.required) { %>
        <div class="invalid-feedback"><%= field.requiredText || 'This field is required' %></div>
    <% } %>
</div>
