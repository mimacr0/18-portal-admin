<!DOCTYPE html>
<html lang="<%= page.lang || 'en' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="manifest" crossorigin="use-credentials" href="/app/manifest.json"/>
  <meta name="theme-color" content="#2589bb"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="black"/>
  <meta name="apple-mobile-web-app-title" content="<%= page.appTitle %>"/>
  <meta name="mobile-web-app-capable" content="yes"/>
  <link rel="apple-touch-icon" href="/img/app/app-icon.png"/>
  <link rel="icon" href="img/favicon.ico" type="image/x-icon"/>
  <title><%= page.title %></title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="/fonts/Source+Sans+Pro.css">
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="/plugins/fontawesome-free/css/all.min.css">
  <!-- IonIcons -->
  <link rel="stylesheet" href="/plugins/ionicons/css/ionicons.min.css">
  <!-- Tempusdominus Bootstrap 4 -->
  <link rel="stylesheet" href="/plugins/tempusdominus-bootstrap-4/css/tempusdominus-bootstrap-4.min.css">
  <!-- Select2 -->
  <link rel="stylesheet" href="/plugins/select2/css/select2.min.css">
  <link rel="stylesheet" href="/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css">
  <!-- Theme style -->
  <link rel="stylesheet" href="/css/adminlte.min.css">

  <link rel="stylesheet" href="/static/base/css/main.css">

  <link rel="icon" type="image/x-icon" href="/img/favicon.ico">

  <% page.assets.header.css.forEach(function(css){ %>
  <link <%- css.attrsHTML %>>
  <% }) %>

  <% page.assets.header.js.forEach(function(script){ %>
  <script <%- script.attrsHTML %>></script>
  <% }) %>

</head>
<!--
`body` tag options:

  Apply one or more of the following classes to to the body tag
  to get the desired effect

  * sidebar-collapse
  * sidebar-mini
-->
<body class="hold-transition <%= typeof(clean) != "undefined" && clean ? "" : "sidebar-mini" %> sidebar-collapse">
<div class="wrapper">

    <%- include('navbar') %>

    <%- include('sidebar') %>

    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper <%= typeof(iframe) != "undefined" && iframe ? 'iframe-mode' : '' %>" data-widget="iframe">