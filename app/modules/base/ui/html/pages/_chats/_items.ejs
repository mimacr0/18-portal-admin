<% items.forEach(function(item){ %>
<li class="nav-item p-1 messages-chats-item" data-id="<%= item?.id %>" data-name="<%= item?.name %>" data-time="<%=  %>">
   <div class="media">
         <img class="img-size-50 img-circle mr-3" src="<%= item?.imageSrc %>">
         <div class="media-body">
            <h3 class="dropdown-item-title">
               <strong class="messages-chats-item-name"><%= item?.data?.displayName || item?.name %></strong>
               <% if(item?.data?.unread > 0) { %>
               <span class="ml-3 badge badge-pill badge-success" data-count-id="<%= item?.id %>"><%= item?.data?.unread %> </span>
               <% } %>
               <span class="ml-3 messages-chat-item-active-label" data-active-id="<%= item?.id %>"></span>
               <% if(item?.data?.isGroup) { %>
               <span class="float-right mt-1 mr-2 p-0 btn btn-tool btn-sm text-sm"><i class="fa fa-users"></i></span>
               <% } %>
               <% if(item?.data?.isMuted) { %>
               <span class="float-right mt-1 mr-2 p-0 btn btn-tool btn-sm text-sm"><i class="fa fa-volume-mute"></i></span>
               <% } %>
            </h3>
            <p class="text-sm text-muted">
               <span class="chat-item-timeago messages-messages-last-message"><%- item?.lastMessage %></span>
            </p>
         </div>
   </div>
</li>
<% }) %>