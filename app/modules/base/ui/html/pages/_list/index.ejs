<div class="card">

                     <div class="card-header">
                        <h3 class="card-title"><span class="text-muted"><%= i18n.__(card.title) %></span></h3>
                        <div class="card-tools <%= card.id.id %>-card-tools">
                           <% for( const action of card.actions.tools ) { %>
                           <%- include(`actions/_${action.htmlTemplate('tools')}`, { card, action }) %>
                           <% } %>
                           <button class="btn btn-tool" data-card-widget="collapse" type="button" data-toggle="tooltip" title="<%= i18n.__('Collapse') %>">
                              <i class="fas fa-minus"></i>
                           </button>
                        </div>
                     </div>

                     <div class="card-body p-0">
                        <div class="mailbox-controls">
                           <div class="row">
                              <div class="col-6">
                                 <div class="<%= card.id.id %>-batch-actions">
                                    <% if(card.actions.batch.length > 0) { %>
                                    <span>&nbsp;&nbsp;</span>
                                    <button type="button" class="btn btn-default btn-sm checkbox-toggle <%= card.id.id %>-checkbox"><i class="far fa-square"></i></button>
                                    <% } %>
                                    <% if(card.actions.crud.create) { %>
                                    <button type="button" class="btn btn-default btn-sm <%= card.id.id %>-create-button" data-toggle="tooltip" data-placement="right" data title="<%= i18n.__('Create new record') %>">
                                       <i class="fas fa-plus"></i>
                                    </button>
                                    <% } %>
                                    <% for( const action of card.actions.batch ) { %>
                                    <%- include('actions/_batch', { card, action }) %>
                                    <% } %>
                                 </div>
                              </div>
                              <div class="col-6">
                                 <div>
                                    <div class="input-group input-group-sm float-right" style="max-width: 250px;">
                                       <input type="text" name="table_search" class="form-control float-right" placeholder="<%= i18n.__('Search') %>" id="<%= card.id.id %>-search-input">
                                       <div class="input-group-append">
                                          <button type="submit" class="btn btn-default">
                                             <i class="fas fa-search"></i>
                                          </button>
                                       </div>
                                    </div>
                                 </div>
                              </div>
                           </div>
                        </div>
                        <div class="table-responsive mailbox-messages <%= card.id.id %>-main-container">
                           <table class="table table-hover table-striped table-sm" style="overflow: hidden;">
                              <thead>
                                 <tr>
                                    <% if(card.actions.batch.length > 0) { %>
                                    <th><span>&nbsp;</span></th>
                                    <% } %>
                                    <% for( const column of card.columns ) { %>
                                    <th><%= i18n.__(column.label) %></th>
                                    <% } %>
                                    <th class="text-right"><%= i18n.__('Actions') %></th>
                                 </tr>
                              </thead>
                              <tbody id="<%= card.id.id %>-list"></tbody>
                           </table>
                        </div>
                     </div>

                     <div class="card-footer clearfix" id="<%= card.id.id %>-footer"></div>

                  </div>