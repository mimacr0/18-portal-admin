<div class="<%= kpi.size %> kpi" data-id="<%= kpi.id %>">
    <div class="card callout callout-success" style="height: 150px">
        <div class="card-header border-0" style="margin: 0; padding: 0; padding-left: 20px;">
            <div class="d-flex justify-content-between">
                <h3 class="card-title"><%= kpi.title %></h3>
            </div>
        </div>

        <div class="card-body mt-1" style="padding-bottom: 0px; padding-top: 0px;">

            <div class="d-flex justify-content-between border-bottom">
                <div class="p-1 text-left"><span class="text-muted">STATUS</span></div>
                <div class="p-1 text-right">
                    <span class="badge badge-success">WAIT</span>
                </div>
            </div>

            <div class="d-flex flex-wrap border-bottom pt-1 pb-1">
                <span style="margin: 2px;" class="badge badge-success">CPU: 1%</span>
            </div>
        </div>

    </div>
</div>