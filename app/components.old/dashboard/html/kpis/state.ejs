<div class="<%= kpi.size %>">
    <div class="info-box mb-3">
        <span class="info-box-icon bg-<%= 'success' %> elevation-1"><i class="<%= kpi.icon %>"></i></span>
        <div class="info-box-content">
            <span class="info-box-text"><%= page.translate(kpi.label) %></span>
            <span class="info-box-number">
                <span class="number-display" data-value="0" id="kpi-value-<%= kpi.ref %>">0</span>
                <small><%= kpi.symbol %></small>
            </span>
        </div>
    </div>
</div>