<div <%- field.groupHTML({class: 'container mt-3'}) %>>
    <div class="row">
        <div class="col-md-12">
            <div class="drop-area" id="<%= field.id %>-drop-area">
                <input type="file"  id="<%= field.id %>" name="file" hidden="1" required="1">
                <label for="<%= field.id %>" class="btn btn-primary btn-block small-form-file-label">Select Files</label>
                <button id="<%= field.id %>-clear" class="btn btn-danger mt-1 btn-clear">Clear</button>
            </div>
        </div>
    </div>
    <div id="<%= field.id %>-file-list" class="mt-2"></div>
    <div class="invalid-feedback">required field</div>
</div>
