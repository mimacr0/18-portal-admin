<div class="card">

    <div class="card-header">
       <h3 class="card-title"><span class="text-muted">Chats</span></h3>
       <div class="card-tools messages-chats-card-tools">
          <span class="btn btn-tool btn-sm" id="messages-chats-reload-tools-action" data-toggle="tooltip" title="Recargar chats">
             <i class="fa fa-sync-alt"></i>
          </span>
          <button class="btn btn-tool" data-card-widget="collapse" type="button" data-toggle="tooltip" title="Replegar/desplegar panel">
             <i class="fas fa-minus"></i>
          </button>
       </div>
    </div>

    <div class="card-body p-0">
       <div class="mailbox-controls">
          <div class="row">
             <div class="col-12">
                <div>
                   <div class="input-group input-group-sm float-right">
                      <input type="text" name="table_search" class="form-control float-right" placeholder="Search" id="messages-chats-search-input">
                         <div class="input-group-append">
                            <button type="submit" class="btn btn-default">
                               <i class="fas fa-search"></i>
                            </button>
                         </div>
                   </div>
                </div>
             </div>
          </div>
       </div>
       <div class="table-responsive mailbox-messages messages-chats-main-container">
          <ul class="nav nav-pills flex-column" id="messages-chats-list" style="overflow: hidden;"></ul>
       </div>
    </div>

    <div class="card-footer clearfix" id="messages-chats-footer"></div>

 </div>