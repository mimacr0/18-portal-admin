##<% const name = form.name %>
const <%= name.var %>FormSubmit = async () => {
    const res = await formPost('<%= name.url %>/action', "#<%= name.id %>-form-data")
    if(res?.status != 'success') return
    $('#<%= name.id %>-form-id').val("")
    $('#<%= name.var %>Modal').modal('toggle')
    <%= card.id.var %>ReloadList()
}

$('#<%= name.id %>-form-submit').click(<%= name.var %>FormSubmit)

const <%= name.var %>FormReset = async () => {
    $('#<%= name.id %>-form-data').removeClass('was-validated')
}

$('#<%= name.var %>Modal').on('hidden.bs.modal', <%= name.var %>FormReset)