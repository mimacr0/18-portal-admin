const messagesMessagesReloadList = async (clear=false) => {
    const currentChat = $('#messages-message-form-chat-id').val()
    if(!currentChat) return
    let q = $('#messages-messages-search-input').val()
    $('.tooltip').remove()
    const res = await jsonGet(`/messages/messages/list/${currentChat}?q=${q || ''}&clear=${clear || ''}`)
    if(!res?.status != 'success') return
    $('#messages-messages-list').html(res.html)
    $('#messages-messages-chat-messages-container').scrollTop($('#messages-messages-chat-messages-container')[0].scrollHeight)
}

const messagesMessagesSelectChat = () => {
    if(window.mobileDetect()) {
        $('.messages-chats-card-container').hide()
        $('.messages-messages-card-container').removeClass('d-none')
        $('.messages-messages-list-action-back-button').show()
    }
    messagesMessagesReloadList(true)
}

const messagesMessagesSelectByURL = async () => {
    const hash = window.location.hash
    if (!hash) return
    const chat_id = hash.replace('#', '')
    $('#messages-message-form-chat-id').val(chat_id)
    messagesMessagesSelectChat()
    await messagesChatsReloadList()
    document.dispatchEvent(new CustomEvent('messages-chat-selected', {
        detail: { chat_id: chat_id }
    }))
}

const messagesMessagesSelectChatEvent = (e) => {
    $('#messages-message-form-chat-id').val(e.detail.chat_id)
    messagesMessagesSelectChat()
}

document.addEventListener('messages-chat-selected', messagesMessagesSelectChatEvent)

window.addEventListener("hashchange", () => {
    messagesMessagesSelectByURL()
}, false)