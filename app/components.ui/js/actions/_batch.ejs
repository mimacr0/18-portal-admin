##<% const name = action.getName(card) %>
const <%= name.var %>Done = async (itemIds) => {
    if(itemIds.length == 0) return alert('No hay elementos seleccionados')
    loadingShow('Cargando ...')
    await jsonPost(`<%= name.url %>`, { ids: itemIds })
    loadingHide()
    $('.<%= card.id.id %>-checkbox .far.fa-check-square').removeClass('fa-check-square').addClass('fa-square');
    $('.<%= card.id.id %>-checkbox').data('clicks', false)
    <%= card.id.var %>ReloadList()
}

const <%= name.var %> = async () => {
    let itemIds = []
    $('.<%= card.id.id %>-main-container input[type=\'checkbox\']').each(function() {
        if ($(this).is(':checked')) itemIds.push($(this).val());
    }).promise().done(() => { <%= name.var %>Done(itemIds) })
}

$('#<%= name.id %>').click(<%= name.var %>)