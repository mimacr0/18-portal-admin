<div class="<%= kpi.size %> kpi" data-id="<%= kpi.id %>">
    <div class="card callout callout-success" style="height: 150px; padding-top: 5px; margin-top: 0px;">
        <div class="card-header border-0" style="margin: 0; padding: 0;">
            <div class="d-flex justify-content-between">
                <h3 class="card-title"><%= kpi.title %></h3>
            </div>
        </div>

        <div class="card-body mt-1" style="padding: 0px;">

            ##<% if(kpi.icon) { %>
            <div class="d-flex flex-wrap" style="font-size: 1.5rem; font-weight: bold;">
                <span><%- kpi.icon %></span>
                <span id="exchange-value-<%= kpi.id %>" style="margin-left: 3px; margin-top: 1px;"><%= kpi.value %></span>
                <span style="margin-left: 3px; margin-top: 1px;"><%= kpi.currency %></span>
            </div>
            ##<% } %>

            <div class="d-flex flex-wrap pt-1">
                <div id="exchange-chart-<%= kpi.id %>" style="width: 100%; height: 100px;"></div>
            </div>

        </div>
    </div>
</div>