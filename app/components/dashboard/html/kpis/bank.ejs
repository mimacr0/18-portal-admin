<div class="<%= kpi.size %> kpi" data-id="<%= kpi.id %>">
    <div class="card callout callout-success" style="height: 150px; padding-top: 5px; margin-top: 0px;">
        <div class="card-header border-0" style="margin: 0; padding: 0;">
            <div class="d-flex justify-content-between">
                <h3 class="card-title mr-auto"><%= kpi.title %></h3>
                <span>
                    <button class="btn btn-tool btn-sm" type="button" data-toggle="modal" data-target="#bank-details-<%= kpi.id %>">
                        <i class="fa fa-info-circle"></i>
                    </button>
                </span>
            </div>
        </div>

        <div class="card-body mt-1" style="padding: 0px;">

            <div class="d-flex flex-wrap border-bottom pt-1 pb-1" id="bank-badges-<%= kpi.id %>" style="min-height: 30px;">
                <%- await include(`_badges`, { badges: kpi.badges }) %>
            </div>

            <div class="d-flex flex-wrap pt-1 pb-1">
                <div id="bank-chart-<%= kpi.id %>" style="width: 100%; height: 90px;"></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bank-details-<%= kpi.id %>" tabindex="-1" role="dialog" aria-labelledby="bank-details-<%= kpi.id %>Label" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bank-details-<%= kpi.id %>Label"><%= kpi.title %></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    ##<% let incomeTotal = 0; let expensesTotal = 0 %>
                    ##<% if(kpi.image) { %>
                    <div class="row">
                        <div class="col-md-12 text-center">
                            <img src="<%= kpi.image %>" class="img-fluid" alt="Bank image" style="max-height: 200px;"/>
                        </div>
                    </div>
                    ##<% } %>
                    <div class="mt-3">
                        <div class="row mb-3" style="margin-left: 0px; margin-right: 0px; padding-left: 0px; padding-right: 0px;">
                            <div class="col-md-2">
                                <strong>Date</strong>
                            </div>
                            <div class="col-md-8">
                                <strong>Description</strong>
                            </div>
                            <div class="col-md-2 text-right">
                                <strong>Amount</strong>
                            </div>
                        </div>
                        ##<% for( const line of kpi.lines ) { %>
                        ##<% incomeTotal += line.amount > 0 ? line.amount : 0 %>
                        ##<% expensesTotal += line.amount < 0 ? line.amount : 0 %>
                        <div class="row" style="margin: 0px; padding: 0px;">
                            <div class="col-md-2">
                                <span class="badge badge-info">
                                    <%= line.date %>
                                </span>
                            </div>
                            <small class="col-md-8">
                                <p class="text-muted">
                                    <%= line.detail %>
                                </p>
                            </small>
                            <div class="col-md-2 text-right">
                                <span class="badge badge-<%= line.amount > 0 ? 'success' : 'danger' %>">
                                    <%= line.rawAmount %>
                                </span>
                            </div>
                        </div>
                        <%} %>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6 offset-md-6">
                            <div class="row">
                                <div class="col-6">
                                    <strong>Income:</strong>
                                </div>
                                <div class="col-6 text-right">
                                    <span class="badge badge-success">
                                        $<%= (incomeTotal || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',') %>
                                    </span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <strong>Expenses:</strong>
                                </div>
                                <div class="col-6 text-right">
                                    <span class="badge badge-danger">
                                        $<%= (expensesTotal || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',') %>
                                    </span>
                                </div>
                            </div>
                            <hr>
                            <div class="row">
                                <div class="col-6">
                                    <strong>Total:</strong>
                                </div>
                                <div class="col-6 text-right">
                                    <span class="badge badge-<%= (incomeTotal + expensesTotal) >= 0 ? 'success' : 'danger' %>">
                                        $<%= ((incomeTotal || 0) + (expensesTotal || 0)).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',') %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>