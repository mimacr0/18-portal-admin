<div class="<%= kpi.size %> kpi" data-id="<%= kpi.id %>">
    <div class="card" style="height: 233px">
        <div class="card-header border-0">
            <div class="d-flex justify-content-between">
                <h3 class="card-title mr-auto"><%= kpi.title %></h3>
                ##<% if(kpi.mode == 'bar') { %>
                ##<% for(const serie of kpi.series) { %>
                <span class="mr-2"><i class="fas fa-square" style="color: <%= serie.color %>"></i> <%= serie.label %></span>
                ##<% } %>
                ##<% } %>
            </div>
        </div>
        <div class="card-body">
            <div class="position-relative mb-4">
                 <div id="kpi-chart-<%= kpi.id %>"></div>
            </div>
        </div>
    </div>
</div>