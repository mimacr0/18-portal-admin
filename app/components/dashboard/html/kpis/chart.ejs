<div class="<%= kpi.size %> kpi" data-id="<%= kpi.id %>">
    <div class="card callout callout-success" style="height: 233px;">
        <div class="card-header border-0" style="padding: 0px; margin: 0px;">
            <div class="d-flex justify-content-between">
                <h3 class="card-title mr-auto"><%= kpi.title %></h3>
                ##<% if(kpi.mode == 'bar') { %>
                ##<% for(const serie of kpi.series) { %>
                <span class="mr-2"><i class="fas fa-square" style="color: <%= serie.color %>"></i> <%= serie.name %></span>
                ##<% } %>
                ##<% } %>
            </div>
        </div>
        <div class="card-body" style="padding: 0px; margin: 0px;">
            <div id="kpi-chart-<%= kpi.id %>"></div>
        </div>
    </div>
</div>