<div class="<%= kpi.size %> kpi" data-id="<%= kpi.id %>">
    <div class="card callout callout-success" style="height: 223px;">
        <div class="card-header border-0" style="padding: 0px; margin: 0px;">
            <div class="d-flex justify-content-between">
                <h3 class="card-title mr-auto"><%= kpi.title %></h3>
                <span>
                    <button class="btn btn-tool btn-sm" type="button" data-toggle="modal" data-target="#logchart-details-<%= kpi.id %>">
                        <i class="fa fa-info-circle"></i>
                    </button>
                </span>
            </div>
        </div>
        <div class="card-body" style="padding: 0px; margin: 0px;">
            <div class="mt-2">
                <div id="kpi-logchart-<%= kpi.id %>"></div>
            </div>
        </div>
    </div>
</div>

<div id="logchart-details-<%= kpi.id %>" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="logchart-details-<%= kpi.id %>" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="logchart-details-<%= kpi.id %>Label"><%= kpi.title %></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-4">
                            <strong>User</strong>
                        </div>
                        <div class="col-md-2">
                            <strong>Server</strong>
                        </div>
                        <div class="col-md-2">
                            <strong>DB</strong>
                        </div>
                        <div class="col-md-2">
                            <strong>Last Update</strong>
                        </div>
                        <div class="col-md-2 text-right">
                            <strong>Status</strong>
                        </div>
                    </div>
                    <div class="row">
                        ##<% for( const user of kpi.users ) { %>
                        <div class="col-md-4 text-muted">
                            <span><%= user.name %></span>
                        </div>
                        <div class="col-md-2 text-muted">
                            <span><%= user.server %></span>
                        </div>
                        <div class="col-md-2 text-muted">
                            <span><%= user.db %></span>
                        </div>
                        <div class="col-md-2 text-muted">
                            <span class="badge badge-success">
                                <%= kpi.timeAgoLabel(user.lastUpdate) %>
                            </span>
                        </div>
                        <div class="text-right col-md-2">
                            ##<% if(user.im_status == 'online') { %>
                            <span class="badge badge-success">ONLINE</span>
                            ##<% } else if(user.im_status == 'away') { %>
                            <span class="badge badge-warning">AWAY</span>
                            ##<% } else { %>
                            <span class="badge badge-secondary">OFFLINE</span>
                            ##<% } %>
                        </div>
                        ##<% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>