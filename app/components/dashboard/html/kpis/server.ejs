## <% const data = kpi.viewData %>
<div class="<%= kpi.size %> kpi" data-id="<%= kpi.id %>">
    <div class="card callout callout-success" style="height: 150px">
        <div class="card-header border-0" style="margin: 0; padding: 0; padding-left: 20px;">
            <div class="d-flex justify-content-between">
                <h3 class="card-title"><%= kpi.title %></h3>
            </div>
        </div>

        <div class="card-body mt-1" style="padding-bottom: 0px; padding-top: 0px;">

            <div class="row">

                <div class="col-4 text-muted text-sm">
                    <span class="fa fa-microchip"></span>
                    <span>CPU</span>
                </div>

                <div class="col-4 text-muted text-sm">
                    <span class="fa fa-memory"></span>
                    <span>RAM</span>
                </div>

                <div class="col-4 text-muted text-sm">
                    <span class="fa fa-hdd"></span>
                    <span>DISK</span>
                </div>

            </div>

            <div class="row">

                <div class="col-4">
                    <div class="progress-group">
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-<%= data.cpu.color %>" data-widget="cpu" style="width: <%= data.cpu.value %>%"></div>
                        </div>
                    </div>
                </div>

                <div class="col-4">
                    <div class="progress-group">
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-<%= data.memory.color %>" data-widget="memory" style="width: <%= data.memory.value %>%"></div>
                        </div>
                    </div>
                </div>

                <div class="col-4">
                    <div class="progress-group">
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-<%= data.disk.color %>" data-widget="storage" style="width: <%= data.disk.value %>%"></div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="d-flex flex-wrap border-bottom pt-1 pb-1">
                <span style="margin: 2px;" class="badge badge-secondary">-</span>
            </div>
        </div>
    </div>
</div>