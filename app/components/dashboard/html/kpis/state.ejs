<div class="<%= kpi.size %>">
    <div class="info-box mb-3 callout callout-success">
        <span class="info-box-icon bg-<%= 'success' %> elevation-1"><i class="<%= kpi.icon %>"></i></span>
        <div class="info-box-content">
            <span class="info-box-text"><%= kpi.label %></span>
            <span class="info-box-number">
                <span class="number-display" data-value="<%= kpi.value %>" id="kpi-value-<%= kpi.id %>"><%= kpi.value %></span>
                <small><%= kpi.symbol %></small>
            </span>
        </div>
    </div>
</div>