<div class="<%= kpi.size %> kpi" data-id="<%= kpi.id %>">
    <div class="card callout callout-success" style="height: 150px; padding-top: 5px; margin-top: 0px;">
        <div class="card-header border-0" style="margin: 0; padding: 0;">
            <div class="d-flex justify-content-between">
                <h3 class="card-title"><%= kpi.title %></h3>
            </div>
        </div>

        <div class="card-body mt-1" style="padding: 0px;">

            <div class="row">

                <div class="col-4 text-muted text-sm">
                    <span class="fa fa-microchip"></span>
                    <span>CPU</span>
                </div>

                <div class="col-4 text-muted text-sm">
                    <span class="fa fa-memory"></span>
                    <span>RAM</span>
                </div>

                <div class="col-4 text-muted text-sm">
                    <span class="fa fa-hdd"></span>
                    <span>DISK</span>
                </div>

            </div>

            <div class="row">

                <div class="col-4">
                    <div class="progress-group">
                        <div class="progress progress-sm">
                            <div id="station-cpu-<%= kpi.id %>" class="progress-bar bg-<%= kpi.cpu.color %>" data-widget="cpu" style="width: <%= kpi.cpu.value %>%"></div>
                        </div>
                    </div>
                </div>

                <div class="col-4">
                    <div class="progress-group">
                        <div class="progress progress-sm">
                            <div id="station-memory-<%= kpi.id %>" class="progress-bar bg-<%= kpi.memory.color %>" data-widget="memory" style="width: <%= kpi.memory.value %>%"></div>
                        </div>
                    </div>
                </div>

                <div class="col-4">
                    <div class="progress-group">
                        <div class="progress progress-sm">
                            <div id="station-storage-<%= kpi.id %>" class="progress-bar bg-<%= kpi.storage.color %>" data-widget="storage" style="width: <%= kpi.storage.value %>%"></div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="d-flex flex-wrap pt-1 pb-1">
                <div id="station-chart-<%= kpi.id %>" style="width: 100%; height: 100px;"></div>
            </div>

        </div>
    </div>
</div>