<div class="<%= kpi.size %> kpi" data-id="<%= kpi.id %>">
    <div class="card" style="height: 150px">
        <div class="card-header border-0" style="margin: 0; padding: 0; padding-left: 20px;">
            <div class="d-flex justify-content-between">
                <h3 class="card-title"><%= kpi.title %></h3>
            </div>
        </div>

        <div class="card-body mt-1" style="padding-bottom: 0px; padding-top: 0px;">

            <div class="row">

                <div class="col-4 text-muted text-sm">
                    <span class="fa fa-microchip"></span>
                    <span>CPU</span>
                </div>

                <div class="col-4 text-muted text-sm">
                    <span class="fa fa-memory"></span>
                    <span>RAM</span>
                </div>

                <div class="col-4 text-muted text-sm">
                    <span class="fa fa-hdd"></span>
                    <span>DISK</span>
                </div>

            </div>

            <div class="row">

                <div class="col-4">
                    <div class="progress-group">
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-<%= kpi?.data?.cpu?.color %>" data-widget="cpu" style="width: <%= kpi?.data?.cpu?.value %>%"></div>
                        </div>
                    </div>
                </div>

                <div class="col-4">
                    <div class="progress-group">
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-<%= kpi?.data?.memory?.color %>" data-widget="memory" style="width: <%= kpi?.data?.memory?.value %>%"></div>
                        </div>
                    </div>
                </div>

                <div class="col-4">
                    <div class="progress-group">
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-<%= kpi?.data?.disk?.color %>" data-widget="storage" style="width: <%= kpi?.data?.disk?.value %>%"></div>
                        </div>
                    </div>
                </div>

            </div>

            <% if(kpi.hasUsers) { %>
                <div id="station-chart-<%= kpi.id %>" style="width: 100%; height: 40px;"></div>
                <div id="users-chart-<%= kpi.id %>" style="width: 100%; height: 40px;"></div>
            <% } else { %>
                <div class="d-flex flex-wrap pt-1 pb-1">
                    <div id="station-chart-<%= kpi.id %>" style="width: 100%; height: 90px;"></div>
                </div>
            <% } %>

        </div>
    </div>
</div>