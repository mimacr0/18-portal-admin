<section class="content section-page-screen page-screen-<%= screen.num %> <%= screen.hidden ? 'init-hidden' : '' %>" data-screen="<%= screen.num %>">
         ##<% if (screen.hidden) { %>
         <div class="row">

            <div class="offset-md-4 col-md-4 mb-4 text-center">
               <% if (screen.image) { %>
                  <div class="flex-grow-1 pl-3">
                     <div>
                        <img src="" class="rounded-circle mr-1 messages-messages-active-chat-image" alt="Avatar" width="40"
                           height="40">
                     </div>
                     <strong class="messages-messages-active-chat-name"
                        style="font-size: 1.2em; font-weight: bold"></strong>
                     <div class="text-muted small"><em class="messages-messages-active-chat-label"></em></div>
                     <span
                        class="btn btn-sm btn-primary mt-2 messages-messages-screen-action-back-button display-page-screen-action"
                        data-screen="1">
                        <i class="fa fa-arrow-left"></i> <%= page.translate('Go back') %>
                     </span>
                  </div>
                  <% } else { %>
                     <div class="offset-md-4 col-md-4 mb-4 text-center">
                        <strong style="font-size: 1.4em; font-weight: bold"><%= page.translate(screen.title) %></strong>
                        <br />
                        <span class="btn btn-sm btn-primary mt-2 display-page-screen-action" data-screen="1">
                           <i class="fa fa-arrow-left"></i> <%= page.translate('Go back') %>
                        </span>
                     </div>
                  <% } %>
            </div>

         </div>
         ##<% } %>
         <div class="row">
         ##<% for( const section of screen.sections ) { %>
            <div class="<%= section.class %> page-card-section-<%= section.num %>">
               <% for( const card of section.cards ) { %>
                  <%- await include(`./${card.html}/index`, { page, screen, section, card }) %>
               <% } %>
            </div>
         ##<% } %>
         </div>
      </section>