##<% let listActions = card.actions.list %>
##<% if(card.actions.update) listActions.push(card.actions.update) %>
##<% if(card.actions.delete) listActions.push(card.actions.delete) %>
##<% let count = 0 %>
##<% for( const item of items ) { %>
##<% count++ %>
<tr <%- item.attrs %>>
   <% if(card.actions.batch.length > 0) { %>
   <td style="width: 60px;">
      <div class="icheck-primary bot-bot-checkbox">
         <input type="checkbox" value="<%= item.id %>" id="check<%= count %>">
         <label for="check<%= count %>"></label>
      </div>
   </td>
   <% } %>
   <% for( const column of card.columns ) { %>
   <td><%- item[column.value] %></td>
   <% } %>
   <td class="text-right">
      <span class="dropdown">
         <button class="btn btn-tool btn-sm dropdown-toggle" type="button" id="dropdownMenuButton"
            data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <i class="fa fa-ellipsis-v"></i>
         </button>
         <div class="dropdown-menu bot-bot-list-actions" aria-labelledby="dropdownMenuButton">
            <strong class="dropdown-item btn btn-tool btn-sm" style="font-weight: bold;">
               <%= item.name %>
            </strong>
            <div class="dropdown-divider"></div>
            <% for( const action of item.listActions(listActions) ) { %>
            <%- await include(`actions/list/${action.html}`, { card, action, item }) %>
            <% } %>
         </div>
      </span>
   </td>
</tr>
##<% } %>