<div class="row">
    <div class="col-sm-12 col-md-5">
       <% if(firstResult > 0) { %>
       <div><%= firstResult %> - <%= lastResult %> / <%= total %></div>
       <% } %>
      </div>
    <div class="col-sm-12 col-md-7">
       <div>
          <% if(firstResult > 0) { %>
          <ul class="pagination pagination-sm m-0 float-right" style="cursor: pointer;">
             <li class="page-item <% if (currentPage === 1) { %>disabled<% } %>" data-page="<%= currentPage !== 1 ? currentPage - 1 : '' %>"><span class="page-link">«</span></li>
             <% for (let i = startPage; i <= endPage; i++) { %>
             <li class="page-item <% if (i === currentPage) { %>active<% } %>" data-page="<%= i %>"><span class="page-link"><%= i %></span></li>
             <% } %>
             <li class="page-item <% if (currentPage === totalPages) { %>disabled<% } %>" data-page="<%= currentPage !== totalPages ? currentPage + 1 : '' %>"><span class="page-link">»</span></li>
           </ul>
           <% } %>
       </div>
    </div>
</div>
