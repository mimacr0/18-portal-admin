<div class="card">

    <div class="card-header">
       <h3 class="card-title"><span class="text-muted"><%= page.translate(card.title) %></span></h3>
       <div class="card-tools <%= card.id.id %>-card-tools">
          ##<% for( const action of card.actions.tools) { %>
          <%- await include('../../list/html/actions/index', { card, action }) %>
          ##<% } %>
          <button class="btn btn-tool" data-card-widget="collapse" type="button" data-toggle="tooltip" title="Replegar/desplegar panel">
             <i class="fas fa-minus"></i>
          </button>
       </div>
    </div>

    <div class="card-body p-0">
       <div class="mailbox-controls">
          <div class="row">
             <div class="col-6">
               <% if(card.actions.crud.create) { %>
               <button type="button" class="btn btn-default btn-sm <%= card.id.id %>-create-button" data-toggle="tooltip" data-placement="right" data title="<%= page.translate('Create new record') %>">
                  <i class="fas fa-plus"></i>
               </button>
               <% } %>
            </div>
             <div class="col-6">
                <div>
                   <div class="input-group input-group-sm float-right">
                      <input type="text" name="table_search" class="form-control float-right" placeholder="Search" id="<%= card.id.id %>-search-input">
                         <div class="input-group-append">
                            <button type="submit" class="btn btn-default">
                               <i class="fas fa-search"></i>
                            </button>
                         </div>
                   </div>
                </div>
             </div>
          </div>
       </div>
       <div class="table-responsive mailbox-messages <%= card.id.id %>-main-container">
          <ul class="nav nav-pills flex-column" id="<%= card.id.id %>-list" style="border-top: 1px solid rgba(0, 0, 0, .125);"></ul>
       </div>
    </div>

    <div class="card-footer clearfix" id="<%= card.id.id %>-footer"></div>

 </div>