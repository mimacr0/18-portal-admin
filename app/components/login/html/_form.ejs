<form action="#" method="post">
    <div class="form-group input-group mb-3">
       <input type="text" name="username" class="form-control" placeholder="Usuario" required="1" autocomplete="0"/>
       <div class="input-group-append">
          <div class="input-group-text">
             <span class="fas fa-user"></span>
          </div>
       </div>
       <div class="invalid-feedback">
          Campo requerido
       </div>
    </div>
    <div class="form-group input-group mb-3">
       <input type="password" name="password" class="form-control" placeholder="Contraseña" required="1" autocomplete="0"/>
       <div class="input-group-append">
          <div class="input-group-text">
             <span class="fas fa-lock"></span>
          </div>
       </div>
       <div class="invalid-feedback">
          Campo requerido
       </div>
    </div>
    <div class="row">
       <div class="col-12 text-center">
          <button type="button" class="btn btn-primary btn-block login-button">Iniciar</button>
       </div>
    </div>
 </form>