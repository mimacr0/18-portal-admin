<div id="<%= field.id %>-group" class="form-group">
    ##<% if (field.label) { %>
    <label for="<%= field.id %>"><%= field.card.page.translate(field.label) %></label>
    ##<% } %>
    <div class="select2-primary">
        <select class="form-control" id="<%= field.id %>" name="<%= field.name %>" placeholder="<%= field.card.page.translate(field.placeholder) %>">
        </select>
        ##<% if (field.required) { %>
            <div class="invalid-feedback"><%= field.card.page.translate('Required field') %></div>
        ##<% } %>
    </div>
</div>
