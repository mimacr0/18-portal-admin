            <!-- Products Content -->
            <div class="flex flex-col md:flex-row">

                <!-- Products Grid -->
                <div id="products-grid" class="w-full grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3">

                    <!-- Product Card 1 -->
                    <div t-foreach="products" t-as="product" t-key="product.id" class="bg-[#232f45] rounded-md shadow-sm overflow-hidden product-card hover:shadow transition-all duration-300" t-att-data-product-id="product.id">
                        <div class="p-3 relative">
                            <button class="absolute right-2 top-2 star-btn text-gray-400 hover:text-yellow-400 transition-colors">
                                <i class="far fa-star"></i>
                            </button>

                            <div class="text-center mb-2">
                                <h3 class="text-sm font-medium text-white truncate" t-field="product.name"/>
