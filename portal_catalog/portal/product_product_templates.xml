                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fas fa-search text-gray-400"></i>
                    </div>
                </div>
            </div>

            <!-- Selected products preview -->
            <div id="selected-products-container" class="mb-4 bg-white dark:bg-gray-800 rounded-md shadow overflow-hidden text-sm">
                <div class="content-gradient px-3 py-2">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <i class="fas fa-shopping-cart text-white text-xs mr-2"></i>
                            <h2 class="text-sm font-semibold text-white">Products Selected</h2>
                            <span id="selected-count" class="ml-2 bg-white text-primary-theme dark:bg-gray-700  text-xs font-bold px-2 py-0.5 rounded-full">0</span>
                        </div>
                        <div>
                            <button id="clear-selection" class="text-white hover:text-gray-200 transition-colors text-xs">
                                <i class="fas fa-trash-alt mr-1"></i> Clear
                            </button>
                        </div>
                    </div>
                </div>

                <div id="no-products-message" class="p-3 text-center text-xs">
                    <i class="fas fa-box-open text-gray-400 dark:text-gray-500 text-lg mb-1"></i>
                    <p class="text-gray-500 dark:text-gray-400">No products selected</p>
                    <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">Add products using the "Add" button</p>
                </div>

                <div id="selected-products-list" class="hidden max-h-64 overflow-y-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 p-2">
                    <!-- Selected products will be added here dynamically -->
                </div>

                <div id="selected-products-summary" class="hidden p-3 bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700 text-xs">
                    <div class="flex justify-between items-center mb-1">
                        <span class="text-gray-600 dark:text-gray-300">Subtotal:</span>
                        <span id="subtotal" class="font-medium text-gray-800 dark:text-white">0,00 €</span>
                    </div>
                    <div class="flex justify-between items-center mb-2">
                        <span class="text-gray-600 dark:text-gray-300">IVA (21%):</span>
                        <span id="tax" class="font-medium text-gray-800 dark:text-white">0,00 €</span>
                    </div>
                    <div class="flex justify-between items-center pt-1 border-t border-gray-200 dark:border-gray-700">
                        <span class="font-semibold text-gray-800 dark:text-white">Total:</span>
                        <span id="total" class="font-bold text-primary-theme ">0,00 €</span>
                    </div>
                    <div class="mt-2">
                        <button id="checkout-button" class="w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white text-xs font-medium py-1.5 px-3 rounded transition-colors shadow-sm flex items-center justify-center">
                            <i class="fas fa-check-circle mr-1"></i> Complete Budget
                        </button>
                    </div>
                </div>
