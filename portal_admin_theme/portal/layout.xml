                                            t-att-data-history-url="item.get('url')"
                                            t-att-data-history-title="item.get('name')"
                                            t-att-data-history-icon="item.get('icon')"
                                            >
                                            <i t-attf-class="#{item.get('icon')} size-5 mr-3 text-center opacity-80 group-hover:opacity-100"></i>
                                            <span class="menu-text transition-all duration-300" t-out="item.get('name')"/>
                                        </a>
                                        <a
                                            t-else=""
                                            t-att-href="item.get('url')"
                                            class="menu-item group relative transition-all duration-300 text-white/90 hover:text-white flex items-center px-4 py-3 mx-2 my-1 rounded-lg hover:bg-white/10 hover:backdrop-blur-sm hover:translate-x-1"
                                            t-att-data-history-url="item.get('url')"
                                            t-att-data-history-title="item.get('name')"
                                            t-att-data-history-icon="item.get('icon')"
                                            >
                                            <i t-attf-class="#{item.get('icon')} size-5 mr-3 text-center opacity-80 group-hover:opacity-100"></i>
                                            <span class="menu-text transition-all duration-300" t-out="item.get('name')"/>
                                        </a>
                                    </t>
                                </div>
                            </nav>
                        </div>
                    </aside>

                    <!-- Content overlay -->
                    <div class="content-overlay"></div>

                    <!-- Main Content -->
                    <main id="main-content" class="flex-1 p-6 overflow-auto transition-all duration-500 ml-0 w-full h-screen">
                        <t t-out="0"/>
                    </main>

                    <t t-out="footer_content"/>

                    <!-- Loading Screen -->
                    <div id="loading-screen" class="hidden">
                        <div class="loading-content">
                            <div class="loading-spinner"></div>
                            <p class="loading-text">Loading</p>
                        </div>
                    </div>
                </div>

