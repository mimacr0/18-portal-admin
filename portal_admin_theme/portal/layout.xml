<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_user_notification_list" name="Portal User Notification List">
        <t t-foreach="notifications" t-as="notification">
            <div class="px-4 py-3 border-l-4 border-primary-theme notification-item">
                <div class="flex items-start">
                    <div class="flex-shrink-0 pt-0.5">
                        <i t-attf-class="fas fa-#{notification.icon()} text-primary-theme bg-light-active p-2 rounded-full notification-icon info"></i>
                    </div>
                    <div class="ml-3 w-0 flex-1">
                        <p class="text-sm font-sm text-gray-900 dark:text-white notification-title"><t t-out="notification.title()"/></p>
                        <p class="text-xs text-gray-500 dark:text-gray-400 notification-message"><t t-out="notification.message()"/></p>
                        <p class="text-xs text-gray-400 dark:text-gray-500 mt-1 notification-time"><t t-out="notification.time_ago()"/></p>
                    </div>
                    <div class="ml-4 flex-shrink-0">
                        <button class="text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-400 notification-remove-button" t-att-data-notification-id="notification.id">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_admin_layout" name="Portal Admin Layout">
        <head>
            <meta charset="UTF-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <title><t t-out="page_title"/></title>
            <!-- Theme CSS Variables -->
            <style>
                :root {
                    --base-color: <t t-out="base_color or '#696900'"/>;
                    --hover-color: <t t-out="hover_color or '#8A8A00'"/>;
                    --light-bg-color: <t t-out="light_bg_color or '#f0f0e0'"/>;
                    --dark-base-color: <t t-out="dark_base_color or '#A0A000'"/>;
                    --dark-hover-color: <t t-out="dark_hover_color or '#C0C000'"/>;
                    --dark-light-bg-color: <t t-out="dark_light_bg_color or '#3a3a1a'"/>;
                }
                /* Buttons */
                .btn-primary { background-color: var(--base-color); }
                .btn-primary:hover { background-color: var(--hover-color); }
                .dark .btn-primary { background-color: var(--dark-base-color); }
                .dark .btn-primary:hover { background-color: var(--dark-hover-color); }
                /* Text */
                .text-primary-theme { color: var(--base-color); }
                .text-primary-theme:hover { color: var(--hover-color); }
                .dark .text-primary-theme { color: var(--dark-base-color); }
                .dark .text-primary-theme:hover { color: var(--dark-hover-color); }
                /* Borders */
                .border-primary-theme { border-color: var(--base-color); }
                .dark .border-primary-theme { border-color: var(--dark-base-color); }
                /* Backgrounds */
                .bg-primary-theme { background-color: var(--base-color); }
                .dark .bg-primary-theme { background-color: var(--dark-base-color); }
                .bg-light-active { background-color: var(--light-bg-color); }
                .dark .bg-light-active { background-color: var(--dark-light-bg-color); }
                /* Form inputs */
                .focus-ring-theme:focus { 
                    --tw-ring-color: var(--hover-color);
                    outline: none;
                    box-shadow: 0 0 0 1px var(--hover-color);
                }
                /* Radio/Checkbox accent */
                .accent-theme { accent-color: var(--hover-color); }
                /* Icons */
                .icon-primary-theme { color: var(--base-color); }
                .dark .icon-primary-theme { color: var(--dark-base-color); }
                /* Gradients */
                .sidebar-gradient {
                    background: linear-gradient(to bottom right, var(--hover-color), var(--base-color));
                }
                .dark .sidebar-gradient {
                    background: linear-gradient(to bottom right, #374151, #1f2937);
                }
                .menu-active-gradient {
                    background: linear-gradient(to right, var(--hover-color), var(--base-color));
                }
                .dark .menu-active-gradient {
                    background: linear-gradient(to right, var(--dark-hover-color), var(--dark-base-color));
                }
                /* Content gradients */
                .content-gradient {
                    background: linear-gradient(to right, var(--base-color), var(--hover-color)) !important;
                }
                html.dark .content-gradient {
                    background: linear-gradient(to right, var(--dark-base-color), var(--dark-hover-color)) !important;
                }
                /* Dark mode utilities (Tailwind v4 fix) */
                html.dark .dark\:bg-gray-700\/50 { background-color: rgb(55 65 81 / 0.5) !important; }
                html.dark .dark\:bg-gray-800 { background-color: #1f2937 !important; }
                html.dark .dark\:bg-gray-900 { background-color: #111827 !important; }
                html.dark .dark\:bg-gray-900\/30 { background-color: rgb(17 24 39 / 0.3) !important; }
                html.dark .dark\:bg-green-900\/30 { background-color: rgb(20 83 45 / 0.3) !important; }
                html.dark .dark\:bg-amber-900\/30 { background-color: rgb(120 53 15 / 0.3) !important; }
                html.dark .dark\:bg-purple-900\/30 { background-color: rgb(88 28 135 / 0.3) !important; }
                html.dark .dark\:bg-blue-900\/30 { background-color: rgb(30 58 138 / 0.3) !important; }
                html.dark .dark\:bg-red-900\/30 { background-color: rgb(127 29 29 / 0.3) !important; }
                html.dark .dark\:text-white { color: #ffffff !important; }
                html.dark .dark\:text-gray-400 { color: #9ca3af !important; }
                html.dark .dark\:text-gray-300 { color: #d1d5db !important; }
                html.dark .dark\:text-green-400 { color: #4ade80 !important; }
                html.dark .dark\:text-amber-400 { color: #fbbf24 !important; }
                html.dark .dark\:text-purple-400 { color: #c084fc !important; }
                html.dark .dark\:text-cyan-400 { color: #22d3ee !important; }
                html.dark .dark\:border-gray-700 { border-color: #374151 !important; }
                /* History widget items */
                .history-item-active {
                    background-color: var(--base-color);
                    color: white;
                }
                .history-item-active:hover {
                    background-color: var(--hover-color);
                }
                .dark .history-item-active {
                    background-color: var(--dark-base-color);
                }
                .dark .history-item-active:hover {
                    background-color: var(--dark-hover-color);
                }
                .history-item-inactive:hover {
                    color: var(--base-color);
                }
                .dark .history-item-inactive:hover {
                    color: var(--dark-hover-color);
                }
                /* Modal buttons */
                .modal-btn {
                    padding: 0.5rem 1rem;
                    border-radius: 0.375rem;
                    font-size: 0.875rem;
                    font-weight: 500;
                    transition: all 0.15s ease;
                    display: inline-flex;
                    align-items: center;
                    gap: 0.375rem;
                }
                .modal-btn-primary {
                    background-color: var(--base-color) !important;
                    background-image: none !important;
                    color: white !important;
                }
                .modal-btn-primary:hover {
                    background-color: var(--hover-color) !important;
                }
                .dark .modal-btn-primary {
                    background-color: var(--dark-base-color) !important;
                }
                .dark .modal-btn-primary:hover {
                    background-color: var(--dark-hover-color) !important;
                }
                .modal-btn-secondary {
                    background-color: #e5e7eb;
                    color: #374151;
                }
                .modal-btn-secondary:hover {
                    background-color: #d1d5db;
                }
                .dark .modal-btn-secondary {
                    background-color: #374151;
                    color: #e5e7eb;
                }
                .dark .modal-btn-secondary:hover {
                    background-color: #4b5563;
                }
            </style>
            <t t-call-assets="web._assets_core" t-css="false" defer_load="True"/>
            <t t-call-assets="portal_admin_theme.admin_assets_frontend" defer_load="True"/>
            <script t-nocache="Session information should always be up to date." type="text/javascript">
                document.addEventListener('DOMContentLoaded', () => {
                    odoo.__session_info__ = <t t-out="json.dumps(request.env['ir.http'].get_frontend_session_info())"/>;
                    if (!/(^|;\s)tz=/.test(document.cookie)) {
                        const userTZ = Intl.DateTimeFormat().resolvedOptions().timeZone;
                        document.cookie = `tz=${userTZ}; path=/`;
                    }
                });
            </script>
            <t t-if="page_type == 'account'">
                <t t-call-assets="portal_admin_theme.account_page"/>
            </t>
            <t t-if="not page_type">
                <t t-call-assets="portal_admin_theme.admin_page"/>
            </t>
            <t t-if="select2">
                <!-- Select2 for advanced select boxes -->
                <link href="/portal_admin_theme/static/src/vendor/select2/css/select2.min.css" rel="stylesheet" />
                <script src="/portal_admin_theme/static/src/vendor/jquery/js/jquery.min.js"></script>
                <script src="/portal_admin_theme/static/src/vendor/select2/js/select2.min.js"></script>
            </t>
            <t t-if="flatpickr">
                <!-- Flatpickr for date pickers -->
                <link href="/portal_admin_theme/static/src/vendor/flatpickr/css/flatpickr.min.css" rel="stylesheet" />
                <script src="/portal_admin_theme/static/src/vendor/flatpickr/js/flatpickr.min.js"></script>
            </t>
            <t t-if="apexcharts">
                <!-- ApexCharts -->
                <script src="/portal_admin_theme/static/src/vendor/apexcharts/apexcharts.min.js"></script>
            </t>
        </head>
        <body class="bg-gray-100 dark:bg-gray-900">
            <div class="page-container">
                <!-- Header -->
                <header class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 sticky top-0 z-50">
                    <div class="grid grid-cols-2 items-center px-4 py-3">
                        <!-- Left section with sidebar toggle -->
                        <div class="flex items-center justify-start">
                            <button id="sidebar-toggle" class="size-10 rounded-md flex items-center justify-center hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none relative" data-sidebar-state="full">
                                <!-- Full sidebar icon (default) -->
                                <svg id="toggle-full-icon" class="size-5 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-slot="icon">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                                </svg>
                                <!-- Collapsed sidebar icon (hidden by default) -->
                                <svg id="toggle-collapsed-icon" class="size-5 text-gray-600 dark:text-gray-300 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-slot="icon">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path>
                                </svg>
                            </button>

                            <!-- History Widget (desktop only) -->
                            <div id="history-widget" class="history-widget hidden sm:flex"></div>
                        </div>

                        <!-- Right section with buttons -->
                        <div class="flex items-center gap-2 justify-end">
                            <!-- Theme toggle button -->
                             <div class="relative">
                                <button id="theme-toggle-button" class="flex items-center justify-center size-10 rounded-md hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none">
                                    <!-- Light mode icon (default visible) -->
                                    <img id="light-theme-icon" src="/portal_admin_theme/static/img/icons/sun.svg" class="w-5 h-5" alt="Light mode"/>
                                    <!-- Dark mode icon (hidden by default) -->
                                    <img id="dark-theme-icon" src="/portal_admin_theme/static/img/icons/moon.svg" class="w-5 h-5 hidden" alt="Dark mode"/>
                                </button>
                             </div>
                          

                            <!-- Language selector dropdown -->
                            <div class="relative">
                                <button id="language-dropdown-button" class="flex items-center justify-center size-10 rounded-md focus:outline-none transition-colors">
                                    <img t-if="user.lang == 'en_US'" src="/portal_admin_theme/static/img/flags/en.svg" class="rounded-md w-5 h-5" alt="English"/>
                                    <img t-if="user.lang == 'es_ES'" src="/portal_admin_theme/static/img/flags/es.svg" class="rounded-md w-5 h-5" alt="Spanish"/>
                                    <img t-if="user.lang == 'zh_CN'" src="/portal_admin_theme/static/img/flags/zh.svg" class="rounded-md w-5 h-5" alt="Chinese"/>
                                </button>
                                <!-- Language dropdown menu -->
                                <div id="language-dropdown" class="hidden absolute right-0 mt-2 w-48 bg-white dark:bg-gray-800 rounded-md shadow-lg py-1 z-50 border border-gray-200 dark:border-gray-700">
                                    <div class="px-4 py-2 border-b border-gray-100 dark:border-gray-700">
                                        <p class="text-sm font-sm text-gray-700 dark:text-gray-300">Select Language</p>
                                    </div>
                                    <div class="max-h-60 overflow-y-auto">
                                        <!-- Current language -->
                                        <a href="/account/user/update/lang/en_US" t-attf-class="language-item flex items-center px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 #{user.lang == 'en_US' and 'bg-gray-50 dark:bg-gray-800'}">
                                            <img src="/portal_admin_theme/static/img/flags/en.svg" class="rounded-md w-5 mr-3" alt="English"/>
                                            <span>English</span>
                                            <i t-if="user.lang == 'en_US'" class="fas fa-check ml-auto text-primary-theme"></i>
                                        </a>
                                        <!-- Other languages -->
                                        <a href="/account/user/update/lang/es_ES" t-attf-class="language-item flex items-center px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 #{user.lang == 'es_ES' and 'bg-gray-50 dark:bg-gray-800'}">
                                            <img src="/portal_admin_theme/static/img/flags/es.svg" class="rounded-md w-5 mr-3" alt="Spanish"/>
                                            <span>Español</span>
                                            <i t-if="user.lang == 'es_ES'" class="fas fa-check ml-auto text-primary-theme"></i>
                                        </a>
                                        <a href="/account/user/update/lang/zh_CN" t-attf-class="language-item flex items-center px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 #{user.lang == 'zh_CN' and 'bg-gray-50 dark:bg-gray-800'}">
                                            <img src="/portal_admin_theme/static/img/flags/zh.svg" class="rounded-md w-5 mr-3" alt="Chinese"/>
                                            <span>中文</span>
                                            <i t-if="user.lang == 'zh_CN'" class="fas fa-check ml-auto text-primary-theme"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Notification dropdown -->
                            <div class="relative">
                                <button id="notification-dropdown-button" class="flex items-center justify-center size-10 rounded-md hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none relative">
                                    <i class="fas fa-bell text-[#4b5563] dark:text-[#d1d5db]"></i>
                                    <span class="notification-badge absolute top-2 right-2 flex h-3 w-3 pointer-events-none">
                                        <!-- Using class from notifications.css for the effect -->
                                        <span class="notification-indicator-animated invisible" id="layout-notifications-indicator"></span>
                                    </span>
                                </button>
                                <!-- Notification dropdown menu -->
                                <div id="notification-dropdown" class="hidden absolute right-0 mt-2 w-80 bg-white dark:bg-gray-800 rounded-md shadow-lg py-1 z-50">
                                    <div class="px-4 py-2 border-b border-gray-100 dark:border-gray-700 flex justify-between items-center">
                                        <p class="text-sm font-sm text-gray-700 dark:text-gray-300" id="layout-notifications-title"></p>
                                        <span class="text-xs bg-red-500 text-white px-2 py-1 rounded-full hidden" id="layout-notifications-count-badge"></span>
                                    </div>
                                    <div class="max-h-96 overflow-y-auto" id="layout-notifications-list"></div>
                                    <div class="border-t border-gray-100 dark:border-gray-700 p-2 hidden flex justify-center" id="layout-notifications-actions">
                                        <button type="button" class="text-xs text-primary-theme font-sm" id="layout-clear-all-notifications-button">
                                            Clear all notifications
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- History dropdown (mobile only) -->
                            <div class="relative history-mobile-only">
                                <button id="history-dropdown-button" class="flex items-center justify-center size-10 rounded-md hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none lg:hidden md:hidden">
                                    <i class="fas fa-history text-gray-600 dark:text-gray-300"></i>
                                </button>
                                <!-- History dropdown menu -->
                                <div id="history-dropdown" class="hidden absolute right-0 mt-2 w-64 bg-white dark:bg-gray-800 rounded-md shadow-lg py-1 z-50 lg:hidden md:hidden">
                                    <div class="px-4 py-2 border-b border-gray-100 dark:border-gray-700 flex justify-between items-center">
                                        <p class="text-sm font-medium text-gray-700 dark:text-gray-300">Recent Pages</p>
                                        <div class="history-dropdown-actions">
                                            <button id="clear-history" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div id="history-list" class="max-h-60 overflow-y-auto">
                                        <!-- History items will be populated here dynamically -->
                                    </div>
                                    <div class="border-t border-gray-100 dark:border-gray-700 p-2">
                                        <a href="#" class="block text-center text-xs text-primary-theme font-medium">
                                            View all history
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- User dropdown -->
                            <div class="relative">
                                <button id="user-dropdown-button" class="flex items-center justify-center size-10 rounded-full bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 focus:outline-none">
                                    <img t-if="user.partner_id.image_128" class="rounded-full" t-attf-src="/web/image/res.partner/#{user.partner_id.id}/image_128/30x30"/>
                                    <svg t-else="" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 212 212" class="size-6" preserveAspectRatio="xMidYMid meet" id="default-user" version="1.1" x="0px" y="0px" enable-background="new 0 0 212 212"><title>default-user</title><path fill="#DFE5E7" class="background" d="M106.251,0.5C164.653,0.5,212,47.846,212,106.25S164.653,212,106.25,212C47.846,212,0.5,164.654,0.5,106.25 S47.846,0.5,106.251,0.5z"/><g><path fill="#FFFFFF" class="primary" d="M173.561,171.615c-0.601-0.915-1.287-1.907-2.065-2.955c-0.777-1.049-1.645-2.155-2.608-3.299 c-0.964-1.144-2.024-2.326-3.184-3.527c-1.741-1.802-3.71-3.646-5.924-5.47c-2.952-2.431-6.339-4.824-10.204-7.026 c-1.877-1.07-3.873-2.092-5.98-3.055c-0.062-0.028-0.118-0.059-0.18-0.087c-9.792-4.44-22.106-7.529-37.416-7.529 s-27.624,3.089-37.416,7.529c-0.338,0.153-0.653,0.318-0.985,0.474c-1.431,0.674-2.806,1.376-4.128,2.101 c-0.716,0.393-1.417,0.792-2.101,1.197c-3.421,2.027-6.475,4.191-9.15,6.395c-2.213,1.823-4.182,3.668-5.924,5.47 c-1.161,1.201-2.22,2.384-3.184,3.527c-0.964,1.144-1.832,2.25-2.609,3.299c-0.778,1.049-1.464,2.04-2.065,2.955 c-0.557,0.848-1.033,1.622-1.447,2.324c-0.033,0.056-0.073,0.119-0.104,0.174c-0.435,0.744-0.79,1.392-1.07,1.926 c-0.559,1.068-0.818,1.678-0.818,1.678v0.398c18.285,17.927,43.322,28.985,70.945,28.985c27.678,0,52.761-11.103,71.055-29.095 v-0.289c0,0-0.619-1.45-1.992-3.778C174.594,173.238,174.117,172.463,173.561,171.615z"/><path fill="#FFFFFF" class="primary" d="M106.002,125.5c2.645,0,5.212-0.253,7.68-0.737c1.234-0.242,2.443-0.542,3.624-0.896 c1.772-0.532,3.482-1.188,5.12-1.958c2.184-1.027,4.242-2.258,6.15-3.67c2.863-2.119,5.39-4.646,7.509-7.509 c0.706-0.954,1.367-1.945,1.98-2.971c0.919-1.539,1.729-3.155,2.422-4.84c0.462-1.123,0.872-2.277,1.226-3.458 c0.177-0.591,0.341-1.188,0.49-1.792c0.299-1.208,0.542-2.443,0.725-3.701c0.275-1.887,0.417-3.827,0.417-5.811 c0-1.984-0.142-3.925-0.417-5.811c-0.184-1.258-0.426-2.493-0.725-3.701c-0.15-0.604-0.313-1.202-0.49-1.793 c-0.354-1.181-