<?xml version="1.0" encoding="utf-8"?>
<odoo> 
    <template id="portal_expedition_details_page" name="Portal Sale Details Page">
        <t t-call="portal_admin_theme.portal_admin_layout">

            <div id="expedition-details-container" class="mt-6">
               <div class="w-4/5 mx-auto lg:max-w-7xl bg-white dark:bg-gray-800 rounded-xl shadow-lg print:shadow-none border border-gray-100 dark:border-gray-700 overflow-hidden">
                    <!-- Document Action Bar -->
                    <div class="p-5 flex justify-between items-center border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800">
                        <a href="/account/expedition" class="inline-flex items-center text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 transition-colors">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                            </svg>
                            Go back
                        </a>
                        <!-- Section to add actions -->
                    <div class="flex items-center space-x-4">
                        <div class="document-actions flex space-x-4">
                            <div class="flex space-x-2 text-gray-900 dark:text-white ">
                                <span>Print</span>
                            </div>
                            <div class="flex space-x-2 text-gray-900 dark:text-white ">
                                <span>Print Barcode</span>
                            </div>
                            <div class="flex space-x-2 text-gray-900 dark:text-white ">
                                <span>Edit</span>
                            </div>
                        </div>
                    </div>

                    </div>

                    <div class="p-8 border-b border-gray-200 dark:border-gray-700 relative">
                        <div class="flex flex-col md:flex-row justify-between items-start relative z-10">
                            <div>
                                <div class="flex items-center p-8">
                                    <h1 class="text-3xl font-extrabold text-gray-900 dark:text-white">Sale <t t-esc="order.name"/> Information</h1>
                                    <span class="ml-4 text-xl font-medium text-blue-600 dark:text-blue-400"/>
                                    <br/>
                                </div>
                                <div class="flex items-center p-8">
                                    <span class="text-gray-500 dark:text-gray-400">Client Order Reference: <t t-esc="order.client_order_ref"/></span>

                                </div>
                            </div>
                            <div class="flex items-center space-x-4">
                                <div class="expedition-status-information relative">
                                    <span class="px-3 py-1.5 bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-gray-100 text-xs font-medium rounded-full flex items-center">
                                        <span class="w-2 h-2 bg-amber-500 rounded-full mr-1.5"></span>
                                        Draft
                                    </span>
                                </div>
                            </div>  
                        </div>
                    </div>

                    <div class="p-8 grid grid-cols-1 md:grid-cols-2 border-b border-gray-200 dark:border-gray-700 relative ">
                        <!-- Shipping Address -->
                        <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-sm border border-gray-100 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <h3 class="text-lg font-medium mb-4 text-gray-900 dark:text-white flex items-center">
                                <i class="fas fa-shipping-fast mr-2 text-blue-600 dark:text-blue-400"></i>
                                Ship To
                            </h3>
                            <div class="text-sm space-y-2 dark:text-gray-300">
                                <p><t t-esc="order.partner_shipping_id.name"/></p>
                                <p><t t-esc="order.partner_shipping_id.street"/>, <t t-esc="order.partner_shipping_id.street2"/> </p>
                                <p><t t-esc="order.partner_shipping_id.city"/>, <t t-esc="order.partner_shipping_id.state_id.name"/></p>
                                <p><t t-esc="order.partner_shipping_id.zip"/></p>
                                <p><t t-esc="order.partner_shipping_id.country_id.name"/></p>
                            </div>
                        </div>
                        <!-- Billing Address -->
                        <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-sm border border-gray-100 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                            <h3 class="text-lg font-medium mb-4 text-gray-900 dark:text-white flex items-center">
                                <i class="fas fa-file-sale-dollar mr-2 text-blue-600 dark:text-blue-400"></i>
                                Bill To
                            </h3>
                            <div class="text-sm space-y-2 dark:text-gray-300">
                                <p><t t-esc="order.partner_invoice_id.name"/></p>
                                <p><t t-esc="order.partner_invoice_id.street"/>, <t t-esc="order.partner_invoice_id.street2"/> </p>
                                <p><t t-esc="order.partner_invoice_id.city"/>, <t t-esc="order.partner_invoice_id.state_id.name"/></p>
                                <p><t t-esc="order.partner_invoice_id.zip"/></p>
                                <p><t t-esc="order.partner_invoice_id.country_id.name"/></p>
                                <div class="mt-4 pt-3 border-t border-dashed border-gray-200 dark:border-gray-700">
                                    <p class="font-medium flex items-center">
                                        <i class="fas fa-user-tag mr-2 text-gray-500"></i>
                                        Customer ID: <t t-esc="order.partner_invoice_id.account"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Products Sold List -->
                    <div class="p-8 border-b border-gray-200 dark:border-gray-700">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-lg font-medium text-gray-900 dark:text-white flex items-center">
                                Products Sold List
                            </h3>
                        </div>
                        <div class="overflow-x-auto rounded-lg shadow">
                            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700" id="page-expedition-list-table">
                                <thead class="bg-gray-50 dark:bg-gray-600">
                                    <tr>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Name</th>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Quantity</th>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actual Location</th>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Price Unit</th>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Total Price</th>
                                    </tr>
                                </thead>

                                <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700" id="expedition-page-list-items">
                                    <t t-foreach="order.order_line" t-as="line">
                                        <tr class="hover:bg-gray-100 dark:hover:bg-gray-700">
                                            <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-gray-100 dark:hover:bg-gray-700"><t t-esc="line.product_id.name"/></td>
                                            <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-gray-100 dark:hover:bg-gray-700"><t t-esc="line.product_uom_qty"/></td>
                                            <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-gray-100 dark:hover:bg-gray-700"><!-- <t t-esc="line.location_final_id.name"/> --></td>
                                            <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-gray-100 dark:hover:bg-gray-700"><t t-out="line.price_unit"/></td>
                                            <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-gray-100 dark:hover:bg-gray-700"><t t-out="line.price_total"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    
                    <!-- Movement Table -->
                    <div class="p-8 border-b border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-lg font-medium text-gray-900 dark:text-white flex items-center">
                                Movement History
                            </h3>
                        </div>
                        <div class="overflow-x-auto rounded-lg shadow">
                                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700" id="page-expedition-list-table">
                                <thead class="bg-gray-50 dark:bg-gray-600">
                                    <tr>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Reference</th>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Origin Location</th>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Destination Location</th>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Scheduled Date</th>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Done Date</th>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Previous Movement</th>
                                    </tr>
                                </thead>

                                <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700" id="expedition-page-list-items">
                                    <t t-foreach="order.picking_ids" t-as="picking">
                                        <tr class="hover:bg-gray-100 dark:hover:bg-gray-700">
                                            <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-yellow-100 dark:hover:bg-yellow-100 hover:text-gray-800" >
                                                <t t-esc="picking.name"/>
                                            </td>
                                            <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-yellow-100 dark:hover:bg-yellow-100 hover:text-gray-800">
                                                <t t-esc="picking.location_id.name"/>
                                            </td>
                                            <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-yellow-100 dark:hover:bg-yellow-100 hover:text-gray-800">
                                                <t t-esc="picking.location_dest_id.name"/>
                                            </td>
                                            <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-yellow-100 dark:hover:bg-yellow-100 hover:text-gray-800">
                                                <t t-out="picking.scheduled_date"/>
                                            </td>
                                            <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-yellow-100 dark:hover:bg-yellow-100 hover:text-gray-800">
                                                <t t-out="picking.date_done"/>
                                            </td>
                                            <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-yellow-100 dark:hover:bg-yellow-100 hover:text-gray-800">
                                                <!-- Previous movement can be added here if needed -->
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tracking Information -->
                    <div class="p-8 border-b border-gray-200 dark:border-gray-700">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-lg font-medium text-gray-900 dark:text-white flex items-center">
                                Tracking Information
                            </h3>
                        </div>
                        <div class="overflow-x-auto rounded-lg shadow">
                            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700" id="page-expedition-list-table">
                                <thead class="bg-gray-50 dark:bg-gray-600">
                                    <tr>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                            Método de envío
                                        </th>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                            Shipping Weight
                                        </th>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                            Commitment Date (Fecha de entrega)
                                        </th>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                            Effective Date (Fecha efectiva)
                                        </th>
                                        <th scope="col" class="px-6 py-3 text-center font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                            Delivery Status (Estado de entrega)s
                                        </th>

                                    </tr>
                                </thead>

                                <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700" id="expedition-page-list-items">
                                    <tr class="hover:bg-gray-100 dark:hover:bg-gray-700">
                                        <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-gray-200 dark:hover:bg-gray-600">
                                            <t t-esc="order.carrier_id.name"/>
                                        </td>
                                        <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-gray-200 dark:hover:bg-gray-600">
                                            <t t-out="order.shipping_weight"/>
                                        </td>
                                        <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-gray-200 dark:hover:bg-gray-600">
                                            <t t-out="order.commitment_date"/>
                                        </td>
                                        <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-gray-200 dark:hover:bg-gray-600">
                                            <t t-out="order.effective_date"/>
                                        </td>
                                        <td class="px-6 py-4 text-center text-gray-800 dark:text-gray-200 font-medium hover:bg-gray-200 dark:hover:bg-gray-600">
                                            <t t-out="order.delivery_status"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Chatter -->
                    <div class="border-t border-gray-200 dark:border-gray-700">
                        <div class="p-5" id="communication-toggle">
                            <div class="flex items-center justify-between">
                                <h3 class="text-lg font-medium dark:text-white flex items-center">
                                    <i class="fas fa-comments mr-2 text-blue-600 dark:text-blue-400"></i>
                                    Communication history
                                </h3>
                            </div>
                        </div>

                        <div id="communication-content" class="p-6 pt-0">
                            <t t-set="partner" t-value="user"/>
                            <!-- Communication content wrapper -->
                            <div class="rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden flex flex-col">
                                <!-- Chat header -->
                                <div class="chat-header bg-gray-50 dark:bg-gray-700 border-b border-gray-200 dark:border-gray-600 p-4 flex justify-between items-center">
                                    <div class="flex items-center">
                                        <div class="w-8 h-8 bg-blue-500 dark:bg-blue-600 rounded-full flex items-center justify-center">
                                            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M2 5a2 2 0 012-2h7a2 2 0 012 2v4a2 2 0 01-2 2H9l-3 3v-3H4a2 2 0 01-2-2V5z"></path>
                                                <path d="M15 7v2a4 4 0 01-4 4H9.828l-1.766 1.767c.28.149.599.233.938.233h2l3 3v-3h2a2 2 0 002-2V9a2 2 0 00-2-2h-1z"></path>
                                            </svg>
                                        </div>
                                        <span class="ml-2 font-medium text-sm text-gray-700 dark:text-gray-200">Chat with <span t-out="partner.name"/></span>
                                    </div>
                                </div>

                                <!-- Messages container with increased height -->
                                <div class="space-y-4 h-[500px] overflow-y-auto p-4 messages-container bg-white dark:bg-gray-800" t-attf-id="#{page_name}-details-chat-messages" t-attf-data-order-id="#{order.id}"
                                    t-attf-data-partner-id="#{user.partner_id.id}" t-attf-data-token="#{order.access_token}"></div>

                                <!-- Message input area in separate container -->
                                <div class="message-composer bg-white dark:bg-gray-800 border-t border-gray-100 dark:border-gray-700 p-4">
                                    <div class="message-input-wrapper bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg shadow-sm dark:shadow-gray-900/50" id="message-input-container">
                                        <div class="flex items-end p-2">
                                            <div class="flex-shrink-0 mr-2">
                                                <div class="w-8 h-8 rounded-full bg-gray-500 dark:bg-gray-600 flex items-center justify-center">
                                                    <img t-if="user.partner_id.image_128" class="w-5 h-5 rounded-full" t-attf-src="/web/image/res.partner/#{user.partner_id.id}/image_128/50x50"/>
                                                    <svg t-else="" class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                                                    </svg>
                                                </div>
                                            </div>
                                            <div class="flex-grow relative">
                                                <div class="flex items-center">
                                                    <button class="message-attach-button text-gray-500 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 p-2">
                                                        <i class="fas fa-paperclip"></i>
                                                    </button>
                                                    <div class="flex-grow">
                                                        <input type="hidden" t-attf-id="page-details-expedition-message-attachment-token" t-att-value="request.csrf_token()"/>
                                                        <input type="file" t-attf-id="page-details-expedition-message-attachment-input" class="hidden"/>
                                                        <textarea class="message-input bg-transparent border-0 rounded-md text-gray-800 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 w-full py-2 resize-none focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" rows="1" placeholder="Write a message..."></textarea>
                                                    </div>
                                                    <button t-attf-id="page-details-expedition-send-message" class="message-send-button text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 bg-blue-50 dark:bg-blue-900/30 p-2 rounded-full flex items-center justify-center ml-2">
                                                        <i class="fas fa-paper-plane"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="h-30"></div>

        </t>
    </template>
</odoo>