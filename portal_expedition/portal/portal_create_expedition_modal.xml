<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_create_expedition_modal" name="Portal Create Expedition Modal">
        <!-- Sale Order Create Modal -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

        <!-- Select2 (si también usas esta librería) -->
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

        <div t-attf-id="page-#{page_name}-list-create-modal" class="modal" data-outside-close="false">
            <div class="modal-content max-w-2xl w-full mx-auto">
                <div class="modal-header">
                    <h3 class="text-lg font-sm text-gray-900 dark:text-gray-100">Expedition Create</h3>
                        <button data-modal-close="true" class="close-modal" aria-label="Close modal">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="modal-body">
                        <form t-attf-id="page-#{page_name}-list-create-form">
                            <!-- Contact Information -->
                            <label class="form-label-md font-md">Contact Information</label>
                            <div class="grid grid-cols-2 md:grid-cols-2 gap-4 mb-4">
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label t-attf-for="page-#{page_name}-list-create-form-contact-name" class="form-label-sm font-sm">Contact Name</label>
                                        <span class="text-red-500 ml-1">*</span>
                                    </div>
                                    <div>
                                        <input type="text" name="name" t-attf-id="page-#{page_name}-list-create-form-contact-name" required="required" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="Contact Name"/>
                                        <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-contact-name-error"></div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label t-attf-for="page-#{page_name}-list-create-form-email" class="form-label-sm font-sm">Email</label>
                                        <span class="text-red-500 ml-1">*</span>
                                    </div>
                                    <div>
                                        <input type="text" name="email" t-attf-id="page-#{page_name}-list-create-form-email" required="required" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="Email"/>
                                        <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-email-error"></div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label t-attf-for="page-#{page_name}-list-create-form-phone" class="form-label-sm font-sm">Phone</label>
                                        <span class="text-red-500 ml-1">*</span>
                                    </div>
                                    <div>
                                        <input type="text" name="phone" t-attf-id="page-#{page_name}-list-create-form-phone" required="required" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="Phone"/>
                                        <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-phone-error"></div>
                                    </div>
                                </div>
                                    <div class="form-group">
                                    <div class="flex items-center">
                                        <label t-attf-for="page-#{page_name}-list-create-form-mobile" class="form-label-sm font-sm">Mobile</label>
                                    </div>
                                    <div>
                                        <input type="text" name="mobile" t-attf-id="page-#{page_name}-list-create-form-mobile" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="Mobile"/>
                                        <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-mobile-error"></div>
                                    </div>
                                </div>
                            </div>

                            <!--Client Additional Information-->
                            <label class="form-label-md font-md">Additional Information</label>
                            <div class="mb-4">
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label t-attf-for="page-#{page_name}-list-create-form-client-ref" class="form-label-sm font-sm">Client Reference</label>
                                    </div>
                                    <div>
                                        <input type="text" name="client_ref" t-attf-id="page-#{page_name}-list-create-form-client-ref" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="Client Reference"/>
                                        <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-client-ref-error"></div>
                                    </div>
                                </div>
                            </div>
                            <!-- Address Information -->
                            <label class="form-label-md font-md">Address Information</label>
                            <div class="grid grid-cols-2 md:grid-cols-2 gap-4 mb-4">
                                <div class="form-group col-span-full">
                                    <div class="flex items-center">
                                        <label t-attf-for="page-#{page_name}-list-create-form-street" class="form-label-sm font-sm">Street</label>
                                        <span class="text-red-500 ml-1">*</span>
                                    </div>
                                    <div>
                                        <input type="text" name="street" t-attf-id="page-#{page_name}-list-create-form-street" required="required" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="Street"/>
                                        <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-street-error"></div>
                                    </div>
                                </div>
                                <div class="form-group col-span-full">
                                    <div class="flex items-center">
                                        <label t-attf-for="page-#{page_name}-list-create-form-street2" class="form-label-sm font-sm">Street 2</label>
                                    </div>
                                    <div>
                                        <input type="text" name="street2" t-attf-id="page-#{page_name}-list-create-form-street2" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="Street 2"/>
                                        <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-street2-error"></div>
                                    </div>
                                </div>
                                <div class="form-group col-span-full">
                                    <div class="flex items-center">
                                        <label t-attf-for="page-#{page_name}-list-create-form-address" class="form-label-sm font-sm">Search address</label>
                                        <span class="text-red-500 ml-1">*</span>
                                    </div>
                                    <div>
                                        <input type="text" name="address" t-attf-id="page-#{page_name}-list-create-form-address" class="order-select w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="Search Address"/>
                                        <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-address-error"></div>
                                    </div>
                                </div>



                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label t-attf-for="page-#{page_name}-list-create-form-zip" class="form-label-sm font-sm">ZIP</label>
                                        <span class="text-red-500 ml-1">*</span>
                                    </div>
                                    <div>
                                        <input type="text" name="zip" t-attf-id="page-#{page_name}-list-create-form-zip" required="required" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="ZIP"/>
                                        <input type="hidden" name="zip_id" t-attf-id="page-#{page_name}-list-create-form-zip-id"/>
                                        <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-zip-error"></div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label t-attf-for="page-#{page_name}-list-create-form-city" class="form-label-sm font-sm">City</label>
                                        <span class="text-red-500 ml-1">*</span>
                                    </div>
                                    <div>
                                        <input type="text" name="city" t-attf-id="page-#{page_name}-list-create-form-city" required="required" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="City"/>
                                        <input type="hidden" name="city_id" t-attf-id="page-#{page_name}-list-create-form-city-id"/>
                                        <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-city-error"></div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label t-attf-for="page-#{page_name}-list-create-form-state" class="form-label-sm font-sm">State</label>
                                        <span class="text-red-500 ml-1">*</span>
                                    </div>
                                    <div>
                                        <input type="text" name="state" t-attf-id="page-#{page_name}-list-create-form-state" required="required" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="State"/>
                                        <input type="hidden" name="state_id" t-attf-id="page-#{page_name}-list-create-form-state-id"/>
                                        <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-state-error"></div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label t-attf-for="page-#{page_name}-list-create-form-country" class="form-label-sm font-sm">Country</label>
                                        <span class="text-red-500 ml-1">*</span>
                                    </div>
                                    <div>
                                        <input type="text" name="country" t-attf-id="page-#{page_name}-list-create-form-country" required="required" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="Country"/>
                                        <input type="hidden" name="country_id" t-attf-id="page-#{page_name}-list-create-form-country-id"/>
                                        <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-country-error"></div>
                                    </div>
                                </div>
                            </div>
                            <!-- Other Information -->
                            <div class="form-group">
                                <div class="flex items-center">
                                    <label t-attf-for="page-#{page_name}-list-create-form-carrier-id" class="form-label-sm font-sm">Carrier</label>
                                    <span class="text-red-500 ml-1">*</span>
                                </div>
                                <div>
                                    <select name="carrier_id" t-attf-id="page-#{page_name}-list-create-form-carrier-id" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme"></select>
                                    <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-carrier-id-error"></div>
                                </div>
                            </div>
                            <div class="form-group">
                                <input name="products" type="hidden" t-attf-id="page-#{page_name}-list-create-form-products-list" required="required"/>

                                <div class="mb-4">
                                    <p class="form-label-sm font-sm">Products</p>
                                </div>

                                <div t-attf-id="page-#{page_name}-list-create-form-products-container">
                                    <div t-attf-id="page-#{page_name}-list-create-form-products-line-items-container"
                                        class="products-line-items-container">
                                    </div>

                                    <div class="mt-3 flex items-center gap-2">
                                        <button t-attf-id="page-#{page_name}-list-create-form-lots-add-catalog-btn" type="button"
                                                class="px-2 py-0.5 btn-primary text-white rounded-md  transition-colors text-xs flex items-center">
                                            <i class="fas fa-plus mr-1.5"></i> Catalog

                                        </button>
                                        <span class="ml-2 text-xs text-gray-500 italic">
                                            <i class="fas fa-info-circle"></i> Select products from catalog
                                        </span>
                                    </div>

                                </div>

                                <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-products-list-error"></div>
                            </div>

                        </form>
                    </div>
                    <div class="modal-footer bg-gray-50 dark:bg-gray-800 px-6 py-4 flex justify-end rounded-b-lg border-t border-gray-200 dark:border-gray-700">
                        <button data-modal-close="true" class="modal-btn modal-btn-secondary mr-2">
                            <i class="fas fa-times"></i> Cancel
                        </button>
                        <button t-attf-id="page-#{page_name}-list-create-product-form-submit" class="modal-btn modal-btn-primary">
                            <i class="fas fa-save"></i> Save
                        </button>
                    </div>
                </div>
            </div>
    </template>
</odoo>