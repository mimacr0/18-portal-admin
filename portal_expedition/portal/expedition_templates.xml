<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_expedition_page" name="Portal Expedition Page">
        <t t-call="portal_admin_theme.portal_admin_layout">

            <div class="w-full">

                <div class="card-title-container mb-4 flex items-center">
                    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Expeditions</h1>
                </div>

                <!-- Barra de herramientas de acciones masivas: oculta por defecto, visible cuando se seleccionan elementos. -->
                <div id="bulk-actions-toolbar" class="bg-white rounded-lg shadow mb-4 p-3 hidden dark:bg-gray-800">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center">
                            <span id="selected-count" class="text-sm font-medium text-gray-700 dark:text-gray-300 mr-3">0 selected</span>
                            <div class="h-4 border-l border-gray-300 dark:border-gray-700 mr-3"></div>
                            <div class="flex flex-wrap gap-2">
                                <button t-foreach="batch_actions" t-as="batch_action" t-attf-id="page-list-#{page_name}-batch-action-#{batch_action.get('name')}" class="px-3 py-1 bg-red-600 text-white text-sm rounded hover:bg-red-700 transition-colors flex items-center">
                                    <i t-attf-class="#{batch_action.get('icon')} mr-1.5"></i> <t t-out="batch_action.get('label')"/>
                                </button>
                            </div>
                        </div>
                        <button id="clear-selection" class="text-sm text-gray-600 hover:text-gray-800">
                            <i class="fas fa-times mr-1"></i> Clear selection
                        </button>
                    </div>
                </div>

                <!-- Acciones rápidas de filtrado -->
                <t t-if="list_filters">
                    <div class="border-b border-gray-200 dark:border-gray-700 mb-2">
                        <div class="flex overflow-x-auto scrollbar-hide">
                            <input type="hidden" t-attf-id="page-#{page_name}-list-filter-active" value="[]"/>
                            <t t-foreach="list_filters" t-as="list_filter">
                                <button t-if="list_filter.get('active')" type="button" t-attf-id="page-#{page_name}-list-filter-#{list_filter.get('id')}" class="tab-button active px-6 py-3 text-sm font-medium border-b-2 border-cyan-500 text-cyan-600 focus:outline-none transition-colors duration-200 ease-in-out dark:text-white relative">
                                    <i t-attf-class="#{list_filter.get('icon')} mr-2"></i>
                                    <t t-out="list_filter.get('label')"/>
                                </button>
                                <button t-else="" type="button" t-attf-id="page-#{page_name}-list-filter-#{list_filter.get('id')}" class="tab-button px-6 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 focus:outline-none transition-colors duration-200 ease-in-out dark:text-white dark:hover:text-gray-300 relative">
                                    <i t-attf-class="#{list_filter.get('icon')} mr-2"></i>
                                    <t t-out="list_filter.get('label')"/>
                                </button>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- Tabla de usuarios -->
                <div class="bg-white rounded-lg shadow overflow-hidden mb-20 dark:bg-gray-800">
                    <div class="p-4 border-b border-gray-200 dark:border-gray-700">
                        <div class="flex flex-col lg:flex-row justify-between gap-4">
                            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                                <div class="flex items-center">
                                    <button t-attf-id="launch-create-#{page_name}-form-button" class="px-3 py-1.5 bg-cyan-600 text-white rounded-md hover:bg-cyan-700 transition-colors flex items-center">
                                        <i class="fas fa-plus mr-1.5"></i> <span class="hidden sm:inline">Create</span>
                                    </button>
                                </div>
                            </div>

                            <div class="flex items-center justify-between gap-2">
                                <!-- Buscar entrada -->
                                <div class="relative flex-grow max-w-xs">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <i class="fas fa-search text-gray-400 dark:text-gray-500"></i>
                                    </div>
                                    <input type="text" id="page-expedition-products-list-search" class="block w-full pl-10 pr-3 py-1.5 text-sm border border-gray-300 rounded-md focus:border-cyan-500 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Search ..."/>
                                </div>

                                <!-- Botón de búsqueda avanzada -->
                                <button t-if="advanced_search" t-attf-id="page-#{page_name}-list-advanced-search-toggle" data-tooltip-target="tooltip-advanced-search" class="p-2 border border-gray-300 rounded-md hover:bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-700 dark:hover:bg-gray-700 relative">
                                    <i class="fas fa-sliders-h"></i>
                                </button>

                                <!-- Botones de acción-->
                                <div class="flex items-center">
                                    <button t-foreach="tools_actions" t-as="tools_action" t-attf-data-tooltip-target="page-#{page_name}-list-#{tools_action.get('name')}-action-tool" t-attf-id="page-#{page_name}-list-#{tools_action.get('name')}-action-tool" class="p-2 rounded-md hover:bg-gray-100 text-gray-500 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-700 dark:hover:bg-gray-700 relative">
                                        <i t-att-class="tools_action.get('icon')"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Panel de búsqueda avanzada - oculto por defecto -->
                        <div t-attf-id="page-#{page_name}-list-advanced-search-panel" class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700 hidden">
                            <input type="hidden" t-attf-id="page-#{page_name}-list-advanced-search-domain" value="[]"/>
                            <input type="hidden" t-attf-id="page-#{page_name}-list-advanced-search-fields" t-att-value="advanced_search"/>
                            <h3 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Advanced Search</h3>

                            <!-- Filtro dinámico avanzado -->
                            <div class="w-full">

                                <!-- Match Type Selector -->
                                <div class="mb-4">
                                    <p class="text-sm text-gray-700 dark:text-gray-300">
                                        <select t-attf-id="page-#{page_name}-list-advanced-search-match-type" class="inline-block mx-1 px-2 py-1 text-sm border border-gray-300 rounded-md shadow-sm focus:ring-cyan-500 focus:border-cyan-500 bg-white dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700">
                                            <option value="all" selected="selected">All</option>
                                            <option value="any">Any</option>
                                        </select>
                                        of the following conditions:
                                    </p>
                                </div>

                                <!-- Contenedor de líneas de filtrado -->
                                <div t-attf-id="page-#{page_name}-list-advanced-search-lines-container" class="space-y-3"></div>

                                <!-- Botón de añadir línea de filtro -->
                                <div class="mt-3">
                                    <button t-attf-id="page-#{page_name}-list-advanced-search-add-line-btn" class="flex items-center text-cyan-600 hover:text-cyan-700 text-sm font-medium">
                                        <i class="fas fa-plus-circle mr-1.5"></i> Add filter condition
                                    </button>
                                </div>
                            </div>

                            <!-- Botones de acción para la búsqueda avanzada -->
                            <div class="mt-4 flex justify-end space-x-3">
                                <button t-attf-id="page-#{page_name}-list-advanced-search-reset-btn" class="px-3 py-1 text-sm border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700 dark:hover:bg-gray-700">
                                    Reset
                                </button>
                                <button t-attf-id="page-#{page_name}-list-advanced-search-apply-btn" class="px-3 py-1 text-sm bg-cyan-600 text-white rounded-md shadow-sm hover:bg-cyan-700 dark:bg-cyan-600 dark:text-white dark:hover:bg-cyan-700 dark:hover:text-white">
                                    Apply Filters
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Estructura de tabla para la lista de recepciones -->
                    <div class="overflow-x-auto">
                        <!-- <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700" t-attf-id="page-#{page_name}-list-table"> -->
                        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700" id="page-expedition-list-table">
                            <thead class="bg-gray-50 dark:bg-gray-800">
                                <tr>
                                    <th t-if="batch_actions" scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                        <div class="flex items-center">
                                            <input t-attf-id="page-#{page_name}-list-select-all-checkbox" type="checkbox" class="h-4 w-4 text-cyan-600 border-gray-300 rounded focus:ring-cyan-500 dark:border-gray-600 dark:bg-gray-700 dark:checked:bg-cyan-600 dark:checked:border-cyan-600"/>
                                        </div>
                                    </th>
                                    <t t-foreach="list_columns" t-as="list_column">
                                        <th t-if="list_column.get('sortable')" scope="col" t-attf-class="px-6 py-3 #{list_column.get('right') and 'text-right' or 'text-left'} text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider #{list_column.get('md') and 'hidden md:table-cell' or ''} #{list_column.get('lg') and 'hidden lg:table-cell' or ''}">
                                            <div class="flex items-center">
                                                <span t-out="list_column.get('label')"/>
                                                <i t-attf-id="list-column-#{page_name}-#{list_column.get('id')}-sort-icon" t-if="list_column.get('sortable')" class="fas fa-sort ml-1 text-gray-400"></i>
                                            </div>
                                        </th>
                                        <th t-else="" scope="col" t-attf-class="px-6 py-3 #{list_column.get('right') and 'text-right' or 'text-left'} text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                            <span t-out="list_column.get('label')"/>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700" id="expedition-page-list-items"></tbody>

                        </table>
                    </div>

                </div>
            </div>

            <div class="fixed bottom-0 right-0 z-10 mr-6 mb-6">
                <input type="hidden" id="expedition-list-pagination-page" value="1"/>
                <div class="pagination-container px-4 py-3 bg-white border border-gray-200 dark:bg-gray-800 dark:border-gray-700 rounded-lg shadow-lg flex items-center justify-between" id="expedition-list-pagination-container"></div>
            </div>

            <div class="h-25"></div>

            <t t-set="footer_content">

                <!-- Expedition Create Modal -->
                <t t-call="portal_expedition.portal_create_expedition_modal"/>

                <!-- Modal de carga de archivos -->
                <div id="file-upload-modal" class="modal" data-outside-close="false">
                    <div class="modal-content max-w-lg w-full mx-auto">
                        <div class="modal-header">
                            <h3 class="text-lg font-sm text-gray-900 dark:text-gray-100">File Upload</h3>
                            <button data-modal-close="true" class="close-modal" aria-label="Close modal">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="modal-body">
                            <form class="form-flex">
                                <div class="form-group-flex">
                                    <label for="fileInput" class="form-label form-label-sm">Upload File</label>
                                    <div class="form-field-container">
                                        <div class="file-drop-area rounded-md border-2 border-dashed border-gray-300 dark:border-gray-600 p-4 text-center cursor-pointer">
                                            <input type="file" id="fileInput" name="fileInput" class="hidden focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" required="required" multiple="multiple"/>
                                            <div class="file-input-content">
                                                <i class="fas fa-cloud-upload-alt text-2xl text-gray-400 dark:text-gray-500"></i>
                                                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Drag and drop a file here, or <span class="text-cyan-600 dark:text-cyan-400 browse-link">browse</span></p>
                                                <p class="text-xs text-gray-500 dark:text-gray-500 mt-1">Maximum file size: 5MB</p>
                                            </div>
                                        </div>
                                        <div class="file-preview mt-3 flex flex-col items-center"></div>
                                        <div class="form-error" id="fileInputError">Please select a file to upload.</div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button data-modal-close="true" class="modal-btn modal-btn-secondary mr-2">
                                <i class="fas fa-times"></i> Cancel
                            </button>
                            <button class="modal-btn modal-btn-primary">
                                <i class="fas fa-save"></i> Upload
                            </button>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="portal_expedition_list" name="Portal Expeditions List">
        <input type="hidden" id="csrf_token" name="csrf_token" t-att-value="request.csrf_token()"/>

        <t t-foreach="orders" t-as="order">
            <!-- Fila de pantallas grandes -->
            <tr class="hover:bg-gray-100 dark:hover:bg-gray-700 hidden lg:table-row">
                <td class="px-3 py-4 whitespace-nowrap">
                    <input type="checkbox" class="orders-list-checkbox h-4 w-4 text-cyan-600 border-gray-300 rounded focus:ring-cyan-500" t-att-data-order-id="order.id"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                        <div class="ml-4">
                            <div class="text-sm font-medium text-gray-900 dark:text-gray-100" t-esc="order.name"/>
                            <div class="text-sm text-gray-500">Client Order Ref: <t t-esc="order.client_order_ref"/></div>
                        </div>
                    </div>
                </td>
            
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100">
                        <t t-foreach="order.order_line" t-as="line">
                            <div class="flex mb-1">
                                <div class="w-40 pr-2"><t t-esc="line.product_id.name"/></div>
                                <div class="text-center w-20 text-gray-500 dark:text-gray-100"><t t-esc="line.product_uom_qty"/></div>
                            </div>
                        </t>
                    </div>
                </td>

                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100">
                        <div class="flex mb-1">
                            <div class="text-right pr-2 w-32"><strong>Subtotal:</strong></div>
                            <div><t t-esc="order.amount_untaxed"/> <t t-esc="order.currency_id.symbol"/></div>
                        </div>
                        <div class="flex mb-1">
                            <div class="text-right pr-2 w-32"><strong>Tax:</strong></div>
                            <div><t t-esc="order.amount_tax"/> <t t-esc="order.currency_id.symbol"/></div>
                        </div>
                        <div class="flex">
                            <div class="text-right pr-2 w-32"><strong>Total:</strong></div>
                            <div><t t-esc="order.amount_total"/> <t t-esc="order.currency_id.symbol"/></div>
                        </div>
                    </div>
                </td>

                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                        <t t-set="last_picking" t-value="order.picking_ids and order.picking_ids.sorted('scheduled_date')[-1]"/>
                        <t t-if="last_picking">
                            <div class="text-sm text-gray-900 dark:text-gray-100 space-y-1">
                                <div>
                                    <strong>Carrier:</strong>
                                    <t t-esc="last_picking.carrier_id.name or 'N/A'"/>
                                </div>
                                <div>
                                    <strong>Tracking Ref:</strong>
                                    <t t-esc="last_picking.carrier_tracking_ref or 'N/A'"/>
                                </div>
                                <div>
                                    <strong>Current Location:</strong>
                                    <t t-if="last_picking.state != 'done'">
                                        <t t-esc="last_picking.location_id.name"/>
                                    </t>
                                    <t t-if="last_picking.state == 'done'">
                                        <t t-esc="last_picking.location_dest_id.name"/>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </td>


                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                        <div class="ml-4">
                            <div class="text-sm font-medium text-gray-900 dark:text-gray-100">Date Order: <t t-esc="order.date_order.strftime('%d-%m-%Y %H:%M:%S')"/></div>
                            <t t-foreach="order.picking_ids" t-as="picking">
                                <t t-if="picking.picking_type_id.barcode == 'WHPICK'">
                                    <t t-if="picking.state == 'done'">
                                        <div class="text-sm text-green-600 dark:text-green-400">
                                            Pick Date Done: <t t-esc="picking.date_done.strftime('%d-%m-%Y %H:%M:%S')"/>
                                        </div>
                                    </t>
                                    <t t-if="picking.state != 'done'">
                                        <div class="text-sm text-gray-900 dark:text-gray-100">
                                            Pick Scheduled Date: <t t-esc="picking.scheduled_date.strftime('%d-%m-%Y %H:%M:%S')"/>
                                        </div>
                                    </t>
                                </t>
                                <t t-if="picking.picking_type_id.barcode == 'WHPACK'">
                                    <t t-if="picking.state == 'done'">
                                        <div class="text-sm text-green-600 dark:text-green-400">
                                            Pack Date Done: <t t-esc="picking.date_done.strftime('%d-%m-%Y %H:%M:%S')"/>
                                        </div>
                                    </t>
                                    <t t-if="picking.state != 'done'">
                                        <div class="text-sm text-gray-900 dark:text-gray-100">
                                            Pack Scheduled Date: <t t-esc="picking.scheduled_date.strftime('%d-%m-%Y %H:%M:%S')"/>
                                        </div>
                                    </t>
                                </t>
                                <t t-if="picking.picking_type_id.barcode == 'WHOUT'">
                                    <t t-if="picking.state == 'done'">
                                        <div class="text-sm text-green-600 dark:text-green-400">
                                            Sent Date: <t t-esc="picking.date_done.strftime('%d-%m-%Y %H:%M:%S')"/>
                                        </div>
                                    </t>
                                    <t t-if="picking.state != 'done'">
                                        <div class="text-sm text-gray-900 dark:text-gray-100">
                                            Sent Scheduled Date: <t t-esc="picking.scheduled_date.strftime('%d-%m-%Y %H:%M:%S')"/>
                                        </div>
                                    </t>
                                </t>
                            </t>
                        </div>
                    </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100">
                        <t t-foreach="order.picking_ids" t-as="picking">
                            <t t-if="picking.picking_type_id.barcode == 'WHPICK'">
                                <div class="flex mb-1">
                                    <div class="text-right pr-2 w-32"><strong>Picking State:</strong></div>
                                    <div><t t-esc="picking.state"/></div>
                                </div>
                            </t>
                            <t t-if="picking.picking_type_id.barcode == 'WHPACK'">
                                <div class="flex mb-1">
                                    <div class="text-right pr-2 w-32"><strong>Package State:</strong></div>
                                    <div><t t-esc="picking.state"/></div>
                                </div>
                            </t>
                            <t t-if="picking.picking_type_id.barcode == 'WHOUT'">
                                <div class="flex mb-1">
                                    <div class="text-right pr-2 w-32"><strong>Sent State:</strong></div>
                                    <div><t t-esc="picking.state"/></div>
                                </div>
                            </t>
                        </t>
                    </div>
                </td>

                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">

                    <a t-att-href="order.get_details_url()" t-attf-data-tooltip-target="tooltip-details-#{order.id}" class="text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-info-circle"></i>
                    </a>
                    <button t-attf-data-tooltip-target="tooltip-edit-#{order.id}"  t-attf-id="tooltip-edit-#{order.id}" class="text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button t-attf-data-tooltip-target="tooltip-delete-#{order.id}" class="text-gray-600 hover:text-gray-900 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>

            <!-- Fila de pantallas medianas -->
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 hidden md:table-row lg:hidden">
                <td t-if="batch_actions" class="px-3 py-4 whitespace-nowrap">
                    <input type="checkbox" class="order-checkbox h-4 w-4 text-cyan-600 border-gray-300 rounded focus:ring-cyan-500" t-att-data-order-id="order.id"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900 dark:text-gray-100" t-esc="order.name"/>
                        <div class="text-sm text-gray-500">ID: #<t t-esc="order.id"/></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100">
                        <t t-foreach="order.order_line" t-as="line">
                            <div class="flex mb-1">
                                <div class="w-40 pr-2"><t t-esc="line.product_id.name"/></div>
                                <div class="text-center w-20 text-gray-500 dark:text-gray-100"><t t-esc="line.product_uom_qty"/></div>
                            </div>
                        </t>
                    </div>
                </td>

            
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                        <t t-set="last_picking" t-value="order.picking_ids and order.picking_ids.sorted('scheduled_date')[-1]"/>
                        <t t-if="last_picking">
                            <div class="text-sm text-gray-900 dark:text-gray-100 space-y-1">
                                <div>
                                    <strong>Carrier:</strong>
                                    <t t-esc="last_picking.carrier_id.name or 'N/A'"/>
                                </div>
                                <div>
                                    <strong>Tracking Ref:</strong>
                                    <t t-esc="last_picking.carrier_tracking_ref or 'N/A'"/>
                                </div>
                                <div>
                                    <strong>Current Location:</strong>
                                    <t t-if="last_picking.state != 'done'">
                                        <t t-esc="last_picking.location_id.name"/>
                                    </t>
                                    <t t-if="last_picking.state == 'done'">
                                        <t t-esc="last_picking.location_dest_id.name"/>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <button t-attf-data-tooltip-target="tooltip-edit-#{order.id}" class="text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button t-attf-data-tooltip-target="tooltip-delete-#{order.id}" class="text-gray-600 hover:text-gray-900 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>

            <!-- Fila de pantallas pequeñas -->
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 table-row md:hidden">
                <td t-if="batch_actions" class="px-3 py-4 whitespace-nowrap">
                    <input type="checkbox" class="order-checkbox h-4 w-4 text-cyan-600 border-gray-300 rounded focus:ring-cyan-500" t-att-data-order-id="order.id"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900 dark:text-gray-100" t-esc="order.name"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100">
                        <t t-foreach="order.order_line" t-as="line">
                            <div class="flex mb-1">
                                <div class="w-40 pr-2"><t t-esc="line.product_id.name"/></div>
                                <div class="text-center w-20 text-gray-500 dark:text-gray-100"><t t-esc="line.product_uom_qty"/></div>
                            </div>
                        </t>
                    </div>
                </td>

                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <button t-attf-data-tooltip-target="tooltip-edit-#{order.id}" class="text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button t-attf-data-tooltip-target="tooltip-delete-#{order.id}" class="text-gray-600 hover:text-gray-900 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
        </t>
    </template>

    <template id="portal_expedition_pager" name="Portal Expedition Pager">
        <!-- No hay resultados -->
        <div class="sm:hidden" t-if="items_count == 0">
            <p class="text-xs text-gray-700 dark:text-gray-300 mb-2">
                <span class="font-medium">No results found</span>
            </p>
        </div>
        <!-- Controles de paginación móviles -->
        <div class="sm:hidden" t-if="items_count > 0">
            <p class="text-xs text-gray-700 dark:text-gray-300 mb-2">
                <span class="font-medium">Showing 1-<span t-out="items_count"/></span> of <span class="font-medium" t-out="items_total"/> <span t-out="items_label"/>
            </p>
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <span class="sr-only">Previous</span>
                    <i class="fas fa-chevron-left"></i>
                </button>
                <t t-foreach="pages" t-as="page">
                    <button type="button" t-if="page.get('active')" class="z-10 bg-cyan-50 dark:bg-gray-800 border-cyan-500 dark:border-cyan-500 text-cyan-600 dark:text-cyan-600 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                    <button type="button" t-else="" class="bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                </t>
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <span class="sr-only">Next</span>
                    <i class="fas fa-chevron-right"></i>
                </button>
            </nav>
        </div>
        <!-- Paginación de escritorio -->
        <div class="hidden sm:flex sm:items-center" t-if="items_count > 0">
            <p class="text-sm text-gray-700 dark:text-gray-300 mr-4">
                <span class="font-medium">Showing</span> <span class="font-medium">1-<span t-out="items_count"/></span> <span>of</span> <span class="font-medium" t-out="items_total"/> <span t-out="items_label"/> <span class="text-gray-500 ml-1"></span>
            </p>
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700" id="expedition-list-pagination-previous">
                    <span class="sr-only">Previous</span>
                    <i class="fas fa-chevron-left"></i>
                </button>
                <t t-foreach="pages" t-as="page">

                    <button t-if="page.get('active')" aria-current="page" t-att-data-page="page.get('page')" class="expedition-list-pagination-button z-10 bg-cyan-50 dark:bg-gray-800 border-cyan-500 dark:border-cyan-500 text-cyan-600 dark:text-cyan-600 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                    <button t-else="" t-att-data-page="page.get('page')" class="expedition-list-pagination-button bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                </t>
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700" id="expedition-list-pagination-next">
                    <span class="sr-only">Next</span>
                    <i class="fas fa-chevron-right"></i>
                </button>
            </nav>
        </div>
    </template>
</odoo>