<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_products_page" name="Portal Products Page">
        <t t-call="portal_admin_theme.portal_admin_layout">

            <div class="w-full">

                <div class="card-title-container mb-4 flex items-center">
                    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Products</h1>
                </div>

                <!-- Bulk actions toolbar - hidden by default, visible when items are selected -->
                <div id="bulk-actions-toolbar" class="bg-white rounded-lg shadow mb-4 p-3 hidden dark:bg-gray-800">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center">
                            <span id="selected-count" class="text-sm font-medium text-gray-700 dark:text-gray-300 mr-3">0 selected</span>
                            <div class="h-4 border-l border-gray-300 dark:border-gray-700 mr-3"></div>
                            <div class="flex flex-wrap gap-2">
                                <button t-foreach="batch_actions" t-as="batch_action" t-attf-id="page-list-#{page_name}-batch-action-#{batch_action.get('name')}" class="px-3 py-1 bg-red-600 text-white text-sm rounded hover:bg-red-700 transition-colors flex items-center">
                                    <i t-attf-class="#{batch_action.get('icon')} mr-1.5"></i> <t t-out="batch_action.get('label')"/>
                                </button>
                            </div>
                        </div>
                        <button id="clear-selection" class="text-sm text-gray-600 hover:text-gray-800">
                            <i class="fas fa-times mr-1"></i> Clear selection
                        </button>
                    </div>
                </div>

                <!-- Users Table -->
                <div class="bg-white rounded-lg shadow overflow-hidden mb-20 dark:bg-gray-800">
                    <div class="p-4 border-b border-gray-200 dark:border-gray-700">
                        <div class="flex flex-col lg:flex-row justify-between gap-4">
                            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                                <div class="flex items-center">
                                    <button t-attf-id="launch-create-#{page_name}-form-button" class="px-3 py-1.5 bg-cyan-600 text-white rounded-md hover:bg-cyan-700 transition-colors flex items-center">
                                        <i class="fas fa-plus mr-1.5"></i> <span class="hidden sm:inline">Create</span>
                                    </button>

                                    <t t-if="list_filters">
                                        <!-- Filters row - visible on larger screens -->
                                        <div class="hidden lg:flex items-center ml-4 space-x-2">
                                            <t t-foreach="list_filters" t-as="list_filter">
                                                <select t-attf-id="#{page_name}-list-filter-#{list_filter['id']}" class="px-2 py-1 text-sm border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700">
                                                    <option t-if="list_filter.get('placeholder')" value=""><t t-out="list_filter.get('placeholder')"/></option>
                                                    <t t-foreach="list_filter.get('values')" t-as="value">
                                                        <option t-att-value="value[0]"><t t-out="value[1]"/></option>
                                                    </t>
                                                </select>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <div class="flex items-center justify-between gap-2">
                                <!-- Search input -->
                                <div class="relative flex-grow max-w-xs">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <i class="fas fa-search text-gray-400 dark:text-gray-500"></i>
                                    </div>
                                    <input type="text" id="search" class="block w-full pl-10 pr-3 py-1.5 text-sm border border-gray-300 rounded-md focus:border-cyan-500 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Search ..."/>
                                </div>

                                <!-- Advanced search toggle button -->
                                <button id="advanced-search-toggle" data-tooltip-target="tooltip-advanced-search" class="p-2 border border-gray-300 rounded-md hover:bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-700 dark:hover:bg-gray-700 relative">
                                    <i class="fas fa-sliders-h"></i>
                                </button>

                                <!-- Action buttons -->
                                <div class="flex items-center">
                                    <button t-foreach="tools_actions" t-as="tools_action" t-attf-data-tooltip-target="page-list-#{page_name}-tools-action-#{tools_action.get('name')}" t-attf-id="page-list-#{page_name}-tools-action-#{tools_action.get('name')}" class="p-2 rounded-md hover:bg-gray-100 text-gray-500 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-700 dark:hover:bg-gray-700 relative">
                                        <i t-att-class="tools_action.get('icon')"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Advanced search panel - hidden by default -->
                        <div id="advanced-search-panel" class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700 hidden">
                            <h3 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Advanced Search</h3>

                            <!-- Dynamic Advanced Filter -->
                            <div class="w-full">

                                <!-- Match Type Selector -->
                                <div class="mb-4">
                                    <p class="text-sm text-gray-700 dark:text-gray-300">
                                        <select id="match-type" class="inline-block mx-1 px-2 py-1 text-sm border border-gray-300 rounded-md shadow-sm focus:ring-cyan-500 focus:border-cyan-500 bg-white dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700">
                                            <option value="all" selected="selected">All</option>
                                            <option value="any">Any</option>
                                        </select>
                                        of the following conditions:
                                    </p>
                                </div>

                                <!-- Filter Lines Container -->
                                <div id="filter-lines" class="space-y-3">
                                    <!-- Filter Line 1 -->
                                    <div class="filter-line flex flex-wrap md:flex-nowrap items-end gap-2">
                                        <!-- Field Selection -->
                                        <div class="w-full md:w-1/4">
                                            <label class="block text-xs font-medium text-gray-700 mb-1">Field</label>
                                            <select class="filter-field w-full px-2 py-1.5 text-sm border border-gray-300 rounded-md shadow-sm focus:ring-cyan-500 focus:border-cyan-500 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700">
                                                <option value="name">Name</option>
                                                <option value="email">Email</option>
                                                <option value="role">Role</option>
                                                <option value="status">Status</option>
                                                <option value="registered">Registration Date</option>
                                                <option value="last_login">Last Login</option>
                                            </select>
                                        </div>

                                        <!-- Operator Selection (Text) -->
                                        <div class="operator-container w-full md:w-1/4">
                                            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Operator</label>
                                            <select class="filter-operator w-full px-2 py-1.5 text-sm border border-gray-300 rounded-md shadow-sm focus:ring-cyan-500 focus:border-cyan-500 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700">
                                                <option value="equals">equals</option>
                                                <option value="contains">contains</option>
                                                <option value="not_equals">not equals</option>
                                                <option value="starts_with">starts with</option>
                                                <option value="ends_with">ends with</option>
                                            </select>
                                        </div>

                                        <!-- Value Input (Text) -->
                                        <div class="value-container w-full md:w-1/3">
                                            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Value</label>
                                            <input type="text" class="filter-value w-full px-2 py-1.5 text-sm border border-gray-300 rounded-md shadow-sm focus:ring-cyan-500 focus:border-cyan-500 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700" placeholder="Enter value..."/>
                                        </div>

                                        <!-- Remove Line Button -->
                                        <div class="flex items-center mt-1 md:mt-0">
                                            <button class="remove-filter p-1.5 text-gray-400 dark:text-gray-500 hover:text-red-500" title="Remove condition">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Filter Line 2 (Date example) -->
                                    <div class="filter-line flex flex-wrap md:flex-nowrap items-end gap-2">
                                        <!-- Field Selection -->
                                        <div class="w-full md:w-1/4">
                                            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Field</label>
                                            <select class="filter-field w-full px-2 py-1.5 text-sm border border-gray-300 rounded-md shadow-sm focus:ring-cyan-500 focus:border-cyan-500 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700">
                                                <option value="registered" selected="selected">Registration Date</option>
                                                <option value="name">Name</option>
                                                <option value="email">Email</option>
                                                <option value="role">Role</option>
                                                <option value="status">Status</option>
                                                <option value="last_login">Last Login</option>
                                            </select>
                                        </div>

                                        <!-- Operator Selection (Date) -->
                                        <div class="operator-container w-full md:w-1/4">
                                            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Operator</label>
                                            <select class="filter-operator w-full px-2 py-1.5 text-sm border border-gray-300 rounded-md shadow-sm focus:ring-cyan-500 focus:border-cyan-500 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700">
                                                <option value="greater_than">greater than</option>
                                                <option value="less_than">before than</option>
                                                <option value="equals">same as</option>
                                                <option value="not_equals">not same as</option>
                                            </select>
                                        </div>

                                        <!-- Value Input (Date) -->
                                        <div class="value-container w-full md:w-1/3">
                                            <label class="block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1">Value</label>
                                            <input type="date" class="filter-value w-full px-2 py-1.5 text-sm border border-gray-300 rounded-md shadow-sm focus:ring-cyan-500 focus:border-cyan-500"/>
                                        </div>

                                        <!-- Remove Line Button -->
                                        <div class="flex items-center mt-1 md:mt-0">
                                            <button class="remove-filter p-1.5 text-gray-400 hover:text-red-500" title="Remove condition">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Add Filter Line Button -->
                                <div class="mt-3">
                                    <button id="add-filter-line" class="flex items-center text-cyan-600 hover:text-cyan-700 text-sm font-medium">
                                        <i class="fas fa-plus-circle mr-1.5"></i> Add filter condition
                                    </button>
                                </div>
                            </div>

                            <!-- Action buttons for advanced search -->
                            <div class="mt-4 flex justify-end space-x-3">
                                <button t-attf-id="page-list-#{page_name}-reset-advanced-search" class="px-3 py-1 text-sm border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700 dark:hover:bg-gray-700">
                                    Reset
                                </button>
                                <button t-attf-id="page-list-#{page_name}-apply-advanced-search" class="px-3 py-1 text-sm bg-cyan-600 text-white rounded-md shadow-sm hover:bg-cyan-700 dark:bg-cyan-600 dark:text-white dark:hover:bg-cyan-700 dark:hover:text-white">
                                    Apply Filters
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                            <thead class="bg-gray-50 dark:bg-gray-800">
                                <tr>
                                    <th t-if="batch_actions" scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                        <div class="flex items-center">
                                            <input id="select-all-checkbox" type="checkbox" class="h-4 w-4 text-cyan-600 border-gray-300 rounded focus:ring-cyan-500 dark:border-gray-600 dark:bg-gray-700 dark:checked:bg-cyan-600 dark:checked:border-cyan-600"/>
                                        </div>
                                    </th>
                                    <t t-foreach="list_columns" t-as="list_column">
                                        <th t-if="list_column.get('sortable')" scope="col" t-attf-class="px-6 py-3 #{list_column.get('right') and 'text-right' or 'text-left'} text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider #{list_column.get('md') and 'hidden md:table-cell' or ''} #{list_column.get('lg') and 'hidden lg:table-cell' or ''}">
                                            <div class="flex items-center">
                                                <span t-out="list_column.get('label')"/>
                                                <i t-attf-id="list-column-#{page_name}-#{list_column.get('id')}-sort-icon" t-if="list_column.get('sortable')" class="fas fa-sort ml-1 text-gray-400"></i>
                                            </div>
                                        </th>
                                        <th t-else="" scope="col" t-attf-class="px-6 py-3 #{list_column.get('right') and 'text-right' or 'text-left'} text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                            <span t-out="list_column.get('label')"/>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700" t-attf-id="#{page_name}-page-list-items"></tbody>
                        </table>
                    </div>

                </div>
            </div>

            <div class="fixed bottom-0 right-0 z-10 mr-6 mb-6">
                <div class="pagination-container px-4 py-3 bg-white border border-gray-200 dark:bg-gray-800 dark:border-gray-700 rounded-lg shadow-lg flex items-center justify-between" t-attf-id="#{page_name}-list-pagination-container"></div>
            </div>

            <div class="h-25"></div>

            <t t-set="footer_content">

                <!-- Package Recepction Create Modal -->
                <div id="package-recepction-create-modal" class="modal" data-outside-close="false">
                    <div class="modal-content max-w-2xl w-full mx-auto">
                        <div class="modal-header">
                            <h3 class="text-lg font-sm text-gray-900 dark:text-gray-100">Package Recepction Create</h3>
                            <button data-modal-close="true" class="close-modal" aria-label="Close modal">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="modal-body">
                            <form id="package-recepction-create-form">
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label for="package_type_id" class="form-label-sm font-sm">Package Type</label>
                                        <span class="text-red-500 ml-1">*</span>
                                        <div class="field-help m-1">
                                            <div class="help-icon cursor-pointer">?</div>
                                            <div class="help-tooltip">
                                                Help text
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <select id="package_type_id" name="package_type_id" class="form-select-sm w-full text-sm" required="required">
                                            <option value="">Select package type</option>
                                            <option value="1">Option 1</option>
                                            <option value="2">Option 2</option>
                                            <option value="3">Option 3</option>
                                        </select>
                                        <div class="form-error invisible" id="package_type_id-error"></div>
                                        <div class="field-help mt-1">
                                            <span class="help-text">Help text</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label for="package_volume" class="form-label-sm font-sm">Measures (mm)</label>
                                        <span class="text-red-500 ml-1">*</span>
                                        <div class="field-help m-1">
                                            <div class="help-icon cursor-pointer">?</div>
                                            <div class="help-tooltip">
                                                Help text
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="flex items-center">
                                            <input type="number" id="package_volume_width" name="package_volume_width" class="form-input-sm w-full text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Width" required="required"/>
                                            <span class="mx-1">x</span>
                                            <input type="number" id="package_volume_height" name="package_volume_height" class="form-input-sm w-full text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Height" required="required"/>
                                            <span class="mx-1">x</span>
                                            <input type="number" id="package_volume_length" name="package_volume_length" class="form-input-sm w-full text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Length" required="required"/>
                                            <span class="mx-1">mm</span>
                                        </div>
                                        <div class="form-error invisible" id="package_volume-error"></div>
                                        <div class="field-help mt-1">
                                            <span class="help-text">Help text</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label for="package_weight" class="form-label-sm font-sm">Weight (kg)</label>
                                        <span class="text-red-500 ml-1">*</span>
                                        <div class="field-help m-1">
                                            <div class="help-icon cursor-pointer">?</div>
                                            <div class="help-tooltip">
                                                Help text
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="flex items-center">
                                            <input type="number" id="package_weight" name="package_weight" class="form-input-sm w-full text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500 max-w-40" placeholder="Weight" required="required"/>
                                            <span class="mx-1">kg</span>
                                        </div>
                                        <div class="form-error invisible" id="package_weight-error"></div>
                                        <div class="field-help mt-1">
                                            <span class="help-text">Help text</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label for="carrier_id" class="form-label-sm font-sm">Carrier</label>
                                        <span class="text-red-500 ml-1">*</span>
                                        <div class="field-help m-1">
                                            <div class="help-icon cursor-pointer">?</div>
                                            <div class="help-tooltip">
                                                Help text
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <div>
                                            <select id="carrier_id" name="carrier_id" class="form-select-sm w-full text-sm" required="required">
                                                <option value="">Select carrier</option>
                                                <option value="1">DHL</option>
                                                <option value="2">FedEx</option>
                                                <option value="3">UPS</option>
                                            </select>
                                            <input type="text" id="carrier_name" name="carrier_name" class="form-input-sm w-full text-sm mt-2 rounded-md focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Carrier Name" required="required"/>
                                        </div>
                                        <div class="form-error invisible" id="carrier_id-error"></div>
                                        <div class="field-help mt-1">
                                            <span class="help-text">Help text</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label for="tracking_number" class="form-label-sm font-sm">Tracking Number</label>
                                        <span class="text-red-500 ml-1">*</span>
                                        <div class="field-help m-1">
                                            <div class="help-icon cursor-pointer">?</div>
                                            <div class="help-tooltip">
                                                Help text
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <input type="text" id="tracking_number" name="tracking_number" class="form-input-sm w-full text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Tracking Number" required="required"/>
                                        <div class="form-error invisible" id="tracking_number-error"></div>
                                        <div class="field-help mt-1">
                                            <span class="help-text">Help text</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label for="tracking_number_2" class="form-label-sm font-sm">Tracking Number 2</label>
                                        <span class="text-red-500 ml-1">*</span>
                                        <div class="field-help m-1">
                                            <div class="help-icon cursor-pointer">?</div>
                                            <div class="help-tooltip">
                                                Help text
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <input type="text" id="tracking_number_2" name="tracking_number_2" class="form-input-sm w-full text-sm rounded-md focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Tracking Number" required="required"/>
                                        <div class="form-error invisible" id="tracking_number_2-error"></div>
                                        <div class="field-help mt-1">
                                            <span class="help-text">Help text</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label for="schedule_date" class="form-label-sm font-sm">Schedule Date</label>
                                        <span class="text-red-500 ml-1">*</span>
                                        <div class="field-help m-1">
                                            <div class="help-icon cursor-pointer">?</div>
                                            <div class="help-tooltip">
                                                Help text
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="relative has-icon">
                                            <input type="text" id="schedule_date" class="form-input form-input-sm w-full datepicker focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Select date" required="required"/>
                                            <div class="validation-icon"><i class="fas fa-exclamation-circle"></i></div>
                                            <div class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none">
                                                <i class="fas fa-calendar-alt text-gray-400 text-xs"></i>
                                            </div>
                                        </div>
                                        <div class="form-error invisible" id="schedule_date-error"></div>
                                        <div class="field-help mt-1">
                                            <span class="help-text">Help text</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="mb-4">
                                        <p class="text-sm text-gray-600 dark:text-gray-400">Package Reception Products</p>
                                    </div>

                                    <div class="package-recepction-products-dynamic-lines-container">
                                        <div class="package-recepction-products-line-items-container">
                                            <!-- Line items will be added here by JavaScript -->
                                        </div>

                                        <div class="mt-3">
                                            <button id="package-recepction-add-line-btn" type="button" class="px-2 py-0.5 bg-cyan-600 text-white rounded-md hover:bg-cyan-700 transition-colors text-xs flex items-center">
                                                <i class="fas fa-plus mr-1.5"></i> Add Line
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button data-modal-close="true" class="modal-btn modal-btn-secondary mr-2">
                                <i class="fas fa-times"></i> Cancel
                            </button>
                            <button class="modal-btn modal-btn-primary" id="package-recepction-create-submit">
                                <i class="fas fa-save"></i> Save
                            </button>
                        </div>
                    </div>
                </div>

                <!-- File Upload Modal -->
                <div id="file-upload-modal" class="modal" data-outside-close="false">
                    <div class="modal-content max-w-lg w-full mx-auto">
                        <div class="modal-header">
                            <h3 class="text-lg font-sm text-gray-900 dark:text-gray-100">File Upload</h3>
                            <button data-modal-close="true" class="close-modal" aria-label="Close modal">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="modal-body">
                            <form class="form-flex">
                                <div class="form-group-flex">
                                    <label for="fileInput" class="form-label form-label-sm">Upload File</label>
                                    <div class="form-field-container">
                                        <div class="file-drop-area rounded-md border-2 border-dashed border-gray-300 dark:border-gray-600 p-4 text-center cursor-pointer">
                                            <input type="file" id="fileInput" name="fileInput" class="hidden focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" required="required" multiple="multiple"/>
                                            <div class="file-input-content">
                                                <i class="fas fa-cloud-upload-alt text-2xl text-gray-400 dark:text-gray-500"></i>
                                                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Drag and drop a file here, or <span class="text-cyan-600 dark:text-cyan-400 browse-link">browse</span></p>
                                                <p class="text-xs text-gray-500 dark:text-gray-500 mt-1">Maximum file size: 5MB</p>
                                            </div>
                                        </div>
                                        <div class="file-preview mt-3 flex flex-col items-center"></div>
                                        <div class="form-error" id="fileInputError">Please select a file to upload.</div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button data-modal-close="true" class="modal-btn modal-btn-secondary mr-2">
                                <i class="fas fa-times"></i> Cancel
                            </button>
                            <button class="modal-btn modal-btn-primary">
                                <i class="fas fa-save"></i> Upload
                            </button>
                        </div>
                    </div>
                </div>

            </t>

        </t>
    </template>

    <template id="portal_products_list" name="Portal Products List">
        <t t-foreach="products" t-as="product">
            <!-- Large screens row -->
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 hidden lg:table-row">
                <td t-if="batch_actions" class="px-3 py-4 whitespace-nowrap">
                    <input type="checkbox" class="product-checkbox h-4 w-4 text-cyan-600 border-gray-300 rounded focus:ring-cyan-500" t-att-data-product-id="product.id"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <img class="size-10 rounded-full" t-attf-src="/web/image/product.product/#{product.id}/image_128/50x50" t-att-alt="product.name"/>
                        </div>
                        <div class="ml-4">
                            <div class="text-sm font-medium text-gray-900 dark:text-gray-100" t-esc="product.name"/>
                            <div class="text-sm text-gray-500">ID: #<t t-esc="product.id"/></div>
                        </div>
                    </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100" t-esc="product.default_code"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100" t-esc="product.barcode"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <span t-attf-class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full #{product.qty_available > 0 and 'bg-green-100 text-green-800' or 'bg-red-100 text-red-800'}">
                        <t t-esc="product.qty_available > 0 and 'In Stock' or 'Out of Stock'"/>
                    </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <button t-attf-data-tooltip-target="tooltip-edit-#{product.id}" class="text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button t-attf-data-tooltip-target="tooltip-delete-#{product.id}" class="text-gray-600 hover:text-gray-900 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>

            <!-- Medium screens row -->
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 hidden md:table-row lg:hidden">
                <td t-if="batch_actions" class="px-3 py-4 whitespace-nowrap">
                    <input type="checkbox" class="product-checkbox h-4 w-4 text-cyan-600 border-gray-300 rounded focus:ring-cyan-500" t-att-data-product-id="product.id"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100" t-esc="product.name"/>
                    <div class="text-sm text-gray-500" t-esc="product.default_code"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <span t-attf-class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full #{product.qty_available > 0 and 'bg-green-100 text-green-800' or 'bg-red-100 text-red-800'}">
                        <t t-esc="product.qty_available > 0 and 'In Stock' or 'Out of Stock'"/>
                    </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <button t-attf-data-tooltip-target="tooltip-edit-#{product.id}" class="text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button t-attf-data-tooltip-target="tooltip-delete-#{product.id}" class="text-gray-600 hover:text-gray-900 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>

            <!-- Small screens row -->
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 table-row md:hidden">
                <td t-if="batch_actions" class="px-3 py-4 whitespace-nowrap">
                    <input type="checkbox" class="product-checkbox h-4 w-4 text-cyan-600 border-gray-300 rounded focus:ring-cyan-500" t-att-data-product-id="product.id"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900 dark:text-gray-100" t-esc="product.name"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <button t-attf-data-tooltip-target="tooltip-edit-#{product.id}" class="text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button t-attf-data-tooltip-target="tooltip-delete-#{product.id}" class="text-gray-600 hover:text-gray-900 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            </tr>
        </t>
    </template>

    <template id="portal_products_pager" name="Portal Products Pager">
        <!-- No results message -->
        <div class="sm:hidden" t-if="items_count == 0">
            <p class="text-xs text-gray-700 dark:text-gray-300 mb-2">
                <span class="font-medium">No results found</span>
            </p>
        </div>


        <!-- Mobile pagination controls -->
        <div class="sm:hidden" t-if="items_count > 0">
            <p class="text-xs text-gray-700 dark:text-gray-300 mb-2">
                <span class="font-medium">Showing 1-<span t-out="items_count"/></span> of <span class="font-medium" t-out="items_total"/> <span t-out="items_label"/>
            </p>
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <span class="sr-only">Previous</span>
                    <i class="fas fa-chevron-left"></i>
                </button>
                <t t-foreach="pages" t-as="page">
                    <button type="button" t-if="page.get('active')" class="z-10 bg-cyan-50 border-cyan-500 dark:border-cyan-500 text-cyan-600 dark:text-cyan-600 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                    <button type="button" t-else="" class="bg-white border-gray-300 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                </t>
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <span class="sr-only">Next</span>
                    <i class="fas fa-chevron-right"></i>
                </button>
            </nav>
        </div>

        <!-- Desktop pagination -->
        <div class="hidden sm:flex sm:items-center" t-if="items_count > 0">
            <p class="text-sm text-gray-700 dark:text-gray-300 mr-4">
                <span class="font-medium">Showing</span> <span class="font-medium">1-<span t-out="items_count"/></span> <span>of</span> <span class="font-medium" t-out="items_total"/> <span t-out="items_label"/> <span class="text-gray-500 ml-1"></span>
            </p>
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <span class="sr-only">Previous</span>
                    <i class="fas fa-chevron-left"></i>
                </button>
                <t t-foreach="pages" t-as="page">
                    <button t-if="page.get('active')" aria-current="page" class="z-10 bg-cyan-50 border-cyan-500 dark:border-cyan-500 text-cyan-600 dark:text-cyan-600 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                    <button t-else="" class="bg-white border-gray-300 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                </t>
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <span class="sr-only">Next</span>
                    <i class="fas fa-chevron-right"></i>
                </button>
            </nav>
        </div>
    </template>

</odoo>
