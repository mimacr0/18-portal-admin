<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_repair_alert_modal_template" name="Portal Create Repair Alert Modal">
        <!-- Sale Order Create Modal -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

        <!-- Select2 (si también usas esta librería) -->
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

        <div t-attf-id="page-#{page_name}-list-create-modal" class="modal" data-outside-close="false">
            <div class="modal-content max-w-2xl w-full mx-auto">
                <div class="modal-header">
                    <h3 class="text-lg font-sm text-gray-900 dark:text-gray-100">Repair Alert Create</h3>
                        <button data-modal-close="true" class="close-modal" aria-label="Close modal">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="modal-body">
                        <form t-attf-id="page-#{page_name}-list-create-form">
                            <!-- Contact Information -->
                            <label class="form-label-md font-md">Request Type</label>
                            <div class="form-group">
                                <div class="flex items-center">
                                    <label t-attf-for="page-#{page_name}-list-create-form-reception-ref" class="form-label-sm font-sm">Request Type</label>
                                    <span class="text-red-500 ml-1">*</span>
                                </div>
                                <div>
                                    <div class="flex gap-6 flex-wrap" id="page-#{page_name}-list-create-form-reception-ref">
                                        <label class="flex items-center">
                                            <input type="radio" name="reception_ref" value="return" required="1" class="form-radio text-cyan-500" />
                                            <span class="ml-2 text-sm">From Return</span>
                                        </label>
                                        <label class="flex items-center">
                                            <input type="radio" name="reception_ref" value="inventory" class="form-radio text-cyan-500" />
                                            <span class="ml-2 text-sm">Inventory</span>
                                        </label>
                                    </div>
                                    <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-reception-ref-error"></div>
                                </div>
                            </div>

                            <!--Client Additional Information-->

                            <label class="form-label-md font-md">Reception Info / Tracking Information</label>
                            <div class="form-group">
                                <div class="flex items-center">
                                    <label t-attf-for="page-#{page_name}-list-create-form-reception-ref" class="form-label-sm font-sm">Reception Ref</label>
                                    <span class="text-red-500 ml-1">*</span>
                                </div>
                                <div>
                                    <input type="text" name="reception_ref" t-attf-id="page-#{page_name}-list-create-form-reception-ref" required="required" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Reception Reference"/>
                                    <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-reception-ref-error"></div>
                                </div>
                            </div>

                            <label class="form-label-md font-md">Problem Description</label>
                            <div class="form-group">
                                <div class="flex items-center">
                                    <label t-attf-for="page-#{page_name}-list-create-form-problem" class="form-label-sm font-sm">Problem</label>
                                    <span class="text-red-500 ml-1">*</span>
                                </div>
                                <div>
                                    <input type="text" name="problem" t-attf-id="page-#{page_name}-list-create-form-problem" required="required" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Problem Description"/>
                                    <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-problem-error"></div>
                                </div>
                            </div>

                            <label class="form-label-md font-md">Product Data</label>
                            <div class="form-group">
                                <div class="flex items-center">
                                    <label t-attf-for="page-#{page_name}-list-create-form-product" class="form-label-sm font-sm">Product</label>
                                    <span class="text-red-500 ml-1">*</span>
                                </div>
                                <div>
                                    <input type="text" name="product" t-attf-id="page-#{page_name}-list-create-form-product" required="required" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Product"/>
                                    <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-product-error"></div>
                                </div>
                            </div>
                            <!-- Other Information -->

                            <div class="form-group">
                                <input name="products" type="hidden" t-attf-id="page-#{page_name}-list-create-form-products-list" required="required"/>

                                <div class="mb-4">
                                    <p class="form-label-sm font-sm">Products</p>
                                </div>

                                <div t-attf-id="page-#{page_name}-list-create-form-products-container">
                                    <div t-attf-id="page-#{page_name}-list-create-form-products-line-items-container"
                                        class="products-line-items-container">
                                    </div>

                                    <div class="mt-3 flex items-center gap-2">
                                        <button t-attf-id="page-#{page_name}-list-create-form-products-add-line-btn" type="button"
                                                class="px-2 py-0.5 bg-cyan-600 text-white rounded-md hover:bg-cyan-700 transition-colors text-xs flex items-center">
                                            <i class="fas fa-plus mr-1.5"></i> Add Product
                                        </button>
                                        <span class="ml-2 text-xs text-gray-500 italic">
                                            <i class="fas fa-info-circle"></i> Add products manually
                                        </span>
                                    </div>

                                </div>

                                <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-products-list-error"></div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer bg-gray-50 dark:bg-gray-800 px-6 py-4 flex justify-end rounded-b-lg border-t border-gray-200 dark:border-gray-700">
                        <button data-modal-close="true" class="modal-btn modal-btn-secondary mr-2">
                            <i class="fas fa-times"></i> Cancel
                        </button>
                        <button t-attf-id="page-#{page_name}-list-create-product-form-submit" class="modal-btn modal-btn-primary">
                            <i class="fas fa-save"></i> Save
                        </button>
                    </div>
                </div>
            </div>
    </template>
</odoo>