<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_repair_alert_modal_template" name="Portal Create Repair Alert Modal">
        <!-- Sale Order Create Modal -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <!-- Select2 (si también usas esta librería) -->
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
        <div t-attf-id="page-#{page_name}-list-create-modal" class="modal" data-outside-close="false">
            <div class="modal-content max-w-2xl w-full mx-auto">
                <div class="modal-header">
                    <h3 class="text-lg font-sm text-gray-900 dark:text-gray-100">Repair Alert Create</h3>
                        <button data-modal-close="true" class="close-modal" aria-label="Close modal">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="modal-body">
                        <form t-attf-id="page-#{page_name}-list-create-form">
                            <h1><label class="form-label-md font-md">Name</label></h1>
                            <div class="form-group">
                                <div class="flex items-center">
                                    <label t-attf-for="page-#{page_name}-list-create-form-name" class="form-label-sm font-sm">Name</label>
                                    <span class="text-red-500 ml-1">*</span>
                                </div>
                                <div>
                                    <input type="text" name="name" t-attf-id="page-#{page_name}-list-create-form-name" required="required" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus:ring-[#8A8A00] dark:focus:ring-[#A0A000]"/>
                                    <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-name-error"></div>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="flex items-center">
                                    <label t-attf-for="page-#{page_name}-list-create-form-maintenance-op" class="form-label-sm font-sm">Maintenance Operation</label>
                                    <span class="text-red-500 ml-1">*</span>
                                </div>
                                <div>
                                    <div class="flex gap-6 flex-wrap" id="page-#{page_name}-list-create-form-maintenance-op">
                                        <label class="flex items-center">
                                            <input type="radio" name="maintenance_op" value="repair" required="1" class="form-radio text-[#8A8A00]" style="accent-color: #8A8A00;"/>
                                            <span class="ml-2 text-sm">Repair</span>
                                        </label>
                                        <label class="flex items-center">
                                            <input type="radio" name="maintenance_op" value="review" class="form-radio text-[#8A8A00]" style="accent-color: #8A8A00;"/>
                                            <span class="ml-2 text-sm">Review</span>
                                        </label>
                                        <label class="flex items-center">
                                            <input type="radio" name="maintenance_op" value="renew" class="form-radio text-[#8A8A00]" style="accent-color: #8A8A00;"/>
                                            <span class="ml-2 text-sm">Renew</span>
                                        </label>
                                        <label class="flex items-center">
                                            <input type="radio" name="maintenance_op" value="warranty" class="form-radio text-[#8A8A00]" style="accent-color: #8A8A00;"/>
                                            <span class="ml-2 text-sm">Warranty</span>
                                        </label>
                                    </div>
                                    <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-maintenance-op-error"></div>
                                </div>
                            </div>
                            <!--Client Additional Information-->
                            <div class="form-group">
                                <div class="flex items-center">
                                    <label t-attf-for="page-#{page_name}-list-create-form-reception-ref" class="form-label-sm font-sm">Reception Ref</label>
                                    <span class="text-red-500 ml-1">*</span>
                                </div>
                                <div>
                                    <input type="text" name="reception_ref" t-attf-id="page-#{page_name}-list-create-form-reception-ref" required="required" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus:ring-[#8A8A00] dark:focus:ring-[#A0A000]" placeholder="Reception Reference"/>
                                    <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-reception-ref-error"></div>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="flex items-center">
                                    <label t-attf-for="page-#{page_name}-list-create-form-problem" class="form-label-sm font-sm">Problem</label>
                                    <span class="text-red-500 ml-1">*</span>
                                </div>
                                <div>
                                    <textarea 
                                        name="problem" 
                                        t-attf-id="page-#{page_name}-list-create-form-problem" 
                                        required="required" 
                                        class="w-full text-sm rounded-md border border-gray-300 focus:outline-none focus:ring-1 focus:ring-[#8A8A00] dark:focus:ring-[#A0A000] p-2 h-24" 
                                        placeholder="Problem Description"></textarea>
                                    <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-problem-error"></div>
                                </div>
                            </div>
                            <div class="form-group">
                                <input name="products" type="hidden" t-attf-id="page-#{page_name}-list-create-form-products-list" required="required"/>
                                <div class="mb-4">
                                    <p class="form-label-sm font-sm">Products</p>
                                </div>
                                <div t-attf-id="page-#{page_name}-list-create-form-products-container">
                                    <div t-attf-id="page-#{page_name}-list-create-form-products-line-items-container"
                                        class="products-line-items-container">
                                    </div>
                                    <div class="mt-3 flex items-center gap-2">
                                        <button t-attf-id="page-#{page_name}-list-create-form-products-add-line-btn" type="button"
                                                class="px-2 py-0.5 bg-[#696900] text-white rounded-md hover:bg-[#8A8A00] transition-colors text-xs flex items-center">
                                            <i class="fas fa-plus mr-1.5"></i> Add Product
                                        </button>
                                        <span class="ml-2 text-xs text-gray-500 italic">
                                            <i class="fas fa-info-circle"></i> Add products manually
                                        </span>
                                    </div>
                                </div>
                                <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-products-list-error"></div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer bg-gray-50 dark:bg-gray-800 px-6 py-4 flex justify-end rounded-b-lg border-t border-gray-200 dark:border-gray-700">
                        <button data-modal-close="true" class="modal-btn modal-btn-secondary mr-2">
                            <i class="fas fa-times"></i> Cancel
                        </button>
                        <button t-attf-id="page-#{page_name}-list-create-product-form-submit" class="modal-btn modal-btn-primary">
                            <i class="fas fa-save"></i> Save
                        </button>
                    </div>
                </div>
            </div>
    </template>
</odoo>