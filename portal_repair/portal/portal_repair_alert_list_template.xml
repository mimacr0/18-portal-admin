<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_repair_alert_page_main" name="Portal Repair Alert Page">
        <t t-call="portal_admin_theme.portal_admin_layout">
            <div class="w-full" t-attf-id="page-#{page_name}-main-container">
                <div class="card-title-container mb-4 flex items-center">
                    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Repair Alerts</h1>
                </div>
            </div>
            <!-- Barra de herramientas de acciones masivas: oculta por defecto, visible cuando se seleccionan elementos. -->
            <div id="bulk-actions-toolbar" class="bg-white rounded-lg shadow mb-4 p-3 hidden dark:bg-gray-800">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center">
                        <span id="selected-count" class="text-sm font-medium text-gray-700 dark:text-gray-300 mr-3">0 selected</span>
                        <div class="h-4 border-l border-gray-300 dark:border-gray-700 mr-3"></div>
                        <div class="flex flex-wrap gap-2">
                            <button t-foreach="batch_actions" t-as="batch_action" t-attf-id="page-list-#{page_name}-batch-action-#{batch_action.get('name')}" class="px-3 py-1 bg-red-600 text-white text-sm rounded hover:bg-red-700 transition-colors flex items-center">
                                <i t-attf-class="#{batch_action.get('icon')} mr-1.5"></i> <t t-out="batch_action.get('label')"/>
                            </button>
                        </div>
                    </div>
                    <button id="clear-selection" class="text-sm text-gray-600 hover:text-gray-800">
                        <i class="fas fa-times mr-1"></i> Clear selection
                    </button>
                </div>
            </div>
            <!-- Acciones rápidas de filtrado -->
            <t t-if="list_filters">
                <div class="border-b border-gray-200 dark:border-gray-700 mb-2">
                    <div class="flex overflow-x-auto scrollbar-hide">
                        <input type="hidden" t-attf-id="page-#{page_name}-list-quick-filter-active" value=""/>
                        <t t-foreach="list_filters" t-as="list_filter">
                            <button t-if="list_filter.get('active')" type="button" t-attf-id="page-#{page_name}-list-filter-#{list_filter.get('id')}" class="tab-button active px-6 py-3 text-sm font-medium border-b-2 border-[#8A8A00] text-[#696900] focus:outline-none transition-colors duration-200 ease-in-out dark:text-white relative">
                                <i t-attf-class="#{list_filter.get('icon')} mr-2"></i>
                                <t t-out="list_filter.get('label')"/>
                            </button>
                            <button t-else="" type="button" t-attf-id="page-#{page_name}-list-filter-#{list_filter.get('id')}" class="tab-button px-6 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 focus:outline-none transition-colors duration-200 ease-in-out dark:text-white dark:hover:text-gray-300 relative">
                                <i t-attf-class="#{list_filter.get('icon')} mr-2"></i>
                                <t t-out="list_filter.get('label')"/>
                            </button>
                        </t>
                    </div>
                </div>
            </t>
            <!-- Tabla de recepciones -->
            <div class="bg-white rounded-lg shadow overflow-hidden mb-20 dark:bg-gray-800">
                <div class="p-4 border-b border-gray-200 dark:border-gray-700">
                    <div class="flex flex-col lg:flex-row justify-between gap-4">
                        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                            <div class="flex items-center">
                                <button t-attf-id="launch-create-#{page_name}-form-button" class="px-3 py-1.5 bg-[#696900] text-white rounded-md hover:bg-[#8A8A00] transition-colors flex items-center">
                                    <i class="fas fa-plus mr-1.5"></i> <span class="hidden sm:inline">Create</span>
                                </button>
                            </div>
                        </div>
                        <div class="flex items-center justify-between gap-2">
                            <!-- Buscar entrada -->
                            <div class="relative flex-grow max-w-xs">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fas fa-search text-gray-400 dark:text-gray-500"></i>
                                </div>
                                <input type="text" t-attf-id="page-#{page_name}-list-quick-search" class="block w-full pl-10 pr-3 py-1.5 text-sm border border-gray-300 rounded-md focus:border-cyan-500 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Search ..."/>
                            </div>
                            <!-- Botón de búsqueda avanzada -->
                            <button t-if="advanced_search" t-attf-id="page-#{page_name}-list-advanced-search-toggle" data-tooltip-target="tooltip-advanced-search" class="p-2 border border-gray-300 rounded-md hover:bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-700 dark:hover:bg-gray-700 relative">
                                <i class="fas fa-sliders-h"></i>
                            </button>
                            <!-- Botones de acción-->
                            <div class="flex items-center">
                                <button t-foreach="tools_actions" t-as="tools_action" t-attf-data-tooltip-target="page-list-#{page_name}-tools-action-#{tools_action.get('name')}" t-attf-id="page-list-#{page_name}-tools-action-#{tools_action.get('name')}" class="p-2 rounded-md hover:bg-gray-100 text-gray-500 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-700 dark:hover:bg-gray-700 relative">
                                    <i t-att-class="tools_action.get('icon')"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <!-- Panel de búsqueda avanzada - oculto por defecto -->
                    <div t-attf-id="page-#{page_name}-list-advanced-search-panel" class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700 hidden">
                        <input type="hidden" t-attf-id="page-#{page_name}-list-advanced-search-domain" value="[]"/>
                        <input type="hidden" t-attf-id="page-#{page_name}-list-advanced-search-fields" t-att-value="advanced_search"/>
                        <h3 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Advanced Search</h3>
                        <!-- Filtro dinámico avanzado -->
                        <div class="w-full">
                            <!-- Match Type Selector -->
                            <div class="mb-4">
                                <p class="text-sm text-gray-700 dark:text-gray-300">
                                    <select t-attf-id="page-#{page_name}-list-advanced-search-match-type" class="inline-block mx-1 px-2 py-1 text-sm border border-gray-300 rounded-md shadow-sm focus:ring-cyan-500 focus:border-cyan-500 bg-white dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700">
                                        <option value="all" selected="selected">All</option>
                                        <option value="any">Any</option>
                                    </select>
                                    of the following conditions:
                                </p>
                            </div>
                            <!-- Contenedor de líneas de filtrado -->
                            <div t-attf-id="page-#{page_name}-list-advanced-search-lines-container" class="space-y-3"></div>
                            <!-- Botón de añadir línea de filtro -->
                            <div class="mt-3">
                                <button t-attf-id="page-#{page_name}-list-advanced-search-add-line-btn" class="flex items-center text-[#696900] hover:text-[#8A8A00] text-sm font-medium">
                                    <i class="fas fa-plus-circle mr-1.5"></i> Add filter condition
                                </button>
                            </div>
                        </div>
                        <!-- Botones de acción para la búsqueda avanzada -->
                        <div class="mt-4 flex justify-end space-x-3">
                            <button t-attf-id="page-#{page_name}-list-advanced-search-reset-btn" class="px-3 py-1 text-sm border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700 dark:hover:bg-gray-700">
                                Reset
                            </button>
                            <button t-attf-id="page-#{page_name}-list-advanced-search-apply-btn" class="px-3 py-1 text-sm bg-[#696900] text-white rounded-md shadow-sm hover:bg-[#8A8A00] dark:bg-[#696900] dark:text-white dark:hover:bg-[#8A8A00] dark:hover:text-white">
                                Apply Filters
                            </button>
                        </div>
                    </div>
                </div>
                <!-- Estructura de tabla para la lista de recepciones -->
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                        <thead class="bg-gray-50 dark:bg-gray-800">
                            <tr>
                                <th t-if="batch_actions" scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                    <div class="flex items-center">
                                        <input t-attf-id="page-#{page_name}-list-select-all-checkbox" type="checkbox" class="h-4 w-4 text-cyan-600 border-gray-300 rounded focus:ring-cyan-500 dark:border-gray-600 dark:bg-gray-700 dark:checked:bg-cyan-600 dark:checked:border-cyan-600"/>
                                    </div>
                                </th>
                                <t t-foreach="list_columns" t-as="list_column">
                                    <th t-if="list_column.get('sortable')" scope="col" t-attf-class="px-6 py-3 #{list_column.get('right') and 'text-right' or 'text-left'} text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider #{list_column.get('md') and 'hidden md:table-cell' or ''} #{list_column.get('lg') and 'hidden lg:table-cell' or ''}">
                                        <div class="flex items-center">
                                            <span t-out="list_column.get('label')"/>
                                            <i t-attf-id="list-column-#{page_name}-#{list_column.get('id')}-sort-icon" t-if="list_column.get('sortable')" class="fas fa-sort ml-1 text-gray-400"></i>
                                        </div>
                                    </th>
                                    <th t-else="" scope="col" t-attf-class="px-6 py-3 #{list_column.get('right') and 'text-right' or 'text-left'} text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                        <span t-out="list_column.get('label')"/>
                                    </th>
                                </t>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700" id="repair-alert-page-list-items"></tbody>
                    </table>
                </div>
            </div>
            <div class="w-full hidden" t-attf-id="page-#{page_name}-product-catalog-select">
                <!-- Products Page Header -->
                <div class="flex justify-between items-center mb-8 mt-5">
                    <div class="relative">
                        <button t-attf-id="page-#{page_name}-product-catalog-select-close-btn" class="px-3 py-1.5 bg-cyan-600 text-white rounded-md hover:bg-cyan-700 transition-colors flex items-center">
                            <i class="fas fa-arrow-left mr-1.5"></i> Go Back
                        </button>
                    </div>
                    <div class="relative max-w-md w-full">
                        <input type="text" t-attf-id="page-#{page_name}-product-catalog-select-search" class="bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white text-sm rounded-full shadow-md focus:ring-cyan-500 focus:border-cyan-500 block w-full p-3.5 pl-12 pr-12" placeholder="Search products..."/>
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="fas fa-search text-gray-400"></i>
                        </div>
                    </div>
                </div>
                <!-- Selected products preview -->
                <div t-attf-id="page-#{page_name}-product-catalog-select-selected-products-container" class="mb-4 bg-white dark:bg-gray-800 rounded-md shadow overflow-hidden text-sm">
                    <div class="bg-gradient-to-r from-cyan-500 to-cyan-600 dark:from-cyan-800 dark:to-cyan-900 px-3 py-2">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <i class="fas fa-shopping-cart text-white text-xs mr-2"></i>
                                <h2 class="text-sm font-semibold text-white">Selected Products</h2>
                                <span id="selected-count" class="ml-2 bg-white text-cyan-700 dark:bg-gray-700 dark:text-cyan-300 text-xs font-bold px-2 py-0.5 rounded-full">0</span>
                            </div>
                            <div>
                                <button t-attf-id="page-#{page_name}-product-catalog-select-clear-selection-btn" class="text-white hover:text-gray-200 transition-colors text-xs">
                                    <i class="fas fa-trash-alt mr-1"></i> Clear
                                </button>
                            </div>
                        </div>
                    </div>
                    <div t-attf-id="page-#{page_name}-product-catalog-select-no-products-message" class="p-3 text-center text-xs">
                        <i class="fas fa-box-open text-gray-400 dark:text-gray-500 text-lg mb-1"></i>
                        <p class="text-gray-500 dark:text-gray-400">No products selected</p>
                        <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">Add products using the "Add" button</p>
                    </div>
                    <div t-attf-id="page-#{page_name}-product-catalog-select-selected-products-list" class="hidden max-h-80 overflow-y-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3 p-3"></div>
                </div>
                <!-- Products Content -->
                <div class="flex flex-col md:flex-row mb-4">
                    <div t-attf-id="page-#{page_name}-product-catalog-select-products-grid" class="product-catalog-list w-full grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3"></div>
                </div>
                <!-- Pagination -->
                <div t-attf-id="page-#{page_name}-product-catalog-select-pagination" class="fixed bottom-0 right-0 z-10 mr-6 mb-6"></div>
            </div>
            <div class="fixed bottom-0 right-0 z-10 mr-6 mb-6" t-attf-id="page-#{page_name}-list-pagination-container-main">
                <input type="hidden" t-attf-id="page-#{page_name}-list-pagination-page" value="1"/>
                <div class="pagination-container px-4 py-3 bg-white border border-gray-200 dark:bg-gray-800 dark:border-gray-700 rounded-lg shadow-lg flex items-center justify-between" t-attf-id="page-#{page_name}-list-pagination-container"></div>
            </div>
            <div class="h-25"></div>
            <t t-set="footer_content">
                <t t-call="portal_repair.portal_repair_alert_modal_template"/>
            </t>
        </t>
    </template>

    <template id="portal_repair_alert_list" name="Portal Receptions List">
        <t t-foreach="alerts" t-as="alert">
            <!-- Fila de pantallas grandes -->
            <tr class="hover:bg-gray-100 dark:hover:bg-gray-700 hidden lg:table-row">
                <td class="px-3 py-4 whitespace-nowrap">
                    <input type="checkbox" class="repair-alerts-list-checkbox h-4 w-4 text-cyan-600 border-gray-300 rounded focus:ring-cyan-500" t-att-data-alert-id="alert.id"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100">Title: <t t-out="alert.title"/></div>
                    <div class="text-sm text-gray-900 dark:text-gray-100">Name: <t t-out="alert.name"/></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100">Current stage: <t t-out="alert.stage_id.name"/></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100">Product: <t t-out="alert.product_id.display_name"/></div>
                    <div class="text-sm text-gray-900 dark:text-gray-100">Lot: <t t-out="alert.lot_id.display_name"/></div>
                    <div class="text-sm text-gray-900 dark:text-gray-100">State: <t t-out="alert.lot_id.lifecycle_state"/></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <table class="w-full border-collapse border-0">
                        <tr t-foreach="alert.repair_order_ids" t-as="order">
                            <t t-if="order.state == 'done'">
                                <div class="text-sm text-gray-900 dark:text-gray-100">Type: <t t-out="order.maintenance_type"/></div>

                                <td class="px-4 py-2">
                                    <div class="text-sm text-gray-900 dark:text-gray-100">
                                        Result: <t t-esc="', '.join([r.name for r in order.result_ids])"/>
                                    </div>
                                    <div class="text-sm text-gray-900 dark:text-gray-100">
                                        Diagnostic: <t t-esc="', '.join([d.name for d in order.diagnosis_ids])"/>
                                    </div>
                                </td>
                            </t>
                        </tr>
                    </table>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <a t-att-href="alert.get_details_url()" t-attf-data-tooltip-target="tooltip-details-#{alert.id}" class="text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-info-circle"></i>
                    </a>
                    <!-- <button t-attf-data-tooltip-target="tooltip-edit-#{alert.id}" class="text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-edit"></i>
                    </button> -->
                    <!-- <button t-attf-data-tooltip-target="tooltip-delete-#{alert.id}" class="text-gray-600 hover:text-gray-900 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-trash"></i>
                    </button> -->
                </td>
            </tr>
        </t>
    </template>

    <template id="portal_repair_alert_pager" name="Portal Repair Alert Pager">
        <!-- No hay resultados -->
        <div class="sm:hidden" t-if="items_count == 0">
            <p class="text-xs text-gray-700 dark:text-gray-300 mb-2">
                <span class="font-medium">No results found</span>
            </p>
        </div>
        <!-- Controles de paginación móviles -->
        <div class="sm:hidden" t-if="items_count > 0">
            <p class="text-xs text-gray-700 dark:text-gray-300 mb-2">
                <span class="font-medium">Showing 1-<span t-out="items_count"/></span> of <span class="font-medium" t-out="items_total"/> <span t-out="items_label"/>
            </p>
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <span class="sr-only">Previous</span>
                    <i class="fas fa-chevron-left"></i>
                </button>
                <t t-foreach="pages" t-as="page">
                    <button type="button" t-if="page.get('active')" class="z-10 bg-cyan-50 dark:bg-gray-800 border-cyan-500 dark:border-cyan-500 text-cyan-600 dark:text-cyan-600 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                    <button type="button" t-else="" class="bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                </t>
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <span class="sr-only">Next</span>
                    <i class="fas fa-chevron-right"></i>
                </button>
            </nav>
        </div>
        <!-- Paginación de escritorio -->
        <div class="hidden sm:flex sm:items-center" t-if="items_count > 0">
            <p class="text-sm text-gray-700 dark:text-gray-300 mr-4">
                <span class="font-medium">Showing</span> <span class="font-medium">1-<span t-out="items_count"/></span> <span>of</span> <span class="font-medium" t-out="items_total"/> <span t-out="items_label"/> <span class="text-gray-500 ml-1"></span>
            </p>
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700" id="stock-list-pagination-previous">
                    <span class="sr-only">Previous</span>
                    <i class="fas fa-chevron-left"></i>
                </button>
                <t t-foreach="pages" t-as="page">
                    <button t-if="page.get('active')" aria-current="page" t-att-data-page="page.get('page')" class="repair-alert-list-pagination-button z-10 bg-[#f0f0e0] dark:bg-gray-800 border-cyan-500 dark:border-[#8A8A00] text-[#696900] dark:text-[#696900] relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                    <button t-else="" t-att-data-page="page.get('page')" class="repair-alert-list-pagination-button bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                </t>
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700" id="stock-list-pagination-next">
                    <span class="sr-only">Next</span>
                    <i class="fas fa-chevron-right"></i>
                </button>
            </nav>
        </div>
    </template>

</odoo>
