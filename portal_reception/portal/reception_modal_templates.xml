<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Package Create Modal -->
    <template id="reception_create_modal">
        <div t-attf-id="page-#{page_name}-list-create-modal" class="modal" data-outside-close="false">
            <div class="modal-content max-w-2xl max-h-[95vh] rounded-2xl flex flex-col mx-auto my-auto shadow-2xl border border-gray-100 dark:border-gray-700 overflow-hidden">
                <div class="modal-header bg-white dark:bg-gray-800 px-6 py-4 flex justify-between items-center border-b border-gray-100 dark:border-gray-700">
                    <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100" t-attf-id="page-#{page_name}-list-create-modal-title">Create Package Reception</h3>
                    <button data-modal-close="true" class="close-modal" aria-label="Close modal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body overflow-y-auto flex-1 p-0">
                    <!-- Step Progress Indicator -->
                    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
                        <div class="flex items-center justify-between max-w-md mx-auto">
                            <div class="flex flex-col items-center">
                                <div id="step-indicator-1" class="w-8 h-8 rounded-full bg-theme text-white flex items-center justify-center text-sm font-bold border-2 border-theme">1</div>
                                <span class="text-[10px] mt-1 font-medium text-theme uppercase">General</span>
                            </div>
                            <div class="flex-1 h-0.5 bg-gray-200 mx-2 -mt-4"></div>
                            <div class="flex flex-col items-center">
                                <div id="step-indicator-2" class="w-8 h-8 rounded-full bg-white text-gray-400 flex items-center justify-center text-sm font-bold border-2 border-gray-200">2</div>
                                <span class="text-[10px] mt-1 font-medium text-gray-400 uppercase">Addresses</span>
                            </div>
                            <div class="flex-1 h-0.5 bg-gray-200 mx-2 -mt-4"></div>
                            <div class="flex flex-col items-center">
                                <div id="step-indicator-3" class="w-8 h-8 rounded-full bg-white text-gray-400 flex items-center justify-center text-sm font-bold border-2 border-gray-200">3</div>
                                <span class="text-[10px] mt-1 font-medium text-gray-400 uppercase">Summary</span>
                            </div>

                        </div>
                    </div>

                    <form t-attf-id="page-#{page_name}-list-create-form" class="p-6">
                        <!-- Hidden fields -->
                         <input type="hidden" t-attf-id="page-#{page_name}-list-create-form-reception-id"/>
                         <input type="hidden" name="packages_data" id="reception-packages-data-input" value="[]"/>
                         <input type="hidden" name="type" id="reception-type-input" value="return"/>
                        
                        <!-- STEP 1: PACKAGES & ADDRESSES -->
                        <div id="reception-create-step-1" class="step-content space-y-6">
                            
                            <!-- Countries Section -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-blue-50/30 p-4 rounded-xl border border-blue-100/50">
                                <!-- Origin Country -->
                                <div class="form-group mb-0">
                                    <label class="form-label-sm font-semibold flex items-center text-blue-800">
                                        <i class="fas fa-globe-americas mr-2 text-blue-500"></i> Origin Country
                                        <span class="text-red-500 ml-1">*</span>
                                    </label>
                                    <div class="mt-1">
                                        <select name="sender_country_id" t-attf-id="page-#{page_name}-list-create-form-sender-country-id" class="form-input-sm w-full rounded-lg border-gray-200 focus:ring-theme">
                                            <option value="">— Select Origin —</option>
                                            <t t-foreach="countries" t-as="country">
                                                <option t-att-value="country.id" t-esc="country.name" t-att-selected="country.code == 'ES'"/>
                                            </t>
                                        </select>
                                    </div>
                                </div>

                                <!-- Destination Country -->
                                <div class="form-group mb-0">
                                    <label class="form-label-sm font-semibold flex items-center text-blue-800">
                                        <i class="fas fa-map-marker-alt mr-2 text-blue-500"></i> Destination Country
                                        <span class="text-red-500 ml-1">*</span>
                                    </label>
                                    <div class="mt-1">
                                        <select name="receiver_country_id" t-attf-id="page-#{page_name}-list-create-form-receiver-country-id" class="form-input-sm w-full rounded-lg border-gray-200 focus:ring-theme bg-gray-50 cursor-not-allowed">
                                            <t t-foreach="countries.filtered(lambda c: c.code == 'ES')" t-as="country">
                                                <option t-att-value="country.id" t-esc="country.name" selected="selected"/>
                                            </t>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <hr class="border-gray-100"/>

                            <!-- Dynamic Packages Section -->
                            <div class="space-y-4">
                                <div class="flex items-center justify-between">
                                    <h4 class="text-sm font-bold text-gray-800 flex items-center">
                                        <i class="fas fa-boxes mr-2 text-theme"></i> Bulto Details
                                    </h4>
                                    <!-- <button type="button" id="reception-add-package-btn" class="text-xs font-semibold px-3 py-1.5 bg-theme-light text-primary-theme rounded-lg hover:bg-primary-theme hover:text-white transition-all flex items-center border border-primary-theme/10">
                                        <i class="fas fa-plus-circle mr-1.5"></i> Extra Bulto
                                    </button> -->
                                </div>

                                <div id="reception-packages-list-container" class="space-y-3">
                                    <!-- Package Items will be injected by JS -->
                                    <div class="package-item bg-white border border-theme-light rounded-xl p-4 shadow-sm relative overflow-hidden group">
                                        <div class="absolute top-0 left-0 w-1 h-full bg-theme"></div>
                                        <div class="flex items-center justify-between mb-3">
                                            <span class="text-xs font-bold text-theme uppercase tracking-wider">Bulto #1</span>
                                            <span class="text-[10px] text-gray-400 bg-gray-50 px-2 py-0.5 rounded border border-gray-100">Default</span>
                                        </div>
                                        <div class="mb-4">
                                            <label class="text-[9px] font-bold text-gray-400 uppercase flex items-center">
                                                <i class="fas fa-tag mr-1.5 text-gray-300"></i> Content / Product Name
                                            </label>
                                            <input type="text" name="pkg_product_name[]" class="form-input-sm w-full pkg-product-name rounded-lg border-gray-100" placeholder="e.g. Xiaomi Mi 11 Ultra..."/>
                                        </div>
                                        <div class="grid grid-cols-2 gap-3 mb-3">
                                            <div class="space-y-1">
                                                <label class="text-[9px] font-bold text-gray-400 uppercase flex items-center">
                                                    <i class="fas fa-cubes mr-1 text-gray-300"></i> Units
                                                </label>
                                                <input type="number" step="1" min="1" name="pkg_units[]" class="form-input-sm w-full pkg-units rounded-lg border-gray-100" value="1"/>
                                            </div>
                                            <div class="space-y-1">
                                                <label class="text-[9px] font-bold text-gray-400 uppercase flex items-center">
                                                    <i class="fas fa-weight-hanging mr-1 text-gray-300"></i> Weight (kg) *
                                                </label>
                                                <input type="number" step="0.01" min="0.1" name="pkg_weight[]" class="form-input-sm w-full pkg-weight rounded-lg border-gray-100" value="1.00"/>
                                            </div>
                                        </div>
                                        <div class="grid grid-cols-3 gap-3">
                                            <div class="space-y-1">
                                                <label class="text-[9px] font-bold text-gray-400 uppercase">Length (cm)</label>
                                                <input type="number" step="1" min="1" name="pkg_length[]" class="form-input-sm w-full pkg-length" value="10"/>
                                            </div>
                                            <div class="space-y-1">
                                                <label class="text-[9px] font-bold text-gray-400 uppercase">Width (cm)</label>
                                                <input type="number" step="1" min="1" name="pkg_width[]" class="form-input-sm w-full pkg-width" value="10"/>
                                            </div>
                                            <div class="space-y-1">
                                                <label class="text-[9px] font-bold text-gray-400 uppercase">Height (cm)</label>
                                                <input type="number" step="1" min="1" name="pkg_height[]" class="form-input-sm w-full pkg-height" value="10"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Bottom Add Button Area -->
                                <div class="flex justify-center py-2">
                                    <button type="button" id="reception-add-package-btn-bottom" class="text-xs font-semibold px-6 py-2 bg-white text-primary-theme rounded-xl hover:bg-theme-light transition-all flex items-center border-2 border-dashed border-theme-light group w-full justify-center">
                                        <i class="fas fa-plus-circle mr-2 text-theme group-hover:scale-110 transition-transform"></i> 
                                        <span>Add Another Bulto</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Notes -->
                            <div class="form-group">
                                <label class="form-label-sm font-semibold flex items-center">
                                    <i class="fas fa-sticky-note mr-2 text-theme"></i> Reception Notes
                                </label>
                                <textarea name="notes" class="form-input-sm w-full mt-1 rounded-lg border-gray-200" rows="1" placeholder="Add any special instructions..."></textarea>
                            </div>

                            <!-- Carrier Estimates Section (Step 1) -->
                            <div id="reception-step1-carriers-section" class="hidden space-y-4 pt-4 border-t border-gray-100 animate-fade-in">
                                <div class="flex items-center justify-between">
                                    <h4 class="text-sm font-bold text-gray-800 flex items-center">
                                        <i class="fas fa-shipping-fast mr-2 text-theme"></i> Available Carriers
                                    </h4>
                                    <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Select One</span>
                                </div>
                                <div id="reception-step1-carriers-list" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    <!-- Carriers cards will be injected here -->
                                </div>
                            </div>
                        </div>

                        <!-- STEP 2: ADDRESSES (Hidden) -->
                        <div id="reception-create-step-2" class="step-content hidden animate-fade-in space-y-6">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <!-- Sender details -->
                                <div class="space-y-4 p-4 rounded-xl border border-gray-100 bg-gray-50/30">
                                    <h5 class="text-xs font-bold text-gray-700 uppercase flex items-center">
                                        <i class="fas fa-sign-out-alt mr-2 text-theme"></i> Sender Details
                                    </h5>
                                    <input type="hidden" name="sender_id" id="reception-sender-address-id" value=""/>
                                        <div class="relative">
                                            <input type="text" id="reception-sender-search" placeholder="Search by name, email or phone..." class="form-input-sm w-full rounded-lg border-gray-200 pr-8"/>
                                            <i class="fas fa-search absolute right-3 top-1/2 -translate-y-1/2 text-gray-300 text-xs pointer-events-none"></i>
                                        </div>
                                        <div id="reception-sender-search-results" class="hidden mt-1 max-h-40 overflow-y-auto rounded-lg border border-gray-100 bg-white shadow-lg z-50"></div>
                                        
                                       
                                        <div id="reception-sender-selected-badge" class="hidden mt-2 flex items-center gap-2 bg-green-50 border border-green-200 rounded-lg px-3 py-1.5">
                                            <i class="fas fa-check-circle text-green-500 text-xs"></i>
                                            <span id="reception-sender-selected-name" class="text-xs font-semibold text-green-700"></span>
                                            <button type="button" id="reception-sender-clear-btn" class="ml-auto text-gray-400 hover:text-red-500 transition-all text-xs">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                        <p class="text-[10px] text-gray-400 mt-1"><i class="fas fa-info-circle mr-1"></i>Leave empty to create a new sender with the fields below.</p>
                                    <div class="grid grid-cols-1 gap-3">
                                     <!-- Country Display (Read-only) -->
                                  
                                        <!-- Zip Search -->
                                        <div class="grid grid-cols-1">
                                            <label class="text-[10px] font-bold text-theme uppercase">Zip/City Search</label>
                                            <div class="relative">
                                                <input type="text" id="reception-sender-zip-search" placeholder="Quick zip/city finder..." class="form-input-sm w-full rounded-lg border-theme/20 focus:border-theme pr-8"/>
                                                <i class="fas fa-map-pin absolute right-3 top-1/2 -translate-y-1/2 text-theme-light text-xs pointer-events-none"></i>
                                            </div>
                                            <div id="reception-sender-zip-results" class="hidden absolute left-0 right-0 mt-1 max-h-40 overflow-y-auto rounded-lg border border-gray-100 bg-white shadow-xl z-[60]"></div>
                                        </div>

                                        <input type="text" name="sender_name" placeholder="Contact Name" class="form-input-sm w-full rounded-lg border-gray-100"/>
                                        <input type="text" name="sender_street" placeholder="Street" class="form-input-sm w-full rounded-lg border-gray-100"/>
                                        <div class="grid grid-cols-2 gap-2">
                                            <input type="text" name="sender_city" placeholder="City" class="form-input-sm w-full rounded-lg border-gray-100"/>
                                            <input type="text" name="sender_zip" placeholder="ZIP Code" class="form-input-sm w-full rounded-lg border-gray-100"/>
                                        </div>
                                        <div class="grid grid-cols-1">
                                            <input type="text" name="sender_state_name" placeholder="Province / State" class="form-input-sm w-full rounded-lg border-gray-100"/>
                                            <input type="hidden" name="sender_state_id" value=""/>
                                        </div>
                                        <div class="grid grid-cols-1">
                                            <input type="text" id="reception-sender-country-name-display" placeholder="Country" class="form-input-sm w-full rounded-lg border-gray-100 bg-gray-50 cursor-not-allowed" readonly="readonly" value="Spain"/>
                                        </div>

                                        <div class="grid grid-cols-2 gap-2">
                                            <input type="email" name="sender_email" placeholder="Email" class="form-input-sm w-full rounded-lg border-gray-100"/>
                                            <input type="text" name="sender_phone" placeholder="Phone" class="form-input-sm w-full rounded-lg border-gray-100"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Receiver details -->
                                <div class="space-y-4 p-4 rounded-xl border border-gray-100 bg-gray-50/30">
                                    <h5 class="text-xs font-bold text-gray-700 uppercase flex items-center">
                                        <i class="fas fa-sign-in-alt mr-2 text-theme"></i> Shipping To
                                    </h5>
                                    
                                    <!-- Country Display (Read-only) -->
                                    <div class="grid grid-cols-1 gap-3">
                                        <!-- Zip Search -->
                                        <div class="grid grid-cols-1">
                                            <label class="text-[10px] font-bold text-theme uppercase">Zip/City Search</label>
                                            <div class="relative">
                                                <input type="text" id="reception-receiver-zip-search" placeholder="Quick zip/city finder..." class="form-input-sm w-full rounded-lg border-theme/20 focus:border-theme pr-8"/>
                                                <i class="fas fa-map-pin absolute right-3 top-1/2 -translate-y-1/2 text-theme-light text-xs pointer-events-none"></i>
                                            </div>
                                            <div id="reception-receiver-zip-results" class="hidden absolute left-0 right-0 mt-1 max-h-40 overflow-y-auto rounded-lg border border-gray-100 bg-white shadow-xl z-[60]"></div>
                                        </div>
                                        <input type="text" name="receiver_name" placeholder="Receiver Name" class="form-input-sm w-full rounded-lg border-gray-100" t-att-value="company.name"/>
                                        <input type="text" name="receiver_street" placeholder="Street" class="form-input-sm w-full rounded-lg border-gray-100" t-att-value="company.street"/>
                                        <div class="grid grid-cols-2 gap-2">
                                            <input type="text" name="receiver_city" placeholder="City" class="form-input-sm w-full rounded-lg border-gray-100" t-att-value="company.city"/>
                                            <input type="text" name="receiver_zip" placeholder="ZIP Code" class="form-input-sm w-full rounded-lg border-gray-100" t-att-value="company.zip"/>
                                        </div>
                                        <div class="grid grid-cols-1">
                                            <input type="text" name="receiver_state_name" placeholder="Province / State" class="form-input-sm w-full rounded-lg border-gray-100" t-att-value="company.state_id.name"/>
                                            <input type="hidden" name="receiver_state_id" t-att-value="company.state_id.id"/>
                                        </div>
                                        <div class="grid grid-cols-1">
                                            <input type="text" id="reception-receiver-country-name-display" placeholder="Country" class="form-input-sm w-full rounded-lg border-gray-100 bg-gray-50 cursor-not-allowed" readonly="readonly" value="Spain"/>
                                        </div>
                                        <div class="grid grid-cols-2 gap-2">
                                            <input type="email" name="receiver_email" placeholder="Email" class="form-input-sm w-full rounded-lg border-gray-100" t-att-value="company.email"/>
                                            <input type="text" name="receiver_phone" placeholder="Phone" class="form-input-sm w-full rounded-lg border-gray-100" t-att-value="company.phone"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- STEP 3: SUMMARY (Hidden) -->
                        <div id="reception-create-step-3" class="step-content hidden animate-fade-in space-y-6">
                            <div class="bg-white rounded-xl border border-gray-100 overflow-hidden shadow-sm">
                                <div class="bg-gray-50 px-6 py-4 border-b border-gray-100">
                                    <h4 class="text-sm font-bold text-gray-800 flex items-center">
                                        <i class="fas fa-clipboard-check mr-2 text-green-500"></i> Reception Summary
                                    </h4>
                                </div>
                                <div class="p-6">
                                    <div id="reception-summary-content" class="space-y-4">
                                        <!-- Summary content will be injected by JS -->
                                        <div class="flex items-center justify-center py-10">
                                            <i class="fas fa-spinner fa-spin text-theme text-2xl"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <input type="hidden" name="carrier_id" id="reception-selected-carrier-id"/>
                    </form>
                </div>


                <div class="modal-footer bg-gray-50 dark:bg-gray-800 px-6 py-4 flex justify-between items-center rounded-b-lg border-t border-gray-200 dark:border-gray-700">
                    <div>
                        <button id="reception-create-back-btn" class="modal-btn modal-btn-secondary d-none">
                            <i class="fas fa-arrow-left mr-1"></i> Back
                        </button>
                    </div>
                    <div class="flex gap-2">
                        <button id="reception-create-next-btn" class="modal-btn modal-btn-primary">
                            <span>Next</span> <i class="fas fa-arrow-right ml-1"></i>
                        </button>
                        <button id="reception-create-submit-btn" class="modal-btn modal-btn-primary d-none">
                            <i class="fas fa-check-circle mr-1"></i> Create Reception
                        </button>
                        <button id="reception-create-new-btn" class="modal-btn modal-btn-primary d-none">
                            <i class="fas fa-plus mr-1"></i> New Reception
                        </button>
                        <button data-modal-close="true" id="reception-create-exit-btn" class="modal-btn modal-btn-secondary d-none">
                            <i class="fas fa-door-open mr-1"></i> Exit
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Add Sender Modal -->
    <template id="reception_add_sender_modal">
        <div t-attf-id="page-#{page_name}-add-sender-modal" class="modal" data-outside-close="false">
            <div class="modal-content max-w-md w-full mx-auto mt-20">
                <div class="modal-header">
                    <h3 class="text-lg font-sm">Add New Sender Address</h3>
                    <button type="button" class="close-modal" data-modal-close="true">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body p-4">
                    <div class="form-group mb-4">
                        <label class="block text-sm font-medium mb-1">Name</label>
                        <input type="text" id="new_sender_name" class="form-input-sm w-full border rounded p-2" required="1"/>
                    </div>
                    <div class="form-group mb-4">
                        <label class="block text-sm font-medium mb-1">Street</label>
                        <input type="text" id="new_sender_street" class="form-input-sm w-full border rounded p-2"/>
                    </div>
                    <div class="form-group mb-4 flex gap-4">
                        <div class="w-1/2">
                            <label class="block text-sm font-medium mb-1">City</label>
                            <input type="text" id="new_sender_city" class="form-input-sm w-full border rounded p-2"/>
                        </div>
                        <div class="w-1/2">
                            <label class="block text-sm font-medium mb-1">Zip</label>
                            <input type="text" id="new_sender_zip" class="form-input-sm w-full border rounded p-2"/>
                        </div>
                    </div>
                    <div class="form-group mb-4">
                        <label class="block text-sm font-medium mb-1">Country</label>
                        <select id="new_sender_country_id" class="form-input-sm w-full border rounded p-2">
                            <option value="">Select Country...</option>
                            <t t-foreach="countries" t-as="country">
                                <option t-att-value="country.id" t-esc="country.name"/>
                            </t>
                        </select>
                    </div>
                </div>
                <div class="modal-footer p-4 flex justify-end gap-2 bg-gray-50 border-t">
                    <button type="button" class="px-3 py-1.5 border rounded" data-modal-close="true">Cancel</button>
                    <button type="button" class="px-3 py-1.5 btn-primary text-white rounded" id="btn_save_new_sender">Save Address</button>
                </div>
            </div>
        </div>
    </template>

    <!-- Details Add Sender Modal -->
    <template id="reception_details_add_sender_modal">
        <div id="new-sender-address-modal" class="hidden fixed inset-0 z-[60] overflow-y-auto">
            <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
                <div class="fixed inset-0 transition-opacity" aria-hidden="true">
                    <div class="absolute inset-0 bg-gray-500 opacity-75"></div>
                </div>
                <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
                <div class="inline-block align-bottom bg-white dark:bg-gray-800 rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
                    <div class="bg-white dark:bg-gray-800 px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                        <h3 class="text-lg leading-6 font-medium text-gray-900 dark:text-white mb-4">Add New Sender Address</h3>
                        <form id="new-sender-address-form" class="space-y-4">
                            <div class="grid grid-cols-1 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Name</label>
                                    <input type="text" name="name" required="1" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-primary-theme focus:border-primary-theme sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"/>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Email</label>
                                    <input type="email" name="email" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-primary-theme focus:border-primary-theme sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"/>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Phone</label>
                                    <input type="text" name="phone" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-primary-theme focus:border-primary-theme sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"/>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Street</label>
                                    <input type="text" name="street" required="1" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-primary-theme focus:border-primary-theme sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"/>
                                </div>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">City</label>
                                        <input type="text" name="city" required="1" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-primary-theme focus:border-primary-theme sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"/>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Zip</label>
                                        <input type="text" name="zip" required="1" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-primary-theme focus:border-primary-theme sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white"/>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Country</label>
                                    <select name="country_id" required="1" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-primary-theme focus:border-primary-theme sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                                        <t t-foreach="countries" t-as="country">
                                            <option t-att-value="country.id" t-esc="country.name"/>
                                        </t>
                                    </select>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="bg-gray-50 dark:bg-gray-700 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                        <button type="button" id="submit-new-sender-address" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-primary-theme  text-base font-medium text-white hover:bg-theme-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-theme sm:ml-3 sm:w-auto sm:text-sm">Save Address</button>
                        <button type="button" id="close-new-sender-address-modal" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-theme sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </template>

