<?xml version="1.0" encoding="utf-8"?>
<odoo>



    <!-- Stock Selector Modal -->
    <template id="rma_stock_selector_modal">
        <div id="rma-stock-selector-modal" class="modal" data-outside-close="false">
            <div class="modal-content max-w-4xl w-full mx-auto max-h-[90vh] flex flex-col">
                <div class="modal-header">
                    <h3 class="text-lg font-semibold">Select from Inventory</h3>
                    <button type="button" class="close-modal" data-modal-close="true">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body overflow-y-auto flex-1 p-4 bg-gray-50 dark:bg-gray-900 border-y border-gray-200 dark:border-gray-700">
                    <div class="mb-4 sticky top-0 bg-gray-50 dark:bg-gray-900 z-10 pb-2">
                        <div class="relative">
                            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                            <input type="text" id="rma-stock-search" 
                                   class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700 dark:bg-gray-800 focus:ring-2 focus:ring-theme focus:border-theme outline-none transition-all"
                                   placeholder="Search by Product Name or Code..."/>
                        </div>
                    </div>
                    
                    <div id="rma-stock-kanban-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
                        <div class="col-span-full py-20 text-center text-gray-500">
                            <i class="fas fa-spinner fa-spin text-3xl mb-4"></i>
                            <p>Loading inventory...</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer flex justify-end p-4">
                    <button type="button" data-modal-close="true" class="modal-btn modal-btn-secondary">
                        <i class="fas fa-times mr-1.5"></i> Close
                    </button>
                </div>
            </div>
        </div>
    </template>

    <!-- Product Mapping Creation Modal -->
    <template id="rma_product_mapping_modal">
        <div id="rma-product-mapping-modal" class="modal" data-outside-close="false">
            <div class="modal-content max-w-md w-full mx-auto">
                <div class="modal-header">
                    <h3 class="text-lg font-semibold">Map Product to RMA</h3>
                    <button type="button" class="close-modal" data-modal-close="true">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body p-6">
                    <input type="hidden" id="mapping-product-id"/>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Product</label>
                            <input type="text" id="mapping-internal-name" readonly="readonly"
                                   class="w-full bg-gray-100 dark:bg-gray-700 border border-gray-300 dark:border-gray-700 rounded-md px-3 py-2 text-sm text-gray-500"/>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Your Product Name (for RMA)</label>
                            <input type="text" id="mapping-client-name" 
                                   class="w-full border border-gray-300 dark:border-gray-700 rounded-md px-3 py-2 text-sm focus:ring-theme focus:border-theme outline-none dark:bg-gray-800 dark:text-white"/>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Your SKU (optional)</label>
                            <input type="text" id="mapping-client-sku" 
                                   class="w-full border border-gray-300 dark:border-gray-700 rounded-md px-3 py-2 text-sm focus:ring-theme focus:border-theme outline-none dark:bg-gray-800 dark:text-white"/>
                        </div>
                    </div>
                </div>
                <div class="modal-footer flex justify-end gap-2 p-4 bg-gray-50 dark:bg-gray-800 rounded-b-xl border-t border-gray-200 dark:border-gray-700">
                    <button type="button" data-modal-close="true" class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-md">Cancel</button>
                    <button type="button" id="rma-product-mapping-save-btn" 
                            class="px-4 py-2 text-sm font-medium text-white btn-primary rounded-md shadow-sm">Save &amp; Add</button>
                </div>
            </div>
        </div>
    </template>

    <!-- RMA Units Import Modal -->
    <template id="rma_units_import_modal">
        <div id="dashboard-page-import-rma-modal" class="modal" data-outside-close="false">
            <div class="modal-content max-w-lg w-full mx-auto">
                <div class="modal-header">
                    <h3 class="text-lg font-sm text-gray-900 dark:text-gray-100">Import RMA Units from Excel</h3>
                    <button data-modal-close="true" class="close-modal" aria-label="Close modal">
                        <i class="fas fa-times"/>
                    </button>
                </div>
                <div class="modal-body overflow-y-auto">
                    <form id="page-rma_units-import-form" class="p-6" action="/account/rma/units/import" method="POST" enctype="multipart/form-data">
                        <div class="form-group mb-4">
                            <label for="rma-units-file-input" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Upload Excel File (.xlsx)</label>
                            <div class="file-drop-area rounded-lg border-2 border-dashed border-gray-300 dark:border-gray-600 p-8 text-center cursor-pointer hover:border-theme transition-colors" id="rma-units-file-drop-area">
                                <input type="file" id="rma-units-file-input" name="file" class="hidden" accept=".xlsx,.xls"/>
                                <div class="file-input-content">
                                    <i class="fas fa-file-excel text-3xl text-gray-400 mb-3"/>
                                    <p class="text-sm text-gray-600 dark:text-gray-400">Drag and drop an Excel file, or <span class="text-primary-theme font-medium">browse</span></p>
                                    <p class="text-xs text-gray-500 mt-2">Maximum file size: 5MB</p>
                                </div>
                                <div id="rma-units-file-name" class="hidden mt-3 text-sm font-medium text-theme"></div>
                            </div>
                        </div>
                        <div class="bg-blue-50 dark:bg-blue-900/30 p-4 rounded-lg">
                            <h4 class="text-xs font-bold text-blue-800 dark:text-blue-300 uppercase tracking-wider mb-2">Instructions</h4>
                            <p class="text-xs text-blue-700 dark:text-blue-400 mb-3 leading-relaxed">
                                Use the Excel template to import multiple units at once. Required columns: <strong>product_reference</strong>, <strong>quantity</strong>.
                            </p>
                            <a href="/account/rma/units/download_template" class="inline-flex items-center text-xs font-medium text-primary-theme hover:underline">
                                <i class="fas fa-download mr-1.5"/> Download Excel Template
                            </a>
                        </div>
                    </form>
                </div>
                <div class="modal-footer bg-gray-50 dark:bg-gray-800 px-6 py-4 flex justify-end rounded-b-lg border-t border-gray-200 dark:border-gray-700">
                    <button data-modal-close="true" class="modal-btn modal-btn-secondary mr-2">
                        <i class="fas fa-times"/> Cancel
                    </button>
                    <button type="button" class="modal-btn modal-btn-primary" id="rma-units-import-submit-btn">
                        <i class="fas fa-file-import mr-1.5"/> Import Units
                    </button>
                </div>
            </div>
        </div>
    </template>
</odoo>
