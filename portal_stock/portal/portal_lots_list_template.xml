<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_lots_list" name="Portal Lot List">
        <t t-foreach="lots" t-as="lot">
            <!-- Large screens row -->
            <tr class="hover:bg-gray-100 dark:hover:bg-gray-700 hidden lg:table-row">
                <td class="px-3 py-4 whitespace-nowrap">
                    <input type="checkbox" class="lots-list-checkbox h-4 w-4 text-primary-theme border-gray-300 rounded focus-ring-theme" t-att-data-lot-id="lot.id" t-att-data-lot-name="lot.name"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <img class="size-10 rounded-full" t-attf-src="/account/stock/image/#{lot.product_id.id}/80x80" t-att-alt="lot.product_id.name"/>
                        </div>
                    </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900 dark:text-gray-100" t-esc="lot.product_id.name"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100" t-esc="lot.name"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100">
                        <t t-if="lot.lifecycle_state">
                            <span t-esc="lot.lifecycle_state"/>
                        </t>
                        <t t-else="">
                            <span class="text-gray-400">-</span>
                        </t>
                    </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100">
                        <t t-if="lot.location_id">
                            <span t-esc="lot.location_id.complete_name"/>
                        </t>
                        <t t-else="">
                            <span class="text-gray-400">-</span>
                        </t>
                    </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100" t-esc="lot.product_qty"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <a t-attf-href="/account/stock/lots/details/#{lot.id}" class="text-primary-theme  transition-colors" title="Ver detalles">
                        <i class="fas fa-info-circle"/>
                    </a>
                </td>
            </tr>

            <!-- Medium screens row -->
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 hidden md:table-row lg:hidden">
                <td t-if="batch_actions" class="px-3 py-4 whitespace-nowrap">
                    <input type="checkbox" class="lots-list-checkbox h-4 w-4 text-primary-theme border-gray-300 rounded focus-ring-theme" t-att-data-lot-id="lot.id" t-att-data-lot-name="lot.name"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <img class="size-8 rounded-full" t-attf-src="/account/stock/image/#{lot.product_id.id}/80x80" t-att-alt="lot.product_id.name"/>
                        </div>
                    </div>
                </td>
                <td class="px-6 py-4" style="max-width: 300px;">
                    <div class="min-w-0">
                        <div class="text-sm font-medium text-gray-900 dark:text-gray-100 break-words" t-esc="lot.product_id.name"/>
                        <div class="text-xs text-gray-500 dark:text-gray-400 break-words" t-esc="lot.name"/>
                    </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100">
                        <t t-if="lot.location_id">
                            <span t-esc="lot.location_id.complete_name"/>
                        </t>
                        <t t-else="">
                            <span class="text-gray-400">-</span>
                        </t>
                    </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100" t-esc="lot.product_qty"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <a t-attf-href="/account/stock/lots/details/#{lot.id}" class="text-primary-theme  transition-colors" title="Ver detalles">
                        <i class="fas fa-info-circle"/>
                    </a>
                </td>
            </tr>

            <!-- Small screens row -->
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 table-row md:hidden">
                <td t-if="batch_actions" class="px-3 py-4 whitespace-nowrap">
                    <input type="checkbox" class="lots-list-checkbox h-4 w-4 text-primary-theme border-gray-300 rounded focus-ring-theme" t-att-data-lot-id="lot.id" t-att-data-lot-name="lot.name"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <img class="size-8 rounded-full" t-attf-src="/account/stock/image/#{lot.product_id.id}/80x80" t-att-alt="lot.product_id.name"/>
                        </div>
                    </div>
                </td>
                <td class="px-6 py-4" style="max-width: 300px;">
                    <div class="min-w-0">
                        <div class="text-sm font-medium text-gray-900 dark:text-gray-100 break-words" t-esc="lot.product_id.name"/>
                        <div class="text-xs text-gray-500 dark:text-gray-400 break-words" t-esc="lot.name"/>
                    </div>
                </td>

                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <a t-attf-href="/account/stock/lots/details/#{lot.id}" class="text-primary-theme  transition-colors" title="Ver detalles">
                        <i class="fas fa-info-circle"/>
                    </a>
                </td>
            </tr>
        </t>
    </template>

    <template id="portal_lot_pager" name="Portal Lot Pager">
        <!-- No results message -->
        <div class="sm:hidden" t-if="items_count == 0">
            <p class="text-xs text-gray-700 dark:text-gray-300 mb-2">
                <span class="font-medium">No results found</span>
            </p>
        </div>


        <!-- Mobile pagination controls -->
        <div class="sm:hidden" t-if="items_count > 0">
            <p class="text-xs text-gray-700 dark:text-gray-300 mb-2">
                <span class="font-medium">Showing 1-<span t-out="items_count"/></span> of <span class="font-medium" t-out="items_total"/> <span t-out="items_label"/>
            </p>
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <span class="sr-only">Previous</span>
                    <i class="fas fa-chevron-left"/>
                </button>
                <t t-foreach="pages" t-as="page">
                    <button type="button" t-if="page.get('active')" class="z-10 bg-light-active dark:bg-gray-800 border-primary-theme dark:border-primary-theme text-primary-theme dark:text-primary-theme relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                    <button type="button" t-else="" class="bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                </t>
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <span class="sr-only">Next</span>
                    <i class="fas fa-chevron-right"/>
                </button>
            </nav>
        </div>

        <!-- Desktop pagination -->
        <div class="hidden sm:flex sm:items-center" t-if="items_count > 0">
            <p class="text-sm text-gray-700 dark:text-gray-300 mr-4">
                <span class="font-medium">Showing</span> <span class="font-medium">1-<span t-out="items_count"/></span> <span>of</span> <span class="font-medium" t-out="items_total"/> <span t-out="items_label"/> <span class="text-gray-500 ml-1"></span>
            </p>
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700" id="lot-list-pagination-previous">
                    <span class="sr-only">Previous</span>
                    <i class="fas fa-chevron-left"/>
                </button>
                <t t-foreach="pages" t-as="page">
                    <button t-if="page.get('active')" aria-current="page" t-att-data-page="page.get('page')" class="lot-list-pagination-button z-10 bg-light-active dark:bg-gray-800 border-primary-theme dark:border-primary-theme text-primary-theme dark:text-primary-theme relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                    <button t-else="" t-att-data-page="page.get('page')" class="lot-list-pagination-button bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                </t>
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700" id="lot-list-pagination-next">
                    <span class="sr-only">Next</span>
                    <i class="fas fa-chevron-right"/>
                </button>
            </nav>
        </div>
    </template>

</odoo>
