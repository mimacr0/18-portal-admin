<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_stock_page" name="Portal Stock Page">
        <t t-call="portal_admin_theme.portal_admin_layout">

            <div class="w-full">

                <div class="card-title-container mb-4 flex items-center">
                    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100" t-esc="page_title"/>
                </div>

                <!-- Bulk actions toolbar - hidden by default, visible when items are selected -->
                <div id="bulk-actions-toolbar" class="bg-white rounded-lg shadow mb-4 p-3 hidden dark:bg-gray-800">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center">
                            <span id="selected-count" class="text-sm font-medium text-gray-700 dark:text-gray-300 mr-3">0 selected</span>
                            <div class="h-4 border-l border-gray-300 dark:border-gray-700 mr-3"/>
                            <div class="flex flex-wrap gap-2">
                                <button t-foreach="batch_actions" t-as="batch_action" t-attf-id="page-list-#{page_name}-batch-action-#{batch_action.get('name')}" t-attf-class="px-3 py-1 text-white text-sm rounded transition-colors flex items-center #{batch_action.get('color', 'btn-primary ')}">
                                    <i t-attf-class="#{batch_action.get('icon')} mr-1.5"/> <t t-out="batch_action.get('label')"/>
                                </button>
                            </div>
                        </div>
                        <button id="clear-selection" class="text-sm text-gray-600 hover:text-gray-800">
                            <i class="fas fa-times mr-1"/> Clear selection
                        </button>
                    </div>
                </div>

                <t t-if="list_filters">
                    <!-- Quick filter actions -->
                    <div class="border-b border-gray-200 dark:border-gray-700 mb-2">
                        <div class="flex overflow-x-auto scrollbar-hide">
                            <input type="hidden" t-attf-id="page-#{page_name}-list-quick-filter-active" value="all"/>
                            <t t-foreach="list_filters" t-as="list_filter">
                                <button t-if="list_filter.get('active')" type="button" t-att-data-filter-id="list_filter.get('id')" t-attf-id="page-#{page_name}-list-filter-#{list_filter.get('id')}" t-attf-class="page-#{page_name}-list-filter tab-button active px-6 py-3 text-sm font-medium border-b-2 border-primary-theme text-primary-theme focus:outline-none transition-colors duration-200 ease-in-out dark:text-white relative">
                                    <i t-attf-class="#{list_filter.get('icon')} mr-2"/>
                                    <t t-out="list_filter.get('label')"/>
                                </button>
                                <button t-else="" type="button" t-att-data-filter-id="list_filter.get('id')" t-attf-id="page-#{page_name}-list-filter-#{list_filter.get('id')}" t-attf-class="page-#{page_name}-list-filter tab-button px-6 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 focus:outline-none transition-colors duration-200 ease-in-out dark:text-white dark:hover:text-gray-300 relative">
                                    <i t-attf-class="#{list_filter.get('icon')} mr-2"/>
                                    <t t-out="list_filter.get('label')"/>
                                </button>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- Users Table -->
                <div class="bg-white rounded-lg shadow overflow-hidden mb-20 dark:bg-gray-800">
                    <div class="p-4 border-b border-gray-200 dark:border-gray-700">
                        <div class="flex flex-col lg:flex-row justify-between gap-4">
                            <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                                <div class="flex items-center gap-2">
                                    <a t-if="page_name == 'lots'" href="/account/stock" class="px-3 py-1.5 btn-primary text-white rounded-md  transition-colors flex items-center">
                                        <i class="fas fa-arrow-left mr-1.5"/> <span class="hidden sm:inline">Volver</span>
                                    </a>
                                    <button t-if="page_name == 'stock'" t-attf-id="launch-create-#{page_name}-form-button" class="px-3 py-1.5 btn-primary text-white rounded-md  transition-colors flex items-center">
                                        <i class="fas fa-plus mr-1.5"/> <span class="hidden sm:inline">Create Product</span>
                                    </button>
                                </div>
                            </div>

                            <div class="flex items-center justify-between gap-2">
                                <!-- Search input -->
                                <div class="relative flex-grow max-w-xs">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <i class="fas fa-search text-gray-400 dark:text-gray-500"/>
                                    </div>
                                    <input type="text" t-attf-id="page-#{page_name}-list-search" class="block w-full pl-10 pr-3 py-1.5 text-sm border border-gray-300 rounded-md focus:border-primary-theme dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="Search ..."/>
                                </div>

                                <!-- Advanced search toggle button -->
                                <button t-if="advanced_search" t-attf-id="page-#{page_name}-list-advanced-search-toggle" data-tooltip-target="tooltip-advanced-search" class="p-2 border border-gray-300 rounded-md hover:bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-700 dark:hover:bg-gray-700 relative">
                                    <i class="fas fa-sliders-h"/>
                                </button>

                                <!-- Action buttons -->
                                <div class="flex items-center">
                                    <button t-foreach="tools_actions" t-as="tools_action" t-attf-data-tooltip-target="page-list-#{page_name}-tools-action-#{tools_action.get('name')}" t-attf-id="page-list-#{page_name}-tools-action-#{tools_action.get('name')}" t-att-data-modal-open="tools_action.get('modal_id')" class="p-2 rounded-md hover:bg-gray-100 text-gray-500 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-700 dark:hover:bg-gray-700 relative">
                                        <i t-att-class="tools_action.get('icon')"/>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Advanced search panel - hidden by default -->
                        <div t-attf-id="page-#{page_name}-list-advanced-search-panel" class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700 hidden">
                            <!-- Keep ids consistent with JS modules -->
                            <input type="hidden" t-attf-id="page-#{page_name}-list-advanced-search-domain" value="[]"/>
                            <input type="hidden" t-attf-id="page-#{page_name}-list-advanced-search-fields" t-att-value="advanced_search"/>
                            <h3 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Advanced Search</h3>

                            <!-- Dynamic Advanced Filter -->
                            <div class="w-full">

                                <!-- Match Type Selector -->
                                <div class="mb-4">
                                    <p class="text-sm text-gray-700 dark:text-gray-300">
                                        <select t-attf-id="page-#{page_name}-list-advanced-search-match-type" class="inline-block mx-1 px-2 py-1 text-sm border border-gray-300 rounded-md shadow-sm focus-ring-theme focus:border-primary-theme bg-white dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700">
                                            <option value="all" selected="selected">All</option>
                                            <option value="any">Any</option>
                                        </select>
                                        of the following conditions:
                                    </p>
                                </div>

                                <!-- Filter Lines Container -->
                                <div t-attf-id="page-#{page_name}-list-advanced-search-lines-container" class="space-y-3"></div>

                                <!-- Add Filter Line Button -->
                                <div class="mt-3">
                                    <button t-attf-id="page-#{page_name}-list-advanced-search-add-line-btn" class="flex items-center text-primary-theme hover:text-primary-theme text-sm font-medium">
                                        <i class="fas fa-plus-circle mr-1.5"/> Add filter condition
                                    </button>
                                </div>
                            </div>

                            <!-- Action buttons for advanced search -->
                            <div class="mt-4 flex justify-end space-x-3">
                                <button t-attf-id="page-#{page_name}-list-advanced-search-reset-btn" class="px-3 py-1 text-sm border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-700 dark:hover:bg-gray-700">
                                    Reset
                                </button>
                                <button t-attf-id="page-#{page_name}-list-advanced-search-apply-btn" class="px-3 py-1 text-sm btn-primary text-white rounded-md shadow-sm  dark:btn-primary dark:text-white dark: dark:hover:text-white">
                                    Apply Filters
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="overflow-x-auto" style="position: relative; z-index: 1;">
                        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700" t-attf-id="page-#{page_name}-list-table">
                            <thead class="bg-gray-50 dark:bg-gray-800">
                                <!-- Large screens header -->
                                <tr class="hidden lg:table-row">
                                    <th t-if="batch_actions" scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                        <div class="flex items-center">
                                            <input t-attf-id="page-#{page_name}-list-select-all-checkbox" type="checkbox" class="h-4 w-4 text-primary-theme border-gray-300 rounded focus-ring-theme dark:border-gray-600 dark:bg-gray-700 dark:checked:btn-primary "/>
                                        </div>
                                    </th>
                                    <t t-foreach="list_columns" t-as="list_column">
                                        <th t-if="list_column.get('sortable')" scope="col" t-attf-class="px-6 py-3 #{list_column.get('right') and 'text-right' or 'text-left'} text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider #{list_column.get('md') and 'hidden md:table-cell' or ''} #{list_column.get('lg') and 'hidden lg:table-cell' or ''}" t-attf-style="#{list_column.get('id') == 'name' and 'max-width: 300px;' or ''}">
                                            <div class="flex items-center">
                                                <span t-out="list_column.get('label')"/>
                                                <i t-attf-id="list-column-#{page_name}-#{list_column.get('id')}-sort-icon" t-if="list_column.get('sortable')" class="fas fa-sort ml-1 text-gray-400"/>
                                            </div>
                                        </th>
                                        <th t-else="" scope="col" t-attf-class="px-6 py-3 #{list_column.get('right') and 'text-right' or 'text-left'} text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider" t-attf-style="#{list_column.get('id') == 'name' and 'max-width: 300px;' or ''}">
                                            <span t-out="list_column.get('label')"/>
                                        </th>
                                    </t>
                                </tr>
                                <!-- Medium screens header -->
                                <tr class="hidden md:table-row lg:hidden">
                                    <th t-if="batch_actions" scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                        <div class="flex items-center">
                                            <input t-attf-id="page-#{page_name}-list-select-all-checkbox-md" type="checkbox" class="h-4 w-4 text-primary-theme border-gray-300 rounded focus-ring-theme dark:border-gray-600 dark:bg-gray-700 dark:checked:btn-primary "/>
                                        </div>
                                    </th>
                                    <t t-foreach="list_columns" t-as="list_column">
                                        <t t-if="list_column.get('show_in_md')">
                                            <th t-if="list_column.get('sortable')" scope="col" t-attf-class="px-6 py-3 #{list_column.get('right') and 'text-right' or 'text-left'} text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider" t-attf-style="#{list_column.get('id') == 'name' and 'max-width: 300px;' or ''}">
                                                <div class="flex items-center">
                                                    <span t-out="list_column.get('label')"/>
                                                    <i t-attf-id="list-column-#{page_name}-#{list_column.get('id')}-sort-icon" t-if="list_column.get('sortable')" class="fas fa-sort ml-1 text-gray-400"/>
                                                </div>
                                            </th>
                                            <th t-else="" scope="col" t-attf-class="px-6 py-3 #{list_column.get('right') and 'text-right' or 'text-left'} text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider" t-attf-style="#{list_column.get('id') == 'name' and 'max-width: 300px;' or ''}">
                                                <span t-out="list_column.get('label')"/>
                                            </th>
                                        </t>
                                    </t>
                                </tr>
                                <!-- Small screens header -->
                                <tr class="table-row md:hidden">
                                    <th t-if="batch_actions" scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                        <div class="flex items-center">
                                            <input t-attf-id="page-#{page_name}-list-select-all-checkbox-sm" type="checkbox" class="h-4 w-4 text-primary-theme border-gray-300 rounded focus-ring-theme dark:border-gray-600 dark:bg-gray-700 dark:checked:btn-primary "/>
                                        </div>
                                    </th>
                                    <t t-foreach="list_columns" t-as="list_column">
                                        <t t-if="list_column.get('show_in_sm')">
                                            <th t-if="list_column.get('sortable')" scope="col" t-attf-class="px-6 py-3 #{list_column.get('right') and 'text-right' or 'text-left'} text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider" t-attf-style="#{list_column.get('id') == 'name' and 'max-width: 300px;' or ''}">
                                                <div class="flex items-center">
                                                    <span t-out="list_column.get('label')"/>
                                                    <i t-attf-id="list-column-#{page_name}-#{list_column.get('id')}-sort-icon" t-if="list_column.get('sortable')" class="fas fa-sort ml-1 text-gray-400"/>
                                                </div>
                                            </th>
                                            <th t-else="" scope="col" t-attf-class="px-6 py-3 #{list_column.get('right') and 'text-right' or 'text-left'} text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider" t-attf-style="#{list_column.get('id') == 'name' and 'max-width: 300px;' or ''}">
                                                <span t-out="list_column.get('label')"/>
                                            </th>
                                        </t>
                                    </t>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700" t-attf-id="#{page_name}-page-list-items">
                                <t t-if="page_name == 'lots' and lots_list_html" t-out="lots_list_html"/>
                                <t t-if="page_name == 'stock' and products_list_html" t-out="products_list_html"/>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

            <div class="fixed bottom-0 right-0 z-10 mr-6 mb-6">
                <input type="hidden" t-attf-id="#{page_name}-list-pagination-page" value="1"/>
                <div class="pagination-container px-4 py-3 bg-white border border-gray-200 dark:bg-gray-800 dark:border-gray-700 rounded-lg shadow-lg flex items-center justify-between" t-attf-id="#{page_name}-list-pagination-container">
                    <t t-if="page_name == 'lots' and lots_pager_html" t-out="lots_pager_html"/>
                    <t t-if="page_name == 'stock' and products_pager_html" t-out="products_pager_html"/>
                </div>
            </div>

            <div class="h-25"/>

            <t t-set="footer_content">

                <!-- Stock Create Product Modal -->
                <t t-call="portal_stock.portal_create_product_modal"/>
                <!-- File Upload Modal -->
                <t t-call="portal_stock.portal_file_upload_modal"/>
                <!-- Import Products Modal -->
                <t t-call="portal_stock.portal_import_products_modal"/>

                <!-- Product Edit Modal -->
                <div id="page-stock-edit-modal" class="modal" data-outside-close="false" style="z-index: 9999;">
                    <div class="modal-content max-w-2xl w-full mx-auto">
                        <div class="modal-header">
                            <h3 class="text-lg font-sm text-gray-900 dark:text-gray-100">Product Edit</h3>
                            <button data-modal-close="true" class="close-modal" aria-label="Close modal">
                                <i class="fas fa-times"/>
                            </button>
                        </div>
                        <div class="modal-body">
                            <form id="page-stock-edit-form">
                                <input type="hidden" name="product_id" id="page-stock-edit-form-product-id"/>
                                <input type="hidden" name="image_base64" id="page-stock-edit-form-image-base64"/>
                                <div class="form-group">
                                    <div class="grid grid-cols-2 items-start">
                                        <div class="col-span-1 w-full p-2">
                                            <label for="page-stock-edit-form-name" class="form-label-sm font-sm mb-1">Name <span class="text-red-500 text-xl">*</span></label>
                                            <input type="text" name="name" id="page-stock-edit-form-name" class="form-input text-xl rounded-md border border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="Name" required="required"/>
                                            <div class="form-error invisible mt-1" id="page-stock-edit-form-name-error"/>
                                        </div>
                                        <div class="col-start-2 flex justify-end items-start">
                                            <div class="relative group w-24 h-24">
                                                <input type="file" name="image" class="hidden" id="page-stock-edit-form-image" accept="image/*"/>
                                                <label for="page-stock-edit-form-image" class="cursor-pointer block w-full h-full">
                                                    <img id="page-stock-edit-form-image-preview" src="/portal_stock/static/img/placeholder.png" alt="Upload image" class="w-full h-full border-2 border-gray-400 object-cover rounded transition-opacity duration-200 group-hover:opacity-80"/>
                                                </label>
                                                <button type="button" id="page-stock-edit-form-image-delete" class="absolute top-1 right-1 bg-white text-red-600 p-1 rounded-full shadow-md hover:bg-red-100 opacity-0 group-hover:opacity-100 transition-opacity duration-200" title="Remove image">
                                                    <i class="fa fa-trash"/>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 sm:grid-cols-1 gap-4">
                                    <div class="form-group">
                                        <div class="flex items-center">
                                            <label for="page-stock-edit-form-sku" class="form-label-sm font-sm">SKU</label>
                                            <span class="text-red-500 ml-1">*</span>
                                        </div>
                                        <div>
                                            <input type="text" name="sku" id="page-stock-edit-form-sku" class="form-input-sm w-full text-sm shadow rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="SKU" required="required"/>
                                            <div class="form-error invisible" id="page-stock-edit-form-sku-error"/>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="flex items-center">
                                            <label for="page-stock-edit-form-barcode" class="form-label-sm font-sm">Barcode</label>
                                            <span class="text-red-500 ml-1">*</span>
                                        </div>
                                        <div>
                                            <input type="text" name="barcode" id="page-stock-edit-form-barcode" class="form-input-sm w-full text-sm shadow rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="Barcode" required="required" maxlength="13"/>
                                            <div class="form-error invisible" id="page-stock-edit-form-barcode-error"/>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="flex items-center">
                                            <label for="page-stock-edit-form-volume" class="form-label-sm font-sm">Volume (cm³)</label>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <input type="number" name="volume" id="page-stock-edit-form-volume" class="form-input-sm w-full text-sm shadow rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="Volume" step="0.01" min="0"/>
                                            <span class="mx-1 text-sm">cm³</span>
                                            <div class="form-error invisible" id="page-stock-edit-form-volume-error"/>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="flex items-center">
                                            <label for="page-stock-edit-form-weight" class="form-label-sm font-sm">Weight (kg)</label>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <input type="number" name="weight" id="page-stock-edit-form-weight" class="form-input-sm w-full text-sm shadow rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus-ring-theme dark:focus-ring-theme" placeholder="Weight" step="0.01" min="0"/>
                                            <span class="mx-1 text-sm">kg</span>
                                            <div class="form-error invisible" id="page-stock-edit-form-weight-error"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div>
                                        <div class="flex space-x-4 mt-1">
                                            <div class="flex items-center">
                                                <input type="radio" name="tracking" id="page-stock-edit-tracking-serial" value="serial" class="w-4 h-4 text-primary-theme border-gray-300 focus-ring-theme"/>
                                                <label for="page-stock-edit-tracking-serial" class="ml-2 text-sm font-medium text-gray-700 dark:text-gray-300">Return</label>
                                            </div>
                                            <div class="flex items-center">
                                                <input type="radio" name="tracking" id="page-stock-edit-tracking-none" value="none" class="w-4 h-4 text-primary-theme border-gray-300 focus-ring-theme"/>
                                                <label for="page-stock-edit-tracking-none" class="ml-2 text-sm font-medium text-gray-700 dark:text-gray-300">New</label>
                                            </div>
                                        </div>
                                        <div class="form-error invisible mt-1" id="page-stock-edit-form-tracking-error"/>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer bg-gray-50 dark:bg-gray-800 px-6 py-4 flex justify-end rounded-b-lg border-t border-gray-200 dark:border-gray-700">
                            <button data-modal-close="true" class="modal-btn modal-btn-secondary mr-2">
                                <i class="fas fa-times"/> Cancel
                            </button>
                            <button id="page-stock-edit-form-submit" class="modal-btn modal-btn-primary">
                                <i class="fas fa-save"/> Save
                            </button>
                        </div>
                    </div>
                </div>

            </t>

        </t>
    </template>

    <template id="portal_products_list" name="Portal Stock List">
        <t t-foreach="products" t-as="product">
            <!-- Large screens row -->
            <tr class="hover:bg-gray-100 dark:hover:bg-gray-700 hidden lg:table-row">
                <td class="px-3 py-4 whitespace-nowrap">
                    <input type="checkbox" class="products-list-checkbox h-4 w-4 text-primary-theme border-gray-300 rounded focus-ring-theme" t-att-data-product-id="product.id" t-att-data-product-name="product.name"/>
                </td>
                <!-- <td class="px-6 py-4" style="max-width: 300px;">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <img class="size-10 rounded-full" t-attf-src="data:image/png;base64,#{product_images.get(product.id) or ''}" t-att-alt="product.name"/>
                        </div>
                        <div class="ml-4 min-w-0 flex-1">
                            <div class="text-sm font-medium text-gray-900 dark:text-gray-100 break-words" t-esc="product.name"/>
                            <t t-foreach="product.product_template_attribute_value_ids" t-as="attribute_value">
                                <span class="px-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800 mt-1">
                                    <t t-esc="attribute_value.attribute_line_id.attribute_id.name"/>: <t t-esc="attribute_value.name"/>
                                </span>
                            </t>
                        </div>
                    </div>
                </td> -->
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">

                        <div class="flex-shrink-0">
                                <img class="size-10 rounded-full" t-attf-src="data:image/png;base64,#{product_images.get(product.id) or ''}" t-att-alt="product.name"/>
                        </div>
                        <div class="text-sm text-gray-900 dark:text-gray-100" t-esc="product.display_name"/>
                    </div>
                </td>
                <!-- <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100" t-esc="product.default_code"/>
                </td> -->
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100" t-esc="product.barcode"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 dark:text-gray-100">
                        <t t-if="product.qty_available">
                            <div class="flex mb-1">
                                <div class="text-left pr-2 w-32"><strong>Real Stock: </strong></div>
                                <div><t t-esc="product.qty_available"/></div>
                            </div>
                        </t>
                        <t t-if="product.free_qty">
                            <div class="flex mb-1">
                                <div class="text-left pr-2 w-32"><strong>Available: </strong></div>
                                <div><t t-esc="product.free_qty"/></div>
                            </div>
                        </t>
                        <t t-if="product.incoming_qty">
                            <div class="flex mb-1">
                                <div class="text-left pr-2 w-32"><strong>Incoming: </strong></div>
                                <div><t t-esc="product.incoming_qty"/></div>
                            </div>
                        </t>
                        <t t-if="product.outgoing_qty">
                            <div class="flex mb-1">
                                <div class="text-left pr-2 w-32"><strong>Outgoing: </strong></div>
                                <div><t t-esc="product.outgoing_qty"/></div>
                            </div>
                        </t>
                    </div>
                </td>
<!--                    <td class="px-6 py-4 whitespace-nowrap">-->
<!--                        <div class="text-sm text-gray-900 dark:text-gray-100" t-esc="product.qty_available"/>-->
<!--                    </td>-->
<!--                    <td class="px-6 py-4 whitespace-nowrap">-->
<!--                        <div class="text-sm text-gray-900 dark:text-gray-100" t-esc="product.free_qty"/>-->
<!--                    </td>-->
<!--                    <td class="px-6 py-4 whitespace-nowrap">-->
<!--                        <div class="text-sm text-gray-900 dark:text-gray-100" t-esc="product.incoming_qty"/>-->
<!--                    </td>-->
<!--                    <td class="px-6 py-4 whitespace-nowrap">-->
<!--                        <div class="text-sm text-gray-900 dark:text-gray-100" t-esc="product.outgoing_qty"/>-->
<!--                    </td>-->
                <!-- Columna de Reparaciones/Revisiones -->
                <td class="px-6 py-4 whitespace-nowrap">
                    <t t-set="stats" t-value="products_repair_stats.get(product.id, {})"/>
                    <div class="text-sm text-gray-900 dark:text-gray-100">
                        <t t-if="stats.get('in_repair', 0) > 0">
                            <div class="flex mb-1">
                                <div class="text-left pr-2 w-24"><strong><t t-esc="label_in_repair"/>: </strong></div>
                                <div><t t-esc="stats.get('in_repair', 0)"/></div>
                            </div>
                        </t>
                        <t t-if="stats.get('repaired', 0) > 0">
                            <div class="flex mb-1">
                                <div class="text-left pr-2 w-24"><strong><t t-esc="label_repaired"/>: </strong></div>
                                <div><t t-esc="stats.get('repaired', 0)"/></div>
                            </div>
                        </t>
                        <t t-if="stats.get('in_review', 0) > 0">
                            <div class="flex mb-1">
                                <div class="text-left pr-2 w-24"><strong><t t-esc="label_in_review"/>: </strong></div>
                                <div><t t-esc="stats.get('in_review', 0)"/></div>
                            </div>
                        </t>
                        <t t-if="stats.get('reviewed', 0) > 0">
                            <div class="flex mb-1">
                                <div class="text-left pr-2 w-24"><strong><t t-esc="label_reviewed"/>: </strong></div>
                                <div><t t-esc="stats.get('reviewed', 0)"/></div>
                            </div>
                        </t>
                        <t t-if="not stats.get('in_repair', 0) and not stats.get('repaired', 0) and not stats.get('in_review', 0) and not stats.get('reviewed', 0)">
                            <span class="text-gray-400">-</span>
                        </t>
                    </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <span t-attf-class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full #{product.qty_available > 0 and 'bg-green-100 text-green-800' or 'bg-red-100 text-red-800'}">
                        <t t-esc="product.qty_available > 0 and label_in_stock or label_out_of_stock"/>
                    </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <t t-if="product.tracking == 'serial' and products_has_lots.get(product.id, False)">
                        <a t-attf-href="/account/stock/lots?product_id=#{product.id}" t-attf-data-tooltip-target="tooltip-lots-#{product.id}" class="text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                            <i class="fas fa-list"/>
                        </a>
                    </t>
                    <button t-attf-data-tooltip-target="tooltip-edit-#{product.id}" t-att-data-product-id="product.id" class="product-edit-button text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-edit"/>
                    </button>
                    <button t-attf-data-tooltip-target="tooltip-delete-#{product.id}" t-att-data-product-id="product.id" class="product-delete-button text-gray-600 hover:text-gray-900 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-trash"/>
                    </button>
                </td>
            </tr>

            <!-- Medium screens row -->
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 hidden md:table-row lg:hidden">
                <td t-if="batch_actions" class="px-3 py-4 whitespace-nowrap">
                    <input type="checkbox" class="products-list-checkbox h-4 w-4 text-primary-theme border-gray-300 rounded focus-ring-theme" t-att-data-product-id="product.id" t-att-data-product-name="product.name"/>
                </td>
                <td class="px-6 py-4" style="max-width: 300px;">
                    <div class="min-w-0">
                        <div class="text-sm text-gray-900 dark:text-gray-100 break-words" t-esc="product.name"/>
                        <div class="text-sm text-gray-500 break-words" t-esc="product.default_code"/>
                    </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <span t-attf-class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full #{product.qty_available > 0 and 'bg-green-100 text-green-800' or 'bg-red-100 text-red-800'}">
                        <t t-esc="product.qty_available > 0 and label_in_stock or label_out_of_stock"/>
                    </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <t t-if="product.tracking == 'serial' and products_has_lots.get(product.id, False)">
                        <a t-attf-href="/account/stock/lots?product_id=#{product.id}" t-attf-data-tooltip-target="tooltip-lots-#{product.id}" class="text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                            <i class="fas fa-list"/>
                        </a>
                    </t>
                    <button t-attf-data-tooltip-target="tooltip-edit-#{product.id}" t-att-data-product-id="product.id" class="product-edit-button text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-edit"/>
                    </button>
                    <button t-attf-data-tooltip-target="tooltip-delete-#{product.id}" t-att-data-product-id="product.id" class="product-delete-button text-gray-600 hover:text-gray-900 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-trash"/>
                    </button>
                </td>
            </tr>

            <!-- Small screens row -->
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 table-row md:hidden">
                <td t-if="batch_actions" class="px-3 py-4 whitespace-nowrap">
                    <input type="checkbox" class="products-list-checkbox h-4 w-4 text-primary-theme border-gray-300 rounded focus-ring-theme" t-att-data-product-id="product.id" t-att-data-product-name="product.name"/>
                </td>
                <td class="px-6 py-4" style="max-width: 300px;">
                    <div class="text-sm font-medium text-gray-900 dark:text-gray-100 break-words" t-esc="product.name"/>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <t t-if="product.tracking == 'serial' and products_has_lots.get(product.id, False)">
                        <a t-attf-href="/account/stock/lots?product_id=#{product.id}" t-attf-data-tooltip-target="tooltip-lots-#{product.id}" class="text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                            <i class="fas fa-list"/>
                        </a>
                    </t>
                    <button t-attf-data-tooltip-target="tooltip-edit-#{product.id}" t-att-data-product-id="product.id" class="product-edit-button text-gray-600 hover:text-gray-900 mr-3 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-edit"/>
                    </button>
                    <button t-attf-data-tooltip-target="tooltip-delete-#{product.id}" t-att-data-product-id="product.id" class="product-delete-button text-gray-600 hover:text-gray-900 relative dark:text-gray-100 dark:hover:text-gray-100">
                        <i class="fas fa-trash"/>
                    </button>
                </td>
            </tr>
        </t>
    </template>

    <template id="portal_stock_pager" name="Portal Stock Pager">
        <!-- No results message -->
        <div class="sm:hidden" t-if="items_count == 0">
            <p class="text-xs text-gray-700 dark:text-gray-300 mb-2">
                <span class="font-medium">No results found</span>
            </p>
        </div>


        <!-- Mobile pagination controls -->
        <div class="sm:hidden" t-if="items_count > 0">
            <p class="text-xs text-gray-700 dark:text-gray-300 mb-2">
                <span class="font-medium">Showing 1-<span t-out="items_count"/></span> of <span class="font-medium" t-out="items_total"/> <span t-out="items_label"/>
            </p>
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <span class="sr-only">Previous</span>
                    <i class="fas fa-chevron-left"/>
                </button>
                <t t-foreach="pages" t-as="page">
                    <button type="button" t-if="page.get('active')" class="z-10 bg-light-active dark:bg-gray-800 border-primary-theme dark:border-primary-theme text-primary-theme dark:text-primary-theme relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                    <button type="button" t-else="" class="bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                </t>
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <span class="sr-only">Next</span>
                    <i class="fas fa-chevron-right"/>
                </button>
            </nav>
        </div>

        <!-- Desktop pagination -->
        <div class="hidden sm:flex sm:items-center" t-if="items_count > 0">
            <p class="text-sm text-gray-700 dark:text-gray-300 mr-4">
                <span class="font-medium">Showing</span> <span class="font-medium">1-<span t-out="items_count"/></span> <span>of</span> <span class="font-medium" t-out="items_total"/> <span t-out="items_label"/> <span class="text-gray-500 ml-1"></span>
            </p>
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700" id="stock-list-pagination-previous">
                    <span class="sr-only">Previous</span>
                    <i class="fas fa-chevron-left"/>
                </button>
                <t t-foreach="pages" t-as="page">
                    <button t-if="page.get('active')" aria-current="page" t-att-data-page="page.get('page')" class="stock-list-pagination-button z-10 bg-light-active dark:bg-gray-800 border-primary-theme dark:border-primary-theme text-primary-theme dark:text-primary-theme relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                    <button t-else="" t-att-data-page="page.get('page')" class="stock-list-pagination-button bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 relative inline-flex items-center px-3 py-2 border text-sm font-medium">
                        <span t-out="page.get('page')"/>
                    </button>
                </t>
                <button type="button" class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700" id="stock-list-pagination-next">
                    <span class="sr-only">Next</span>
                    <i class="fas fa-chevron-right"/>
                </button>
            </nav>
        </div>
    </template>

</odoo>