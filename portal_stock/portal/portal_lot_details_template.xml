<?xml version="1.0" encoding="utf-8"?>
<odoo> 
    <template id="portal_lot_details_page" name="Portal Lot Details Page">
        <t t-call="portal_admin_theme.portal_admin_layout">
            <!-- Details Page -->
            <div class="w-full md:w-4/5 mx-auto lg:max-w-7xl bg-white dark:bg-gray-800 rounded-xl shadow-lg print:shadow-none border border-gray-100 dark:border-gray-700 overflow-hidden">
                <!-- Document Action Bar -->
                <div class="p-5 flex justify-between items-center border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800">
                    <a t-attf-href="/account/stock/lots?product_id=#{lot.product_id.id}" class="inline-flex items-center text-primary-theme hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 transition-colors cursor-pointer">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        Back
                    </a>
                    <div class="flex items-center space-x-4">
                        <div class="lot-status-selector relative">
                            <span t-attf-class="px-3 py-1.5 text-xs font-medium rounded-full flex items-center">
                                <t t-if="lot.lifecycle_state" t-esc="lot.lifecycle_state"/>
                                <t t-else="">-</t>
                            </span>
                        </div>
                    </div>
                </div>
                <!-- Lot Information -->
                <div class="p-8 grid grid-cols-1 gap-8 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800">
                    <div class="flex flex-col md:flex-row justify-between items-start relative z-10">
                        <div>
                            <div class="flex items-center p-8">
                                <h1 class="text-3xl font-extrabold text-gray-900 dark:text-white">Lot/Serial</h1>
                                <span class="ml-4 text-xl font-medium text-blue-600 dark:text-blue-400"><t t-out="lot.name"/></span>
                            </div>
                            <div class="mt-4 space-y-1">
                                <span class="text-gray-500 dark:text-gray-400">Product: <strong><t t-if="lot.product_id" t-esc="lot.product_id.name"/><t t-else="">-</t></strong></span><br/>
                                <span class="text-gray-500 dark:text-gray-400">Quantity: <strong><t t-esc="lot.product_qty"/></strong></span>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Product Information -->
                <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-8 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800">
                    <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-sm border border-gray-100 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                        <h3 class="text-lg font-medium mb-4 text-gray-900 dark:text-white flex items-center">
                            <i class="fas fa-box mr-2 text-primary-theme "></i>
                            Product Information
                        </h3>
                        <div class="text-sm space-y-2 dark:text-gray-300">
                            <p t-if="lot.product_id"><span class="font-medium">Name:</span> <t t-esc="lot.product_id.name"/></p>
                            <p t-if="lot.product_id and lot.product_id.default_code"><span class="font-medium">Reference:</span> <t t-esc="lot.product_id.default_code"/></p>
                            <p t-if="lot.ref"><span class="font-medium">Internal Reference:</span> <t t-esc="lot.ref"/></p>
                        </div>
                    </div>
                    <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-sm border border-gray-100 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                        <h3 class="text-lg font-medium mb-4 text-gray-900 dark:text-white flex items-center">
                            <i class="fas fa-map-marker-alt mr-2 text-primary-theme "></i>
                            Location
                        </h3>
                        <div class="text-sm space-y-2 dark:text-gray-300">
                            <p t-if="lot.location_id">
                                <span class="font-medium">Location:</span> <t t-esc="lot.location_id.complete_name"/>
                            </p>
                            <p t-else="">
                                <span class="text-gray-400">-</span>
                            </p>
                        </div>
                    </div>
                </div>
                <!-- Lot Details -->
                <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-8 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800">
                    <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-sm border border-gray-100 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                        <h3 class="text-lg font-medium mb-4 text-gray-900 dark:text-white flex items-center">
                            <i class="fas fa-info-circle mr-2 text-primary-theme "></i>
                            Lot Information
                        </h3>
                        <div class="text-sm space-y-2 dark:text-gray-300">
                            <p><span class="font-medium">Lot/Serial Number:</span> <t t-esc="lot.name"/></p>
                            <p t-if="lot.lifecycle_state"><span class="font-medium">State:</span> <t t-esc="lot.lifecycle_state"/></p>
                            <p><span class="font-medium">Quantity:</span> <t t-esc="lot.product_qty"/></p>
                        </div>
                    </div>
                    <!-- <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-sm border border-gray-100 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                        <h3 class="text-lg font-medium mb-4 text-gray-900 dark:text-white flex items-center">
                            <i class="fas fa-calendar-alt mr-2 text-primary-theme "></i>
                            Dates
                        </h3>
                        <div class="text-sm space-y-2 dark:text-gray-300">
                            <p t-if="lot.expiration_date">
                                <span class="font-medium">Expiration Date:</span> 
                                <t t-out="lot.expiration_date"/>
                            </p>
                            <p t-if="lot.use_date">
                                <span class="font-medium">Use Date:</span> 
                                <t t-out="lot.use_date"/>
                            </p>
                            <p t-if="lot.removal_date">
                                <span class="font-medium">Removal Date:</span> 
                                <t t-out="lot.removal_date"/>
                            </p>
                            <p t-if="lot.alert_date">
                                <span class="font-medium">Alert Date:</span> 
                                <t t-out="lot.alert_date"/>
                            </p>
                            <t t-if="not lot.expiration_date and not lot.use_date and not lot.removal_date and not lot.alert_date">
                                <p><span class="text-gray-400">-</span></p>
                            </t>
                        </div>
                    </div> -->
                </div>
                <!-- Repair/Review History -->
                <div class="p-8 border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800">
                    <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-sm border border-gray-100 dark:border-gray-700">
                        <h3 class="text-lg font-medium mb-4 text-gray-900 dark:text-white flex items-center">
                            <i class="fas fa-tools mr-2 text-primary-theme"></i>
                            Repair / Review History
                        </h3>
                        <t t-if="lot_alerts">
                            <div class="space-y-4">
                                <t t-foreach="lot_alerts" t-as="alert">
                                    <div class="p-4 bg-gray-50 dark:bg-gray-700/50 rounded-lg border border-gray-200 dark:border-gray-600">
                                        <!-- Cabecera de la alerta -->
                                        <div class="flex items-start mb-3">
                                            <!-- Icono según tipo -->
                                            <div class="flex-shrink-0 mr-4">
                                                <div t-attf-class="w-10 h-10 rounded-full flex items-center justify-center #{alert.maintenance_type == 'repair' and 'bg-amber-100 dark:bg-amber-900/50' or 'bg-blue-100 dark:bg-blue-900/50'}">
                                                    <i t-attf-class="fas #{alert.maintenance_type == 'repair' and 'fa-wrench text-amber-600 dark:text-amber-400' or 'fa-search text-blue-600 dark:text-blue-400'}"/>
                                                </div>
                                            </div>
                                            <!-- Info básica -->
                                            <div class="flex-grow">
                                                <div class="flex items-center justify-between mb-1">
                                                    <span class="font-medium text-gray-900 dark:text-white">
                                                        <t t-if="alert.maintenance_type == 'repair'" t-esc="label_repair"/>
                                                        <t t-elif="alert.maintenance_type == 'review'" t-esc="label_review"/>
                                                        <t t-else="" t-esc="alert.maintenance_type or '-'"/>
                                                        <span class="text-gray-400 font-normal ml-2" t-esc="alert.name"/>
                                                    </span>
                                                    <span t-attf-class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium #{alert.stage_id.done and 'bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300' or 'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300'}">
                                                        <t t-esc="alert.stage_id.name if alert.stage_id else '-'"/>
                                                    </span>
                                                </div>
                                                <div class="text-sm text-gray-500 dark:text-gray-400">
                                                    <span t-if="alert.title" class="block font-medium text-gray-700 dark:text-gray-300"><t t-esc="alert.title"/></span>
                                                    <span class="text-xs">
                                                        <i class="fas fa-calendar-alt mr-1"/>
                                                        <t t-esc="alert.create_date.strftime('%d/%m/%Y %H:%M') if alert.create_date else '-'"/>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Detalles de las órdenes de reparación vinculadas -->
                                        <t t-if="alert.repair_order_ids">
                                            <div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-600">
                                                <t t-foreach="alert.repair_order_ids" t-as="repair">
                                                    <div class="mb-3 last:mb-0">
                                                        <!-- State Timeline -->
                                                        <t t-if="repair.confirm_date or repair.in_progress_date or repair.done_date">
                                                            <div class="mb-3">
                                                                <span class="text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide">
                                                                    <i class="fas fa-history mr-1"/>State History
                                                                </span>
                                                                <div class="mt-2 flex flex-wrap gap-2">
                                                                    <!-- Confirmed -->
                                                                    <t t-if="repair.confirm_date">
                                                                        <div class="flex items-center text-xs bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 px-2 py-1 rounded">
                                                                            <i class="fas fa-clipboard-check mr-1"/>
                                                                            <span class="font-medium mr-1">Confirmed:</span>
                                                                            <t t-esc="repair.confirm_date.strftime('%d/%m/%Y %H:%M')"/>
                                                                        </div>
                                                                    </t>
                                                                    <!-- In Progress -->
                                                                    <t t-if="repair.in_progress_date">
                                                                        <div class="flex items-center text-xs bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 px-2 py-1 rounded">
                                                                            <i class="fas fa-play-circle mr-1"/>
                                                                            <span class="font-medium mr-1">In Progress:</span>
                                                                            <t t-esc="repair.in_progress_date.strftime('%d/%m/%Y %H:%M')"/>
                                                                        </div>
                                                                    </t>
                                                                    <!-- Done -->
                                                                    <t t-if="repair.done_date">
                                                                        <div class="flex items-center text-xs bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300 px-2 py-1 rounded">
                                                                            <i class="fas fa-check-double mr-1"/>
                                                                            <span class="font-medium mr-1">Done:</span>
                                                                            <t t-esc="repair.done_date.strftime('%d/%m/%Y %H:%M')"/>
                                                                        </div>
                                                                    </t>
                                                                </div>
                                                            </div>
                                                        </t>
                                                        
                                                        <!-- Diagnosis -->
                                                        <t t-if="repair.diagnosis_ids">
                                                            <div class="mb-2">
                                                                <span class="text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide">
                                                                    <i class="fas fa-stethoscope mr-1"/>Diagnosis
                                                                </span>
                                                                <div class="mt-1 flex flex-wrap gap-1">
                                                                    <t t-foreach="repair.diagnosis_ids" t-as="diag">
                                                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-800 dark:bg-purple-900/50 dark:text-purple-300">
                                                                            <t t-esc="diag.name"/>
                                                                        </span>
                                                                    </t>
                                                                </div>
                                                            </div>
                                                        </t>
                                                        
                                                        <!-- Results -->
                                                        <t t-if="repair.result_ids">
                                                            <div class="mb-2">
                                                                <span class="text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide">
                                                                    <i class="fas fa-check-circle mr-1"/>Results
                                                                </span>
                                                                <div class="mt-1 flex flex-wrap gap-1">
                                                                    <t t-foreach="repair.result_ids" t-as="result">
                                                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/50 dark:text-green-300">
                                                                            <t t-esc="result.name"/>
                                                                        </span>
                                                                    </t>
                                                                </div>
                                                            </div>
                                                        </t>
                                                        
                                                        <!-- Internal Notes -->
                                                        <t t-if="repair.internal_notes">
                                                            <div class="mb-2">
                                                                <span class="text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide">
                                                                    <i class="fas fa-sticky-note mr-1"/>Notes
                                                                </span>
                                                                <div class="mt-1 text-sm text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 p-2 rounded border border-gray-100 dark:border-gray-600">
                                                                    <t t-raw="repair.internal_notes"/>
                                                                </div>
                                                            </div>
                                                        </t>
                                                        
                                                        <!-- No additional information -->
                                                        <t t-if="not repair.diagnosis_ids and not repair.result_ids and not repair.internal_notes and not repair.confirm_date and not repair.in_progress_date and not repair.done_date">
                                                            <p class="text-xs text-gray-400 italic">No additional information</p>
                                                        </t>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="text-center py-8 text-gray-400 dark:text-gray-500">
                                <i class="fas fa-inbox text-4xl mb-2"/>
                                <p>No repair or review history</p>
                            </div>
                        </t>
                    </div>
                </div>
                <!-- Communication history -->
                <div class="border-t border-gray-200 dark:border-gray-700">
                    <div class="p-5" id="communication-toggle">
                        <div class="flex items-center justify-between">
                            <h3 class="text-lg font-medium dark:text-white flex items-center">
                                <i class="fas fa-comments mr-2 text-primary-theme "></i>
                                Communication History
                            </h3>
                        </div>
                    </div>
                    <div id="communication-content" class="p-6 pt-0">
                        <t t-set="partner" t-value="lot.product_id and lot.product_id.account_partner_id and lot.product_id.account_partner_id.partner_id or user.partner_id"/>
                        <!-- Communication content wrapper -->
                        <div class="rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden flex flex-col">
                            <!-- Chat header -->
                            <div class="chat-header bg-gray-50 dark:bg-gray-700 border-b border-gray-200 dark:border-gray-600 p-4 flex justify-between items-center">
                                <div class="flex items-center">
                                    <div class="w-8 h-8 bg-blue-500 dark:bg-blue-600 rounded-full flex items-center justify-center">
                                        <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M2 5a2 2 0 012-2h7a2 2 0 012 2v4a2 2 0 01-2 2H9l-3 3v-3H4a2 2 0 01-2-2V5z"></path>
                                            <path d="M15 7v2a4 4 0 01-4 4H9.828l-1.766 1.767c.28.149.599.233.938.233h2l3 3v-3h2a2 2 0 002-2V9a2 2 0 00-2-2h-1z"></path>
                                        </svg>
                                    </div>
                                    <span class="ml-2 font-medium text-sm text-gray-700 dark:text-gray-200">Chat about <span t-out="lot.name"/></span>
                                </div>
                            </div>
                            <!-- Messages container with increased height -->
                            <div class="space-y-4 h-[500px] overflow-y-auto p-4 messages-container bg-white dark:bg-gray-800" id="lot_details-details-chat-messages" t-att-data-lot-id="lot.id" t-att-data-partner-id="user.partner_id.id"></div>
                            <!-- Message input area in separate container -->
                            <div class="message-composer bg-white dark:bg-gray-800 border-t border-gray-100 dark:border-gray-700 p-4">
                                <div class="message-input-wrapper bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg shadow-sm dark:shadow-gray-900/50" id="message-input-container">
                                    <div class="flex items-end p-2">
                                        <div class="flex-shrink-0 mr-2">
                                            <div class="w-8 h-8 rounded-full bg-gray-500 dark:bg-gray-600 flex items-center justify-center">
                                                <img t-if="user.partner_id.image_128" class="w-5 h-5 rounded-full" t-attf-src="/web/image/res.partner/#{user.partner_id.id}/image_128/50x50"/>
                                                <svg t-else="" class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                                                </svg>
                                            </div>
                                        </div>
                                        <div class="flex-grow relative">
                                            <div class="flex items-center">
                                                <button class="message-attach-button text-gray-500 dark:text-gray-300 hover:text-primary-theme dark:hover:text-blue-400 p-2">
                                                    <i class="fas fa-paperclip"></i>
                                                </button>
                                                <div class="flex-grow">
                                                    <input type="hidden" id="page-details-lot_details-message-attachment-token" t-att-value="request.csrf_token()"/>
                                                    <input type="file" id="page-details-lot_details-message-attachment-input" class="hidden"/>
                                                    <textarea class="message-input bg-transparent border-0 rounded-md text-gray-800 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 w-full py-2 resize-none focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" rows="1" placeholder="Write a message..."></textarea>
                                                </div>
                                                <button id="page-details-lot_details-send-message" class="message-send-button text-primary-theme dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 bg-blue-50 dark:bg-blue-900/30 p-2 rounded-full flex items-center justify-center ml-2">
                                                    <i class="fas fa-paper-plane"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
