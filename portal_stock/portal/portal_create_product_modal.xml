<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_create_product_modal" name="Portal Create Products Modal">
        <!-- Stock Create Modal -->
        <div t-attf-id="page-#{page_name}-list-create-modal" class="modal" data-outside-close="false">
            <div class="modal-content max-w-2xl w-full mx-auto">
                <div class="modal-header">
                    <h3 class="text-lg font-sm text-gray-900 dark:text-gray-100">Product Create</h3>
                    <button data-modal-close="true" class="close-modal" aria-label="Close modal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <form t-attf-id="page-#{page_name}-list-product-create-form">
                        <div class="form-group">
                            <div class="grid grid-cols-2 items-start">
                                <!-- Columna 1-2: Label + Input -->
                                <div class="col-span-1 w-full p-2">
                                    <label
                                            t-attf-for="page-#{page_name}-list-create-form-name"
                                            class="form-label-sm font-sm mb-1">
                                        Name <span class="text-red-500 text-xl">*</span>
                                    </label>
                                    <input
                                            type="text"
                                            name="name"
                                            t-attf-id="page-#{page_name}-list-create-form-name"
                                            class="form-input text-xl rounded-md border border-gray-300 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500"
                                            placeholder="Name"
                                            required="required"
                                    />
                                    <div class="form-error invisible mt-1" t-attf-id="page-#{page_name}-list-create-form-name-error"/>
                                </div>

                                <!-- Columna 2: Imagen -->
                                <div class="col-start-2 flex justify-end items-start">
                                    <!-- Contenedor relativo para que el botón se posicione respecto a la imagen -->
                                    <div class="relative group w-24 h-24">
                                        <input
                                                type="file"
                                                name="image"
                                                class="hidden"
                                                t-attf-id="page-#{page_name}-list-create-form-image"
                                                accept="image/*"
                                        />
                                        <input
                                                type="hidden"
                                                name="image_base64"
                                                t-attf-id="page-#{page_name}-list-create-form-image-base64"
                                        />

                                        <!-- Label que contiene la imagen y actúa como botón para seleccionar archivo -->
                                        <label
                                                t-attf-for="page-#{page_name}-list-create-form-image"
                                                class="cursor-pointer block w-full h-full"
                                        >
                                            <img
                                                    t-attf-id="page-#{page_name}-list-create-form-image-preview"
                                                    src="/portal_stock/static/img/placeholder.png"
                                                    alt="Subir imagen"
                                                    class="w-full h-full border-2 border-gray-400 object-cover rounded transition-opacity duration-200 group-hover:opacity-80"
                                            />
                                        </label>

                                        <!-- Botón eliminar superpuesto en esquina inferior derecha -->
                                        <button
                                                type="button"
                                                t-attf-id="page-#{page_name}-list-create-form-image-delete"
                                                class="absolute top-1 right-1 bg-white text-red-600 p-1 rounded-full shadow-md hover:bg-red-100 opacity-0 group-hover:opacity-100 transition-opacity duration-200"
                                                title="Eliminar imagen"
                                        >
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                </div>


                                <!-- Fin Columna 2 -->

                            </div>
                        </div>

                        <div class="form-group">
                            <div>
                                <div class="flex space-x-4 mt-1">
                                    <div class="flex items-center">
                                        <input
                                            type="radio"
                                            name="tracking"
                                            id="tracking_none"
                                            value="none"
                                            required="required"
                                            class="w-4 h-4 text-cyan-600 border-gray-300 focus:ring-cyan-500"
                                        />
                                        <label for="tracking_none" class="ml-2 text-sm font-medium text-gray-700 dark:text-gray-300">
                                            New
                                        </label>
                                    </div>
                                    <div class="flex items-center">
                                        <input
                                            type="radio"
                                            name="tracking"
                                            id="tracking_serial"
                                            value="serial"
                                            required="required"
                                            class="w-4 h-4 text-cyan-600 border-gray-300 focus:ring-cyan-500"
                                        />
                                        <label for="tracking_serial" class="ml-2 text-sm font-medium text-gray-700 dark:text-gray-300">
                                            Return
                                        </label>
                                    </div>
                                </div>
                                <div class="form-error invisible mt-1" t-attf-id="page-#{page_name}-list-create-form-tracking-error"/>
                            </div>
                        </div>

                        <div class="form-group">
                            <input name="attributes" type="hidden" t-attf-id="page-#{page_name}-list-create-form-attributes-list" required="required"/>

<!--                            <div class="mb-4">-->
<!--                                <p class="form-label-sm font-sm">Attributes</p>-->
<!--                            </div>-->

                            <div t-attf-id="page-#{page_name}-list-create-form-attributes-container">
                                <div t-attf-id="page-#{page_name}-list-create-form-attributes-line-items-container"
                                     class="products-line-items-container">
                                </div>

                                <div class="mt-3 flex items-center gap-2">
                                    <button t-attf-id="page-#{page_name}-list-create-form-attributes-add-line-btn" type="button"
                                            class="px-2 py-0.5 bg-cyan-600 text-white rounded-md hover:bg-cyan-700 transition-colors text-xs flex items-center">
                                        <i class="fas fa-plus mr-1.5"></i> Add Attribute
                                    </button>
                                    <span class="ml-2 text-xs text-gray-500 italic">
                                        <i class="fas fa-long-arrow-right"></i> Add only if the product has variants, e.g. Hair Dryer (Color: White, Red, Green).
                                    </span>
                                </div>

                            </div>

                            <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-attributes-list-error"></div>
                        </div>

                        <div class="form-group" t-attf-id="page-#{page_name}-list-create-form-sku-container">
                            <div class="flex items-center">
                                <label t-attf-for="page-#{page_name}-list-create-form-sku" class="form-label-sm font-sm">SKU</label>
                            </div>
                            <div>
                                <input type="text" name="sku" t-attf-id="page-#{page_name}-list-create-form-sku" class="form-input-sm w-full text-sm shadow rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="SKU"/>
                                <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-sku-error"></div>
                            </div>
                        </div>
                        <div class="form-group" t-attf-id="page-#{page_name}-list-create-form-barcode-container">
                            <div class="flex items-center">
                                <label t-attf-for="page-#{page_name}-list-create-form-barcode" class="form-label-sm font-sm">Barcode</label>
                            </div>
                            <div>
                                <input type="text" name="barcode" t-attf-id="page-#{page_name}-list-create-form-barcode" class="form-input-sm w-full text-sm shadow rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Barcode"/>
                                <div class="form-error invisible" t-attf-id="page-#{page_name}-list-create-form-barcode-error"></div>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="flex items-center">
                                <label t-attf-for="page-#{page_name}-list-create-form-measures" class="form-label-sm font-sm">Measures (cm)</label>
                                <span class="text-red-500 ml-1">*</span>
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <div class="flex flex-col">
                                        <div class="flex items-center">
                                            <input type="number" required="required" name="width" t-attf-id="page-#{page_name}-list-create-form-measures-width" class="form-input-sm w-full text-sm shadow rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Width" min="0"/>
                                            <span class="mx-1">x</span>
                                        </div>
                                        <div class="form-error invisible mt-1" t-attf-id="page-#{page_name}-list-create-form-measures-width-error"/>
                                    </div>

                                    <div class="flex flex-col">
                                        <div class="flex items-center">
                                            <input type="number" required="required" name="height" t-attf-id="page-#{page_name}-list-create-form-measures-height" class="form-input-sm w-full text-sm shadow rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Height" min="0"/>
                                            <span class="mx-1">x</span>
                                        </div>
                                        <div class="form-error invisible mt-1" t-attf-id="page-#{page_name}-list-create-form-measures-height-error"/>
                                    </div>

                                    <div class="flex flex-col">
                                        <div class="flex items-center">
                                            <input type="number" required="required" name="length" t-attf-id="page-#{page_name}-list-create-form-measures-length" class="form-input-sm w-full text-sm shadow rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Length" min="0"/>
                                            <span class="mx-1 text-sm">cm</span>
                                        </div>
                                        <div class="form-error invisible mt-1" t-attf-id="page-#{page_name}-list-create-form-measures-length-error"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="grid grid-cols-2 sm:grid-cols-1 gap-4">
                                <!-- Weight -->
                                <div>
                                    <div class="flex items-center">
                                        <label t-attf-for="page-#{page_name}-list-create-form-weight" class="form-label-sm font-sm">
                                            Weight (kg)
                                        </label>
                                        <span class="text-red-500 ml-1">*</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <input
                                                type="number"
                                                step="0.01"
                                                min="0"
                                                name="weight"
                                                required="required"
                                                t-attf-id="page-#{page_name}-list-create-form-weight"
                                                class="form-input-sm w-full text-sm shadow rounded-md border border-gray-300 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500"
                                                placeholder="Weight"
                                        />
                                        <span class="mx-1 text-sm">kg</span>
                                    </div>
                                    <div class="form-error invisible mt-1" t-attf-id="page-#{page_name}-list-create-form-weight-error"/>
                                </div>

                                <!-- Volume -->
                                <div>
                                    <div class="flex items-center">
                                        <label t-attf-for="page-#{page_name}-list-create-form-volume" class="form-label-sm font-sm">
                                            Volume (cm³)
                                        </label>
                                        <span class="text-gray-500 ml-1">*</span>
                                        <span class="ml-2 text-xs text-gray-500 italic">
                                            <i class="fas fa-calculator"></i> Auto Calculated
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <input
                                                type="text"
                                                name="volume"
                                                readonly="readonly"
                                                tabindex="-1"
                                                t-attf-id="page-#{page_name}-list-create-form-volume"
                                                class="form-input-sm w-full text-sm shadow rounded-md border border-gray-300
                                                focus:outline-none focus:ring-0 select-none bg-gray-100 text-gray-700 font-medium pr-10"
                                                placeholder="Width x Height x Length"
                                        />
                                        <span class="mx-1 text-sm">cm³</span>
                                    </div>
                                    <div class="form-error invisible mt-1" t-attf-id="page-#{page_name}-list-create-form-name-error"/>
                                </div>

                            </div>
                        </div>

                    </form>
                </div>
                <div class="modal-footer bg-gray-50 dark:bg-gray-800 px-6 py-4 flex justify-end rounded-b-lg border-t border-gray-200 dark:border-gray-700" t-attf-id="page-#{page_name}-list-create-product-form-footer">
                    <button data-modal-close="true" class="modal-btn modal-btn-secondary mr-2">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button t-attf-id="page-#{page_name}-list-create-product-form-submit" class="modal-btn modal-btn-primary">
                        <i class="fas fa-save"></i> Save
                    </button>
                    <button t-attf-id="page-#{page_name}-list-create-product-form-next" class="modal-btn modal-btn-primary">
                        <i class="fas fa-arrow-right"></i> Variants
                    </button>
                </div>
            </div>
        </div>
    </template>
</odoo>