<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Import Products Modal -->
    <template id="portal_import_products_modal" name="Portal Import Products Modal">
        <div id="page-stock-import-products-modal" class="modal" data-outside-close="false">
            <div class="modal-content max-w-lg w-full mx-auto">
                <div class="modal-header">
                    <h3 class="text-lg font-sm text-gray-900 dark:text-gray-100">Import Products from Excel</h3>
                    <button data-modal-close="true" class="close-modal" aria-label="Close modal">
                        <i class="fas fa-times"/>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="stock-import-products-form" class="form-flex">
                        <div class="form-group-flex">
                            <label for="stock-products-file-input" class="form-label form-label-sm">Upload Excel File (.xlsx)</label>
                            <div class="form-field-container">
                                <div class="file-drop-area rounded-md border-2 border-dashed border-gray-300 dark:border-gray-600 p-4 text-center cursor-pointer" id="stock-products-file-drop-area">
                                    <input type="file" id="stock-products-file-input" name="file" class="hidden" accept=".xlsx,.xls"/>
                                    <div class="file-input-content">
                                        <i class="fas fa-file-excel text-2xl text-gray-400 dark:text-gray-500"/>
                                        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Drag and drop an Excel file here, or <span class="text-primary-theme browse-link cursor-pointer hover:underline" id="stock-products-browse-link">browse</span></p>
                                        <p class="text-xs text-gray-500 dark:text-gray-500 mt-1">Maximum file size: 5MB</p>
                                    </div>
                                </div>
                                <div class="file-preview mt-3 flex flex-col items-center" id="stock-products-file-preview"/>
                                <div class="form-error invisible" id="stock-products-file-error">Please select a file to upload.</div>
                            </div>
                        </div>
                        <div class="mt-4 p-3 bg-gray-50 dark:bg-gray-800 rounded-md">
                            <p class="text-xs text-gray-600 dark:text-gray-400 mb-2">
                                <i class="fas fa-info-circle mr-1"/>
                                Required columns: <strong>name</strong>, <strong>tracking</strong>, <strong>width</strong>, <strong>height</strong>, <strong>length</strong>, <strong>weight</strong>
                            </p>
                            <p class="text-xs text-gray-500 dark:text-gray-500 mb-2">
                                Optional: <strong>sku</strong>, <strong>barcode</strong>
                            </p>
                            <a href="/portal_stock/static/templates/products.xlsx" class="text-xs text-primary-theme hover:underline" download="products_template.xlsx">
                                <i class="fas fa-download mr-1"/>Download template
                            </a>
                        </div>
                    </form>
                </div>
                <div class="modal-footer bg-gray-50 dark:bg-gray-800 px-6 py-4 flex justify-end rounded-b-lg border-t border-gray-200 dark:border-gray-700">
                    <button data-modal-close="true" class="modal-btn modal-btn-secondary mr-2">
                        <i class="fas fa-times"/> Cancel
                    </button>
                    <button class="modal-btn modal-btn-primary" id="stock-products-upload-btn">
                        <i class="fas fa-file-import"/> Import
                    </button>
                </div>
            </div>
        </div>
    </template>
</odoo>
