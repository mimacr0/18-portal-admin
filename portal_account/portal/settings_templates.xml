<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_user_settings_page" name="Portal User Settings Page">
        <t t-call="portal_admin_theme.portal_admin_layout">

            <div id="settings-container" class="w-full max-w-7xl mx-auto">

                <!-- Config Sections -->
                <div class="space-y-6">
                    <!-- General Settings Section -->
                    <div class="config-section bg-white dark:bg-gray-800 rounded-lg shadow">
                        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
                            <h2 class="text-lg font-medium text-gray-800 dark:text-gray-200">General Settings</h2>
                            <p class="text-sm text-gray-500 dark:text-gray-400">Basic configuration for your application</p>
                        </div>
                        <div class="p-6 space-y-4">

                            <!-- Site Name -->
                            <div class="config-field">
                                <label for="settings-user-list-limit" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">List Limit</label>
                                <input type="number" id="settings-user-list-limit" class="block w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500 text-sm dark:bg-gray-700 dark:text-gray-200" value="100"/>
                                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">The number of items to display per page (default: 100)</p>
                            </div>

                        </div>
                        <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700 flex justify-end">
                            <button id="settings-save-button" type="button" class="text-sm font-medium px-4 py-2 bg-cyan-600 text-white rounded-md shadow-sm hover:bg-cyan-700 dark:bg-cyan-500 dark:text-white dark:hover:bg-cyan-600 transition-all duration-300 ease-in-out hover:-translate-y-1 hover:shadow-md active:translate-y-0">
                                <span class="flex items-center">
                                    <span id="settings-save-text">Save Changes</span>
                                    <span id="settings-save-loader" class="ml-2 hidden">
                                        <i class="fas fa-circle-notch fa-spin"></i>
                                    </span>
                                </span>
                            </button>
                        </div>
                    </div>

                </div>
            </div>

            <div class="h-30"></div>

        </t>
    </template>

</odoo>
