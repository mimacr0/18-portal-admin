                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow md:col-span-1 lg:col-span-2">
                        <div class="flex justify-between items-center mb-3">
                            <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Products</p>
                            <div class="bg-amber-100 dark:bg-amber-900 p-2 rounded-full">
                                <i class="fas fa-cubes text-amber-500 dark:text-amber-400 text-sm"></i>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
                            <!-- Total -->
                            <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-2 text-center">
                                <p class="text-xs text-gray-600 dark:text-gray-400 font-medium">Total</p>
                                <h3 class="text-lg font-bold text-gray-900 dark:text-white" id="dashboard-kpi-products-total">-</h3>
                            </div>
                            <!-- New this month -->
                            <div class="bg-blue-50 dark:bg-blue-900/30 rounded-lg p-2 text-center">
                                <p class="text-xs text-blue-600 dark:text-blue-400 font-medium">New</p>
                                <h3 class="text-lg font-bold text-gray-900 dark:text-white" id="dashboard-kpi-products-new">-</h3>
                                <p class="text-xs text-gray-500" id="dashboard-kpi-products-change">
                                    <i class="fas fa-spinner fa-spin mr-1 text-gray-400"></i>
                                </p>
                            </div>
                            <!-- In Stock -->
                            <div class="bg-green-50 dark:bg-green-900/30 rounded-lg p-2 text-center">
                                <p class="text-xs text-green-600 dark:text-green-400 font-medium">In Stock</p>
                                <h3 class="text-lg font-bold text-gray-900 dark:text-white" id="dashboard-kpi-products-in-stock">-</h3>
                            </div>
                            <!-- Out of Stock -->
                            <div class="bg-red-50 dark:bg-red-900/30 rounded-lg p-2 text-center">
                                <p class="text-xs text-red-600 dark:text-red-400 font-medium">No Stock</p>
                                <h3 class="text-lg font-bold text-gray-900 dark:text-white" id="dashboard-kpi-products-out-stock">-</h3>
                            </div>
                        </div>
                    </div>

                    <!-- Stock Card - Hidden
                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Stock</p>
                                <h3 class="text-2xl font-bold text-gray-900 dark:text-white" id="dashboard-kpi-stock-total">-</h3>
                                <p class="text-xs" id="dashboard-kpi-stock-change">
                                    <i class="fas fa-spinner fa-spin mr-1"></i>Loading...
                                </p>
                            </div>
                            <div class="bg-teal-100 dark:bg-teal-900 p-3 rounded-full">
                                <i class="fas fa-boxes-stacked text-teal-500 dark:text-teal-400"></i>
                            </div>
                        </div>
                    </div>
                    -->
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-4">

                    <!-- Actions Card -->
                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Quick Actions</h3>
                        <div class="grid grid-cols-2 gap-3">
                            <a href="/portal_account/static/templates/receptions.xlsx" target="_blank" class="bg-cyan-100 hover:bg-cyan-200 dark:bg-cyan-700 dark:hover:bg-cyan-600 text-cyan-700 dark:text-cyan-100 p-3 rounded-lg transition duration-200 flex items-center justify-center text-center">
                                <i class="fas fa-file-invoice mr-2"></i> Receptions Template
                            </a>
                            <a href="/portal_account/static/templates/expeditions.xlsx" target="_blank" class="bg-purple-100 hover:bg-purple-200 dark:bg-purple-700 dark:hover:bg-purple-600 text-purple-700 dark:text-purple-100 p-3 rounded-lg transition duration-200 flex items-center justify-center text-center">
                                <i class="fas fa-file-invoice mr-2"></i> Expeditions Template
                            </a>
                            <button id="dashboard-page-import-receptions-button" class="bg-amber-100 hover:bg-amber-200 dark:bg-amber-700 dark:hover:bg-amber-600 text-amber-700 dark:text-amber-100 p-3 rounded-lg transition duration-200 flex items-center justify-center">
                                <i class="fas fa-file-import mr-2"></i> Import receptions
                            </button>
                            <button id="dashboard-page-import-expeditions-button" class="bg-green-100 hover:bg-green-200 dark:bg-green-700 dark:hover:bg-green-600 text-green-700 dark:text-green-100 p-3 rounded-lg transition duration-200 flex items-center justify-center">
                                <i class="fas fa-file-import mr-2"></i> Import expeditions
                            </button>
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Recent Activity</h3>
                        </div>
                        <div class="space-y-4 max-h-64 overflow-y-auto pr-2 scrollbar-thin scrollbar-thumb-gray-300 dark:scrollbar-thumb-gray-600" id="dashboard-page-recent-activity-container"></div>
                    </div>

                    <!-- Account Balance Card -->
                    <div class="content-gradient p-4 rounded-lg shadow text-white">
                        <div class="flex justify-between items-start mb-4">
                            <h3 class="text-lg font-semibold">Account Balance</h3>
                            <i class="fas fa-credit-card text-white/80 text-xl"></i>
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-sm mb-4">
                            <div>
                                <p class="opacity-80">Account</p>
                                <p id="dashboard-page-account-label" class="text-3xl font-bold"><span t-out="account_partner.name"/></p>
                            </div>
                            <div>
                                <p class="text-sm opacity-80">Available Credit</p>
                                <p id="dashboard-page-available-credit-value" class="text-3xl font-bold" data-value="0" data-current="0" data-suffix="" data-decimals="2" data-thousand-sep="" data-decimal-sep=""></p>
                                <p id="dashboard-page-pending-approval-label" class="text-sm opacity-80 hidden">Pending Approval</p>
                                <p id="dashboard-page-pending-approval-value" class="text-3xl font-bold hidden" data-value="0" data-current="0" data-suffix="" data-decimals="2" data-thousand-sep="" data-decimal-sep=""></p>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-sm mt-8">
                            <button class="bg-white/20 hover:bg-white/30 text-white p-2 rounded-lg transition duration-200 flex items-center justify-center" id="dashboard-page-add-credit-button">
                                <i class="fas fa-plus mr-2"></i> Add Credit
                            </button>
                            <button class="bg-white/20 hover:bg-white/30 text-white p-2 rounded-lg transition duration-200 flex items-center justify-center" id="dashboard-page-pay-now-button">
                                <i class="fas fa-credit-card mr-2"></i> Pay Now
                            </button>
                        </div>
                        <!-- Credit History inside card -->
                        <div class="mt-4 pt-4 border-t border-white/20">
                            <p class="text-sm opacity-80 mb-2">Credit History</p>
                            <div class="space-y-2 max-h-32 overflow-y-auto pr-1 scrollbar-thin scrollbar-thumb-white/30" id="dashboard-credit-history-container">
                                <div class="flex justify-center items-center py-2">
                                    <i class="fas fa-spinner fa-spin text-white/60 mr-2"></i>
                                    <span class="text-white/60 text-xs">Loading...</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Period Selector -->
                <div class="flex justify-end mb-3">
                    <div class="inline-flex rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-1">
                        <button type="button" data-period="7d" class="dashboard-period-btn px-3 py-1.5 text-xs font-medium rounded-md transition-all duration-200 bg-primary-theme text-white">
                            7 days
                        </button>
                        <button type="button" data-period="week" class="dashboard-period-btn px-3 py-1.5 text-xs font-medium rounded-md transition-all duration-200 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700">
                            Weekly
                        </button>
                        <button type="button" data-period="month" class="dashboard-period-btn px-3 py-1.5 text-xs font-medium rounded-md transition-all duration-200 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700">
                            Monthly
                        </button>
                        <button type="button" data-period="year" class="dashboard-period-btn px-3 py-1.5 text-xs font-medium rounded-md transition-all duration-200 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700">
                            Yearly
                        </button>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-4">
                    <!-- Spark Chart 1 -->
                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
                        <div class="flex justify-between items-center mb-3">
                            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Receptions</h3>
                            <span class="text-sm text-gray-500 dark:text-gray-400" id="receptions-chart-period-label">Last 7 days</span>
                        </div>
                        <div id="receptions-chart" class="h-56"></div>
                    </div>

                    <!-- Spark Chart 2 -->
                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
                        <div class="flex justify-between items-center mb-3">
                            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Expeditions</h3>
                            <span class="text-sm text-gray-500 dark:text-gray-400" id="expeditions-chart-period-label">Last 7 days</span>
                        </div>
                        <div id="expeditions-chart" class="h-56"></div>
                    </div>
                </div>
                <div style="height: 75px;">

                </div>

            </div>

            <t t-set="footer_content">
                <!-- Dashboard Modals -->
                <t t-call="portal_account.dashboard_add_credit_modal"/>
                <t t-call="portal_account.dashboard_import_receptions_modal"/>
                <t t-call="portal_account.dashboard_import_expeditions_modal"/>
            </t>

        </t>
    </template>

</odoo>
