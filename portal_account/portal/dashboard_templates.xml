<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_dashboard_page" name="Portal Dashboard Page">
        <t t-call="portal_admin_theme.portal_admin_layout">

            <div class="w-full">

                <!-- Stats Cards -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
                    <!-- KPI Cards -->
                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Receptions</p>
                                <h3 class="text-2xl font-bold text-gray-900 dark:text-white" id="dashboard-total-receptions-value" data-value="0">0</h3>
                                <p class="text-xs text-gray-500"><i class="fas fa-arrow-up mr-1"></i>0% since last month</p>
                            </div>
                            <div class="bg-cyan-100 dark:bg-cyan-900 p-3 rounded-full">
                                <i class="fas fa-box text-cyan-500 dark:text-cyan-400"></i>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Expeditions</p>
                                <h3 class="text-2xl font-bold text-gray-900 dark:text-white" id="dashboard-total-expeditions-value" data-value="0">0</h3>
                                <p class="text-xs text-gray-500"><i class="fas fa-arrow-up mr-1"></i>0% since last month</p>
                            </div>
                            <div class="bg-purple-100 dark:bg-purple-900 p-3 rounded-full">
                                <i class="fas fa-truck text-purple-500 dark:text-purple-400"></i>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Products</p>
                                <h3 class="text-2xl font-bold text-gray-900 dark:text-white" id="dashboard-total-products-value" data-value="0">0</h3>
                                <p class="text-xs text-gray-500"><i class="fas fa-arrow-up mr-1"></i>0% since last month</p>
                            </div>
                            <div class="bg-amber-100 dark:bg-amber-900 p-3 rounded-full">
                                <i class="fas fa-cubes text-amber-500 dark:text-amber-400"></i>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-sm text-gray-500 dark:text-gray-400">Stock</p>
                                <h3 class="text-2xl font-bold text-gray-900 dark:text-white" id="dashboard-total-stock-value" data-value="0">0</h3>
                                <p class="text-xs text-gray-500"><i class="fas fa-arrow-up mr-1"></i>0% since last month</p>
                            </div>
                            <div class="bg-green-100 dark:bg-green-900 p-3 rounded-full">
                                <i class="fas fa-boxes-stacked text-green-500 dark:text-green-400"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-4">

                    <!-- Actions Card -->
                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Quick Actions</h3>
                        <div class="grid grid-cols-2 gap-3">
                            <a href="/portal_account/static/templates/receptions.xlsx" target="_blank" class="bg-cyan-100 hover:bg-cyan-200 dark:bg-cyan-700 dark:hover:bg-cyan-600 text-cyan-700 dark:text-cyan-100 p-3 rounded-lg transition duration-200 flex items-center justify-center">
                                <i class="fas fa-file-invoice mr-2"></i> Receptions Template
                            </a>
                            <a href="/portal_account/static/templates/expeditions.xlsx" target="_blank" class="bg-purple-100 hover:bg-purple-200 dark:bg-purple-700 dark:hover:bg-purple-600 text-purple-700 dark:text-purple-100 p-3 rounded-lg transition duration-200 flex items-center justify-center">
                                <i class="fas fa-file-invoice mr-2"></i> Expeditions Template
                            </a>
                            <button id="dashboard-page-import-receptions-button" class="bg-amber-100 hover:bg-amber-200 dark:bg-amber-700 dark:hover:bg-amber-600 text-amber-700 dark:text-amber-100 p-3 rounded-lg transition duration-200 flex items-center justify-center">
                                <i class="fas fa-file-import mr-2"></i> Import receptions
                            </button>
                            <button id="dashboard-page-import-expeditions-button" class="bg-green-100 hover:bg-green-200 dark:bg-green-700 dark:hover:bg-green-600 text-green-700 dark:text-green-100 p-3 rounded-lg transition duration-200 flex items-center justify-center">
                                <i class="fas fa-file-import mr-2"></i> Import expeditions
                            </button>
                        </div>
                    </div>

                    <!-- Recent Activity -->
                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Recent Activity</h3>
                        </div>
                        <div class="space-y-4" id="dashboard-page-recent-activity-container">
                            <!-- <div class="flex items-start">
                                <div class="bg-green-100 dark:bg-green-900 p-2 rounded-full mr-3">
                                    <i class="fas fa-dollar-sign text-green-500 dark:text-green-400 text-sm"></i>
                                </div>
                                <div class="flex-1">
                                    <p class="text-sm font-medium text-gray-900 dark:text-white">New reception completed</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400">Reception #45890</p>
                                    <p class="text-xs text-gray-400 dark:text-gray-500">10 minutes ago</p>
                                </div>
                            </div>
                            <div class="flex items-start">
                                <div class="bg-cyan-100 dark:bg-cyan-900 p-2 rounded-full mr-3">
                                    <i class="fas fa-user text-cyan-500 dark:text-cyan-400 text-sm"></i>
                                </div>
                                <div class="flex-1">
                                    <p class="text-sm font-medium text-gray-900 dark:text-white">New expedition completed</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400">Expedition #45890</p>
                                    <p class="text-xs text-gray-400 dark:text-gray-500">45 minutes ago</p>
                                </div>
                            </div>
                            <div class="flex items-start">
                                <div class="bg-amber-100 dark:bg-amber-900 p-2 rounded-full mr-3">
                                    <i class="fas fa-exclamation-triangle text-amber-500 dark:text-amber-400 text-sm"></i>
                                </div>
                                <div class="flex-1">
                                    <p class="text-sm font-medium text-gray-900 dark:text-white">Inventory alert</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400">Product #39845 is low in stock</p>
                                    <p class="text-xs text-gray-400 dark:text-gray-500">2 hours ago</p>
                                </div>
                            </div>
                            <div class="flex items-start">
                                <div class="bg-purple-100 dark:bg-purple-900 p-2 rounded-full mr-3">
                                    <i class="fas fa-tasks text-purple-500 dark:text-purple-400 text-sm"></i>
                                </div>
                                <div class="flex-1">
                                    <p class="text-sm font-medium text-gray-900 dark:text-white">New product added</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400">Product #39845</p>
                                    <p class="text-xs text-gray-400 dark:text-gray-500">4 hours ago</p>
                                </div>
                            </div> -->
                        </div>
                    </div>

                    <!-- Account Balance Card -->
                    <div class="bg-gradient-to-r from-blue-500 to-cyan-500 dark:from-blue-800 dark:to-cyan-700 p-4 rounded-lg shadow text-white">
                        <div class="flex justify-between items-start mb-4">
                            <h3 class="text-lg font-semibold">Account Balance</h3>
                            <i class="fas fa-credit-card text-white/80 text-xl"></i>
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-sm mb-4">
                            <div>
                                <p class="opacity-80">Account</p>
                                <p id="dashboard-page-account-label" class="text-3xl font-bold"><span t-out="account_partner.name"/></p>
                            </div>
                            <div>
                                <p class="text-sm opacity-80">Available Credit</p>
                                <p id="dashboard-page-available-credit-value" class="text-3xl font-bold" data-value="0" data-current="0" data-suffix="" data-decimals="2" data-thousand-sep="" data-decimal-sep=""></p>
                                <p id="dashboard-page-pending-approval-label" class="text-sm opacity-80 hidden">Pending Approval</p>
                                <p id="dashboard-page-pending-approval-value" class="text-3xl font-bold hidden" data-value="0" data-current="0" data-suffix="" data-decimals="2" data-thousand-sep="" data-decimal-sep=""></p>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-sm mt-8">
                            <button class="bg-white/20 hover:bg-white/30 text-white p-2 rounded-lg transition duration-200 flex items-center justify-center" id="dashboard-page-add-credit-button">
                                <i class="fas fa-plus mr-2"></i> Add Credit
                            </button>
                            <button class="bg-white/20 hover:bg-white/30 text-white p-2 rounded-lg transition duration-200 flex items-center justify-center" id="dashboard-page-pay-now-button">
                                <i class="fas fa-credit-card mr-2"></i> Pay Now
                            </button>
                        </div>
                    </div>

                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-4">
                    <!-- Spark Chart 1 -->
                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
                        <div class="flex justify-between items-center mb-3">
                            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Receptions</h3>
                            <span class="text-sm text-gray-500 dark:text-gray-400">Last 7 days</span>
                        </div>
                        <div id="receptions-chart" class="h-36"></div>
                        <div class="flex items-center justify-center mt-3">
                            <span class="text-2xl font-bold text-gray-900 dark:text-white" id="dashboard-total-receptions-value" data-value="0">0</span>
                            <span class="text-sm text-green-500 ml-2"><i class="fas fa-arrow-up mr-1"></i>0% since last month</span>
                        </div>
                    </div>

                    <!-- Spark Chart 2 -->
                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
                        <div class="flex justify-between items-center mb-3">
                            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Expeditions</h3>
                            <span class="text-sm text-gray-500 dark:text-gray-400">Last 7 days</span>
                        </div>
                        <div id="expeditions-chart" class="h-36"></div>
                        <div class="flex items-center justify-center mt-3">
                            <span class="text-2xl font-bold text-gray-900 dark:text-white" id="dashboard-total-expeditions-value" data-value="0">0</span>
                            <span class="text-sm text-green-500 ml-2"><i class="fas fa-arrow-up mr-1"></i>0% since last month</span>
                        </div>
                    </div>
                </div>

            </div>

            <t t-set="footer_content">
                <!-- Modal -->
                <div id="dashboard-page-add-credit-modal" class="modal" data-outside-close="false">
                    <div class="modal-content max-w-2xl w-full mx-auto">
                        <div class="modal-header">
                            <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100">Add Credit</h3>
                            <button data-modal-close="true" class="close-modal" aria-label="Close modal">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="modal-body">
                            <form id="dashboard-add-credit-form">
                                <!-- Credit amount field -->
                                <div class="form-group">
                                    <div class="flex items-center">
                                        <label for="dashboard-page-add-credit-amount" class="form-label-sm font-sm">Credit Amount</label>
                                    </div>
                                    <div>
                                        <input type="number" name="credit_amount" id="dashboard-page-add-credit-amount" class="form-input-sm w-full text-sm rounded-md border-1 border-gray-300 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" placeholder="Credit Amount" required="required" min="0"/>
                                        <div class="form-error invisible" id="dashboard-page-add-credit-amount-error"></div>
                                        <span class="ml-2 text-xs text-gray-500 italic">
                                            <i class="fas fa-info-circle"></i> Enter the desired credit amount to initiate an approval process.
                                        </span>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer bg-gray-50 dark:bg-gray-800 px-6 py-4 flex justify-end rounded-b-lg border-t border-gray-200 dark:border-gray-700">
                            <button data-modal-close="true" class="modal-btn modal-btn-secondary mr-2">
                                <i class="fas fa-times"></i> Cancel
                            </button>
                            <button id="dashboard-page-add-credit-submit" class="modal-btn modal-btn-primary">
                                <i class="fas fa-plus"></i> Add Credit
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Import receptions Modal -->
                <div id="dashboard-page-import-receptions-modal" class="modal" data-outside-close="false">
                    <div class="modal-content max-w-lg w-full mx-auto">
                        <div class="modal-header">
                            <h3 class="text-lg font-sm text-gray-900 dark:text-gray-100">Import Receptions</h3>
                            <button data-modal-close="true" class="close-modal" aria-label="Close modal">
                                <i class="fas fa-times"/>
                            </button>
                        </div>
                        <div class="modal-body">
                            <form id="dashboard-import-receptions-form" class="form-flex">
                                <div class="form-group-flex">
                                    <label for="fileInput" class="form-label form-label-sm">Upload File</label>
                                    <div class="form-field-container">
                                        <div class="file-drop-area rounded-md border-2 border-dashed border-gray-300 dark:border-gray-600 p-4 text-center cursor-pointer">
                                            <input type="file" id="fileInput" name="fileInput" class="hidden focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" required="required" multiple="multiple"/>
                                            <div class="file-input-content">
                                                <i class="fas fa-cloud-upload-alt text-2xl text-gray-400 dark:text-gray-500"/>
                                                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Drag and drop a file here, or <span class="text-cyan-600 dark:text-cyan-400 browse-link">browse</span></p>
                                                <p class="text-xs text-gray-500 dark:text-gray-500 mt-1">Maximum file size: 5MB</p>
                                            </div>
                                        </div>
                                        <div class="file-preview mt-3 flex flex-col items-center"/>
                                        <div class="form-error" id="fileInputError">Please select a file to upload.</div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer bg-gray-50 dark:bg-gray-800 px-6 py-4 flex justify-end rounded-b-lg border-t border-gray-200 dark:border-gray-700">
                            <button data-modal-close="true" class="modal-btn modal-btn-secondary mr-2">
                                <i class="fas fa-times"/> Cancel
                            </button>
                            <button class="modal-btn modal-btn-primary">
                                <i class="fas fa-save"/> Upload
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Import expeditions Modal -->
                <div id="dashboard-page-import-expeditions-modal" class="modal" data-outside-close="false">
                    <div class="modal-content max-w-lg w-full mx-auto">
                        <div class="modal-header">
                            <h3 class="text-lg font-sm text-gray-900 dark:text-gray-100">Import Expeditions</h3>
                            <button data-modal-close="true" class="close-modal" aria-label="Close modal">
                                <i class="fas fa-times"/>
                            </button>
                        </div>
                        <div class="modal-body">
                            <form id="dashboard-import-expeditions-form" class="form-flex">
                                <div class="form-group-flex">
                                    <label for="fileInput" class="form-label form-label-sm">Upload File</label>
                                    <div class="form-field-container">
                                        <div class="file-drop-area rounded-md border-2 border-dashed border-gray-300 dark:border-gray-600 p-4 text-center cursor-pointer">
                                            <input type="file" id="fileInput" name="fileInput" class="hidden focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:focus:ring-cyan-500" required="required" multiple="multiple"/>
                                            <div class="file-input-content">
                                                <i class="fas fa-cloud-upload-alt text-2xl text-gray-400 dark:text-gray-500"/>
                                                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Drag and drop a file here, or <span class="text-cyan-600 dark:text-cyan-400 browse-link">browse</span></p>
                                                <p class="text-xs text-gray-500 dark:text-gray-500 mt-1">Maximum file size: 5MB</p>
                                            </div>
                                        </div>
                                        <div class="file-preview mt-3 flex flex-col items-center"/>
                                        <div class="form-error" id="fileInputError">Please select a file to upload.</div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer bg-gray-50 dark:bg-gray-800 px-6 py-4 flex justify-end rounded-b-lg border-t border-gray-200 dark:border-gray-700">
                            <button data-modal-close="true" class="modal-btn modal-btn-secondary mr-2">
                                <i class="fas fa-times"/> Cancel
                            </button>
                            <button class="modal-btn modal-btn-primary">
                                <i class="fas fa-save"/> Upload
                            </button>
                        </div>
                    </div>
                </div>
            </t>

        </t>
    </template>

</odoo>
