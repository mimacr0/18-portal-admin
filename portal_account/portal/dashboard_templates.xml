<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_dashboard_recent_activity_content" name="Portal Dashboard Recent Activity Content">

        <t t-foreach="recent_activity" t-as="activity">
            <div class="flex items-start">
                <div class="bg-green-100 dark:bg-green-900 p-2 rounded-full mr-3">
                    <i t-attf-class="#{activity.icon} text-green-500 dark:text-green-400 text-sm"></i>
                </div>
                <div class="flex-1">
                    <p class="text-sm font-medium text-gray-900 dark:text-white"><t t-out="activity.title"/></p>
                    <p class="text-xs text-gray-500 dark:text-gray-400"><t t-out="activity.message"/></p>
                    <p class="text-xs text-gray-400 dark:text-gray-500"><t t-out="activity.time_ago"/></p>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_dashboard_page" name="Portal Dashboard Page">
        <t t-call="portal_admin_theme.portal_admin_layout">

            <div class="w-full">

                <!-- Stats Cards -->
                <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-3 gap-4 mb-4">
                    <!-- Receptions KPI Card -->
                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow md:col-span-1 lg:col-span-1">
                        <div class="flex justify-between items-center mb-3">
                            <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Receptions</p>
                            <div class="bg-cyan-100 dark:bg-cyan-900 p-2 rounded-full">
                                <i class="fas fa-box text-cyan-500 dark:text-cyan-400 text-sm"></i>
                            </div>
                        </div>
                        <div class="grid grid-cols-3 lg:grid-cols-3 gap-2">
                            <!-- Arrived this month -->
                            <div class="bg-green-50 dark:bg-green-900/30 rounded-lg p-2 text-center">
                                <p class="text-xs text-green-600 dark:text-green-400 font-medium">Arrived</p>
                                <h3 class="text-lg font-bold text-gray-900 dark:text-white" id="dashboard-kpi-receptions-arrived">-</h3>
                                <p class="text-xs" id="dashboard-kpi-receptions-change">
                                    <i class="fas fa-spinner fa-spin mr-1 text-gray-400"></i>
                                </p>
                            </div>
                            <!-- Pending this month -->
                            <div class="bg-amber-50 dark:bg-amber-900/30 rounded-lg p-2 text-center">
                                <p class="text-xs text-amber-600 dark:text-amber-400 font-medium">Pending</p>
                                <h3 class="text-lg font-bold text-gray-900 dark:text-white" id="dashboard-kpi-receptions-pending">-</h3>
                            </div>
                            <!-- Total historical -->
                            <div class="bg-gray-50 dark:bg-gray-700/50 rounded-lg p-2 text-center">
                                <p class="text-xs text-gray-600 dark:text-gray-400 font-medium">Total</p>
                                <h3 class="text-lg font-bold text-gray-900 dark:text-white" id="dashboard-kpi-receptions-total">-</h3>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow">
                        <div class="flex justify-between items-center mb-3">
                            <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Expeditions</p>
                            <div class="bg-purple-100 dark:bg-purple-900 p-2 rounded-full">
                                <i class="fas fa-truck text-purple-500 dark:text-purple-400 text-sm"></i>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                            <!-- Quotes -->
                            <div class="bg-amber-50 dark:bg-amber-900/30 rounded-lg p-2 text-center">
                                <p class="text-xs text-amber-600 dark:text-amber-400 font-medium">Quotes</p>
                                <h3 class="text-lg font-bold text-gray-900 dark:text-white" id="dashboard-kpi-quotes-total">-</h3>
                                <p class="text-xs" id="dashboard-kpi-quotes-change">
                                    <i class="fas fa-spinner fa-spin mr-1 text-gray-400"></i>
                                </p>
                            </div>
                            <!-- Sales -->
                            <div class="bg-green-50 dark:bg-green-900/30 rounded-lg p-2 text-center">
                                <p class="text-xs text-green-600 dark:text-green-400 font-medium">Sales</p>
                                <h3 class="text-lg font-bold text-gray-900 dark:text-white" id="dashboard-kpi-sales-total">-</h3>
                                <p class="text-xs" id="dashboard-kpi-sales-change">
                                    <i class="fas fa-spinner fa-spin mr-1 text-gray-400"></i>
                                </p>
                            </div>
                            <!-- Deliveries -->
                            <div class="bg-purple-50 dark:bg-purple-900/30 rounded-lg p-2 text-center">
                                <p class="text-xs text-purple-600 dark:text-purple-400 font-medium">Deliveries</p>
                                <h3 class="text-lg font-bold text-gray-900 dark:text-white" id="dashboard-kpi-expeditions-total">-</h3>
                                <p class="text-xs" id="dashboard-kpi-expeditions-change">
                                    <i class="fas fa-spinner fa-spin mr-1 text-gray-400"></i>
                                </p>
                            </div>
                        </div>
                    </div>

